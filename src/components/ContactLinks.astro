---
interface Props {
  /** 'forest' = Creative family (deep green + terracotta, round icon chips). 'web' = Web department (near-black + orange, squared chips). */
  theme?: 'forest' | 'web';
}

const { theme = 'forest' } = Astro.props;

const links = [
  { id: 'mail', label: 'hello@dualstackstudio.com', href: 'mailto:hello@dualstackstudio.com', external: false, aria: 'Email' },
  { id: 'wa', label: 'WhatsApp', href: 'https://wa.me/436706014921', external: true, aria: 'WhatsApp' },
  { id: 'ig', label: 'Instagram', href: 'https://www.instagram.com/dualstackstudio/', external: true, aria: 'Instagram @dualstackstudio' },
  { id: 'li', label: 'LinkedIn', href: 'https://www.linkedin.com/in/sebastian-rodriguez-8336a93b6', external: true, aria: 'LinkedIn' },
];
---

<ul class={`cl cl--${theme}`}>
  {links.map((x) => (
    <li>
      <a
        class="cl-a"
        href={x.href}
        aria-label={x.aria}
        {...(x.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span class="cl-ico" aria-hidden="true">
          {x.id === 'mail' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2.6" /><path d="m4 7.5 8 6 8-6" /></svg>
          )}
          {x.id === 'wa' && (
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.372-.01-.571-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zm-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884zm8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" /></svg>
          )}
          {x.id === 'ig' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5.2" /><circle cx="12" cy="12" r="4.1" /><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" /></svg>
          )}
          {x.id === 'li' && (
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" /></svg>
          )}
        </span>
        <span class="cl-txt">{x.label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .cl { list-style: none; margin: 0 0 0.9rem; padding: 0; display: grid; gap: 0.7rem; }
  .cl li { margin: 0; padding: 0; }
  .cl-a {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 13.5px;
    text-decoration: none;
    overflow-wrap: anywhere;
    margin: 0;
    transition: color 0.25s ease, transform 0.25s ease;
  }
  .cl-ico {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .cl-ico svg { width: 16px; height: 16px; display: block; }
  .cl-a:hover { transform: translateX(3px); }
  .cl-a:hover .cl-ico { transform: scale(1.06); }
  .cl-a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; border-radius: 10px; }

  /* Creative family: deep green footer, terracotta accent, round chips */
  .cl--forest .cl-a { color: rgba(255, 255, 255, 0.72); }
  .cl--forest .cl-ico {
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.88);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .cl--forest .cl-a:hover { color: #fff; }
  .cl--forest .cl-a:hover .cl-ico {
    color: #fff;
    background: #c1663e;
    border-color: #c1663e;
    box-shadow: 0 6px 18px rgba(193, 102, 62, 0.4);
  }

  /* Web department: near-black footer, orange accent, squared chips */
  .cl--web .cl-a { color: #a3a3a3; }
  .cl--web .cl-ico {
    border-radius: 10px;
    color: #c1663e;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(226, 134, 90, 0.28);
  }
  .cl--web .cl-a:hover { color: #e2865a; }
  .cl--web .cl-a:hover .cl-ico {
    color: #e2865a;
    background: rgba(193, 102, 62, 0.16);
    border-color: #e2865a;
    box-shadow: 0 0 20px rgba(226, 134, 90, 0.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .cl-a, .cl-ico { transition: none; }
    .cl-a:hover, .cl-a:hover .cl-ico { transform: none; }
  }
</style>
