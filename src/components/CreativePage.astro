    fService: '¿Qué necesitas?', optContent: 'Contenido y Storytelling', optSocial: 'Redes Sociales y Gestión de Comunidad', optWeb: 'Web y Reservas', optOther: 'Otra cosa',
    fLocation: '¿Dónde estás ubicado?', fLocationPh: 'País o ciudad',
    fMessage: 'Mensaje', fMessagePh: 'Unas palabras sobre tu negocio y lo que estás buscando.',
    send: 'Enviar mensaje', sending: 'Enviando…',
    okMsg: 'Gracias — tu mensaje llegó. La respuesta llegará pronto.', errMsg: 'Algo salió mal. Por favor, escribe directamente por correo.',
    footTagline: 'Historias para negocios familiares y lugares pequeños que hacen un trabajo real — contenido, storytelling y la presencia web detrás.',
    builtTitle: 'Construido en paralelo',
    builtText: 'Este sitio web fue construido en paralelo — diseño y visión de Dual-Stack Studio, implementación asistida por Claude AI.',
    footNavTitle: 'Navegación', footLegalTitle: 'Legal', privacy: 'Política de Privacidad', terms: 'Términos de Servicio',
    footContactTitle: 'Contacto', footReply: 'Normalmente responde dentro de 1–2 días hábiles.',
    rights: '© 2026 Dual-Stack Studio. Operado de forma independiente.', builtWith: 'Construido con Astro, desplegado en Vercel.',
  },
};
const c = copy[lang];
---

<Layout title={c.title} lang={lang} langs={['en', 'de', 'es']}>
  <script is:inline>document.documentElement.classList.add('cas-js');</script>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <!-- One background per hero slide (heroBgs): it changes together with the text. On landscape windows it fills
         the right-hand side and fades out towards the text, on portrait windows it fills the whole hero. Videos
         get their source when their slide comes up (the first one straight away) and play from `start`. -->
    <div class="hx-bgs" id="hx-bgs" aria-hidden="true">
      {heroBgs.map((bg, i) => (
        <div
          class:list={['hx-bg', { active: i === 0 }]}
          style={`--wide: url('${bg.img}');${bg.narrow ? ` --narrow: url('${bg.narrow}');` : ''} --pos: ${bg.pos ?? '50% 50%'};`}
        >
          <span class="hx-bg-img"></span>
          {bg.img2 && <span class="hx-bg2" style={`--img2: url('${bg.img2}'); --pos2: ${bg.pos2 ?? '50% 50%'};`}></span>}
          {bg.video && (
            <video muted playsinline preload="none" data-src={bg.video.src} data-start={bg.video.start}></video>
          )}
        </div>
      ))}
    </div>

    <header id="site-header" class:list={['site-header', { 'site-header--de': lang === 'de' || lang === 'es' }]}>
      <div class="hdr-left">
        <button id="menu-toggle" class="menu-toggle" aria-label={c.menuToggle} aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="desktop-nav">
          <a href="#work">{c.navWork}</a>
          <a href="#services">{c.navServices}</a>
          <a href={l(lang, '/about')}>{c.navAbout}</a>
        </nav>
      </div>
      <a href={l(lang, '/')} class="brand">
        <img src="/logo.svg" alt="Dual-Stack Studio" width="40" height="40" style="border-radius: 25%;" />
      </a>
      <div class="hdr-right">
        <nav class="desktop-nav">
          <a href={l(lang, '/web')} class="nav-dept">{c.navWeb}</a>
        </nav>
        <div class="header-actions">
          <LangSwitch lang={lang} langs={['en', 'de', 'es']} />
          <a href="#contact" class="header-cta">{c.cta}</a>
        </div>
      </div>
    </header>

    <div id="mobile-menu" class="mobile-menu">
      <button id="mobile-menu-close" class="mobile-menu-close" aria-label={c.menuClose}>✕</button>
      <a href="#work" class="mobile-nav-link">{c.navWork}</a>
      <a href="#services" class="mobile-nav-link">{c.navServices}</a>
      <a href={l(lang, '/about')} class="mobile-nav-link">{c.navAbout}</a>
      <a href={l(lang, '/web')} class="mobile-nav-link">{c.navWeb}</a>
      <a href="#contact" class="mobile-cta">{c.cta}</a>
    </div>

    <!-- What we do, one slide at a time (same system as the RacksBrax Europe concept): the text slides in,
         a progress bar per slide, counter + name, arrows; the buttons stay put. Only the first slide is the h1. -->
    <div class="hx" id="hx">
      <div class="hx-slides" aria-live="off">
        {c.heroSlides.map((s, i) => (
          <div class:list={['hx-slide', { active: i === 0 }]} data-name={s.name} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${c.heroSlides.length}`}>
            <div class="hx-inner">
              <span class="hx-eyebrow">{s.eyebrow}</span>
              {i === 0 ? <h1 class="hx-h" set:html={s.h1} /> : <p class="hx-h" set:html={s.h1} />}
              <p class="hx-lead">{s.lead}</p>
              {s.web && <a class="hx-web" href={l(lang, '/web')}>{c.webCta}</a>}
            </div>
          </div>
        ))}
      </div>
      <div class="hx-cta">
        <a class="hx-btn hx-btn--fill" href="#work">{c.heroWork}</a>
        <a class="hx-btn hx-btn--ghost" href="#contact">{c.heroTalk}</a>
      </div>
      <div class="hx-ctl">
        <div class="hx-ctl-left">
          <div class="hx-dots" role="tablist">
            {c.heroSlides.map((s, i) => (
              <button class:list={['hx-dot', { on: i === 0 }]} type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${c.heroSlide} ${i + 1}: ${s.name}`}><i></i></button>
            ))}
          </div>
          <span class="hx-label"><b id="hx-num">01</b> / {String(c.heroSlides.length).padStart(2, '0')}&nbsp;&nbsp; <span id="hx-name">{c.heroSlides[0].name}</span></span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ OUR WORK ============ -->
  <section id="work" class="section work-section">
    <div class="section-inner">
      <span class="eyebrow">{c.workEyebrow}</span>
      <h2 class="section-title">{c.workTitle}</h2>
      <p class="section-lead">{c.workLead}</p>

      <div class="pw">
        <!-- Starpolar: dark card in their brand colours, three reel frames; the middle one plays the short reel -->
        <article class="pw-sp cas-reveal">
          <div class="pw-copy">
            <span class="pw-tag">{c.spTag}</span>
            <img class="pw-sp-logo" src="/images/work/starpolar/wordmark-white.png" alt="Starpolar" width="720" height="121" loading="lazy" decoding="async" />
            <h3>{c.spTitle}</h3>
            <p>{c.spText}</p>
            <div class="pw-chips">{c.spChips.map((t) => <span>{t}</span>)}</div>
          </div>
          <div class="pw-phones">
            <div class="pw-phone"><img src="/images/work/starpolar/reel-streets.jpg" alt={c.spAlts[0]} width="540" height="960" loading="lazy" decoding="async" /></div>
            <div class="pw-phone pw-phone--mid">
              <video id="sp-reel" src="/videos/work/starpolar-reel.mp4" poster="/videos/work/starpolar-reel-poster.jpg" preload="none" playsinline aria-label={c.spAlts[1]}></video>
              <button class="pw-play" type="button" aria-label={c.spPlay} data-target="sp-reel"><i></i></button>
            </div>
            <div class="pw-phone"><img src="/images/work/starpolar/reel-direction.jpg" alt={c.spAlts[2]} width="540" height="960" loading="lazy" decoding="async" /></div>
          </div>
        </article>

        <!-- Mister Jin: photography for the restaurant's Google profile -->
        <a class="pw-card pw-card--jin cas-reveal" href={l(lang, '/work/mister-jin')}>
          <div class="pw-mosaic">
            <img class="pw-tall" src="/images/work/mister-jin/house.jpg" alt={c.mjAlts[0]} width="1080" height="1350" loading="lazy" decoding="async" />
            <img src="/images/work/mister-jin/terrace.jpg" alt={c.mjAlts[1]} width="1350" height="900" loading="lazy" decoding="async" />
            <img src="/images/work/mister-jin/dishes.jpg" alt={c.mjAlts[2]} width="1350" height="900" loading="lazy" decoding="async" />
            <img src="/images/work/mister-jin/buffet.jpg" alt={c.mjAlts[3]} width="1350" height="900" loading="lazy" decoding="async" />
            <img src="/images/work/mister-jin/dining-room.jpg" alt={c.mjAlts[4]} width="1350" height="900" loading="lazy" decoding="async" />
          </div>
          <div class="pw-copy">
            <span class="pw-tag">{c.mjTag}</span>
            <h3>Asia Restaurant Mister Jin</h3>
            <p>{c.mjText}</p>
            <div class="pw-chips">{c.mjChips.map((t) => <span>{t}</span>)}</div>
            <span class="pw-go">{c.workGo}</span>
          </div>
        </a>

        <!-- El Dulce de la Nonna: online shop (live client project) -->
        <a class="pw-card pw-card--flip pw-card--nonna cas-reveal" href={l(lang, '/work/nonna')}>
          <div class="pw-copy">
            <span class="pw-tag">{c.nonnaTag}<span class="pw-live">{c.live}</span></span>
            <h3>El Dulce de la Nonna</h3>
            <p>{c.nonnaText}</p>
            <div class="pw-chips">{c.nonnaChips.map((t) => <span>{t}</span>)}</div>
            <span class="pw-go">{c.workGo}</span>
          </div>
          <div class="pw-mosaic pw-mosaic--web">
            <img class="pw-tall pw-logo" style="background:#ffffff" src="/images/work/nonna-logo-tall.jpg" alt={c.nonnaAlts[0]} width="1075" height="1733" loading="lazy" decoding="async" />
            <img src="/images/nonna-gallery-2.jpg" alt={c.nonnaAlts[1]} width="1600" height="900" loading="lazy" decoding="async" />
            <img src="/images/nonna-gallery-1.jpg" alt={c.nonnaAlts[2]} width="1600" height="900" loading="lazy" decoding="async" />
            <img src="/images/nonna-gallery-3.jpg" alt={c.nonnaAlts[3]} width="1600" height="900" loading="lazy" decoding="async" />
            <img src="/images/nonna-gallery-4.jpg" alt={c.nonnaAlts[4]} width="1600" height="900" loading="lazy" decoding="async" />
          </div>
        </a>

        <!-- MVG Lash & Brow: salon website (live client project) -->
        <a class="pw-card pw-card--mvg cas-reveal" href={l(lang, '/work/mvg')}>
          <div class="pw-mosaic pw-mosaic--web">
            <img class="pw-tall pw-logo" style="background:#e2f6f7" src="/images/work/mvg-logo-tall.jpg" alt={c.mvgAlts[0]} width="917" height="1479" loading="lazy" decoding="async" />
            <img src="/images/mvg-gallery-1.jpg" alt={c.mvgAlts[1]} width="1600" height="900" loading="lazy" decoding="async" />
            <img src="/images/mvg-gallery-2.jpg" alt={c.mvgAlts[2]} width="1600" height="900" loading="lazy" decoding="async" />
            <img src="/images/mvg-gallery-3.jpg" alt={c.mvgAlts[3]} width="1600" height="900" loading="lazy" decoding="async" />
            <img src="/images/mvg-gallery-4.jpg" alt={c.mvgAlts[4]} width="1600" height="900" loading="lazy" decoding="async" />
          </div>
          <div class="pw-copy">
            <span class="pw-tag">{c.mvgTag}<span class="pw-live">{c.live}</span></span>
            <h3>MVG Lash &amp; Brow</h3>
            <p>{c.mvgText}</p>
            <div class="pw-chips">{c.mvgChips.map((t) => <span>{t}</span>)}</div>
            <span class="pw-go">{c.workGo}</span>
          </div>
        </a>

        <!-- The restaurant of a mountain lodge in Japan -->
        <a class="pw-card pw-card--flip pw-card--jp cas-reveal" href={l(lang, '/work/japan-restaurant')}>
          <div class="pw-copy">
            <span class="pw-tag">{c.lodgeTag}</span>
            <h3>{c.lodgeTitle}</h3>
            <p>{c.lodgeText}</p>
            <div class="pw-chips">{c.lodgeChips.map((t) => <span>{t}</span>)}</div>
            <span class="pw-go">{c.workGo}</span>
          </div>
          <div class="pw-mosaic">
            <img class="pw-tall" src="/images/japan-restaurant/restaurant-chef-prep.jpg" alt={c.lodgeAlts[0]} width="768" height="1024" loading="lazy" decoding="async" />
            <img src="/images/japan-restaurant/restaurant-tuna-slicing.jpg" alt={c.lodgeAlt} width="1024" height="685" loading="lazy" decoding="async" />
            <img src="/images/japan-restaurant/restaurant-plating-hand.jpg" alt={c.lodgeAlts[1]} width="1024" height="685" loading="lazy" decoding="async" />
            <img src="/images/japan-restaurant/restaurant-noodles-chopsticks.jpg" alt={c.lodgeAlts[2]} width="1024" height="1024" loading="lazy" decoding="async" />
            <img src="/images/japan-restaurant/restaurant-salad-sake.jpg" alt={c.lodgeAlts[3]} width="1024" height="1024" loading="lazy" decoding="async" />
          </div>
        </a>
      </div>

      <!-- websites, apps and the full-stack work live on the Web page -->
      <div class="web-cta-row"><a class="web-cta" href={l(lang, '/web')}>{c.webCta}</a></div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="section services-section">
    <div class="section-inner">
      <span class="eyebrow">{c.servicesEyebrow}</span>
      <h2 class="section-title">{c.servicesTitle}</h2>

      <div class="services-grid">
        <div class="service-block tone-green cas-step cas-reveal" style="--k:0">
          <div class="service-icon" set:html={lineIcon('camera', 34)} />
          <span class="service-kicker">{c.s1Kicker}</span>
          <h3>{c.s1Title}</h3>
          <p>{c.s1Text}</p>
          <span class="service-location service-location--local"><Fragment set:html={lineIcon('pin', 14, 2)} />{c.s1Location}</span>
        </div>

        <div class="service-block tone-orange cas-step cas-reveal" style="--k:1">
          <div class="service-icon" set:html={lineIcon('share', 34)} />
          <span class="service-kicker">{c.s2Kicker}</span>
          <h3>{c.s2Title}</h3>
          <p>{c.s2Text}</p>
          <div class="service-checklist">
            {c.s2Checks.map((chk) => <span>✓ {chk}</span>)}
          </div>
          <span class="service-location"><Fragment set:html={lineIcon('globe', 14, 2)} />{c.s2Location}</span>
        </div>

        <div class="service-block tone-beige cas-step cas-reveal" style="--k:2">
          <div class="service-icon" set:html={lineIcon('globe', 34)} />
          <span class="service-kicker">{c.s3Kicker}</span>
          <h3>{c.s3Title}</h3>
          <p>{c.s3Text}</p>
          <span class="service-location"><Fragment set:html={lineIcon('globe', 14, 2)} />{c.s3Location}</span>
          <a class="web-cta web-cta--card" href={l(lang, '/web')}>{c.webCtaShort}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="section contact-section">
    <div class="section-inner contact-inner">
      <span class="eyebrow">{c.contactEyebrow}</span>
      <h2 class="section-title">{c.contactTitle}</h2>
      <p class="section-lead">{c.contactLead}</p>

      <form id="contact-form" class="contact-form" novalidate data-sending={c.sending} data-send={c.send} data-ok={c.okMsg} data-error={c.errMsg}>
        <!-- Web3Forms -->
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New inquiry from dualstackstudio.com" />
        <input type="hidden" name="from_name" value="Dual-Stack Studio site" />
        <input type="hidden" name="language" value={lang} />
        <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" />

        <div class="cf-row">
          <div class="cf-field">
            <label for="cf-name">{c.fName}</label>
            <input type="text" id="cf-name" name="name" required placeholder={c.fNamePh} />
          </div>
          <div class="cf-field">
            <label for="cf-email">{c.fEmail}</label>
            <input type="email" id="cf-email" name="email" required placeholder={c.fEmailPh} />
          </div>
        </div>

        <div class="cf-row">
          <div class="cf-field">
            <label for="cf-service">{c.fService}</label>
            <select id="cf-service" name="service">
              <option>{c.optContent}</option>
              <option>{c.optSocial}</option>
              <option>{c.optWeb}</option>
              <option>{c.optOther}</option>
            </select>
          </div>
          <div class="cf-field">
            <label for="cf-location">{c.fLocation}</label>
            <input type="text" id="cf-location" name="location" required placeholder={c.fLocationPh} />
          </div>
        </div>

        <div class="cf-field">
          <label for="cf-message">{c.fMessage}</label>
          <textarea id="cf-message" name="message" rows="5" required placeholder={c.fMessagePh}></textarea>
        </div>

        <button type="submit" class="cf-submit">{c.send}</button>
        <p id="cf-status" class="cf-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="section-inner">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="48" height="48" style="border-radius: 25%;" />
            Dual-Stack Studio
          </div>
          <p>{c.footTagline}</p>
        </div>

        <div class="footer-col">
          <h4>{c.footNavTitle}</h4>
          <a href="#work">{c.navWork}</a>
          <a href="#services">{c.navServices}</a>
          <a href={l(lang, '/about')}>{c.navAbout}</a>
          <a href={l(lang, '/web')}>{c.navWeb}</a>
        </div>

        <div class="footer-col">
          <h4>{c.footLegalTitle}</h4>
          <a href={l(lang, '/privacy-policy')}>{c.privacy}</a>
          <a href={l(lang, '/terms-of-service')}>{c.terms}</a>
          <a href={l(lang, '/impressum')}>Impressum</a>
        </div>

        <div class="footer-col">
          <h4>{c.footContactTitle}</h4>
          <ContactLinks theme="web" />
          <span class="footer-note">{c.footReply}</span>
        </div>
      </div>

      <div class="footer-bottom">
        <p>{c.rights}</p>
        <p>{c.builtWith}</p>
      </div>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.cas-reveal');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (e) { e.classList.add('in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach(function (e) { io.observe(e); });
    })();
    // Starpolar reel: the play button starts the reel with sound inside the middle phone
    document.querySelectorAll('.pw-play').forEach(function (btn) {
      var v = document.getElementById(btn.getAttribute('data-target'));
      if (!v) return;
      btn.addEventListener('click', function () { v.controls = true; btn.hidden = true; v.play(); });
      v.addEventListener('ended', function () { v.controls = false; btn.hidden = false; v.load(); });
    });
  </script>

  <style>
    :root {
      --cream: #fffdf9;
      --cream-deep: #fbf8f3;
      --beige: #efe6d4;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --muted: #6b6156;
      /* dark mode in the logo's colours (same as the Web page): black, orange accents, text in cream */
      --night: #383b41;
      --night-2: #2f3136;
      --night-3: #27292d;
      --on-dark: #f6f1e8;
      --on-dark-soft: rgba(246, 241, 232, 0.74);
      --on-dark-faint: rgba(246, 241, 232, 0.5);
      --peach: #e2865a;
    }

    .section-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.75rem;
    }

    .eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--peach);
      margin-bottom: 0.75rem;
    }

    .section-title {
      font-size: clamp(30px, 4.2vw, 46px);
      font-weight: 600;
      letter-spacing: -1px;
      color: var(--on-dark);
      margin: 0 0 0.9rem;
      line-height: 1.08;
    }

    .section-lead {
      font-size: 17px;
      color: var(--on-dark-soft);
      max-width: 560px;
      margin: 0 0 3rem;
      line-height: 1.65;
    }

    .section { padding: 6rem 0; }
    .section + .section { border-top: 1px solid rgba(246, 241, 232, 0.06); }

    /* ---------- HERO ---------- */
    /* Dark hero: the black of the whole page, cream text, and the pictures fading into the black. */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: var(--night-2);
    }

    /* Hero backgrounds, one per slide (heroBgs). Landscape windows: the picture fills the right-hand side and
       fades into the black towards the text, the header and the next section; a new one slides in from the side
       the text comes from while the old one leaves (--d = direction), with a slow zoom. Portrait windows: the
       picture sits on top, under the header, and the text follows below it. */
    .hx-bgs { position: absolute; inset: 0; overflow: hidden; isolation: isolate; --d: 1; --ix: clamp(120px, 18vw, 320px); }
    .hx-bg {
      position: absolute; top: 0; bottom: 0; right: 0; width: 55%;
      --mask: linear-gradient(90deg, transparent 0, transparent 5%, #000 40%), linear-gradient(180deg, transparent 0, transparent 70px, #000 200px, #000 calc(100% - 110px), transparent calc(100% - 14px));
      --mask-op: intersect; --wmask-op: source-in;
      opacity: 0; translate: calc(var(--d) * var(--ix)) 0;
      /* a panel whose slide has gone is also hidden once its fade has ended: some GPUs kept the last frame of a
         faded-out panel (the film) on screen behind the next slides */
      visibility: hidden;
      transition: translate 1.2s cubic-bezier(.65,0,.2,1), opacity .9s ease, visibility 0s linear 1.3s;
    }
    .hx-bg.active, .hx-bg.leaving { visibility: visible; transition-delay: 0s; }
    .hx-bg.active { opacity: 1; translate: 0 0; z-index: 2; }
    .hx-bg.leaving { opacity: 0; translate: calc(var(--d) * var(--ix) * -1) 0; z-index: 1; }
    /* each picture layer carries the fade mask itself: with the mask only on the parent, a layer drawn on its own
       (the second photo, the video) left a 1px column of the picture visible at the panel's edge */
    .hx-bg > * {
      position: absolute; inset: 0;
      -webkit-mask-image: var(--mask); -webkit-mask-composite: var(--wmask-op);
      mask-image: var(--mask); mask-composite: var(--mask-op);
    }
    .hx-bg-img { background-image: var(--wide); background-size: cover; background-position: var(--pos); background-repeat: no-repeat; }
    @media (min-aspect-ratio: 1/1) and (max-aspect-ratio: 8/5) {
      .hx-bg-img { background-image: var(--narrow, var(--wide)); }
    }
    .hx-bg video { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); opacity: 0; transition: opacity .9s ease; }
    /* the film also fades with its own opacity, as some GPUs draw a video on a layer of its own that ignores the
       panel's; once its slide has gone the script drops the file as well */
    .hx-bg.active video { opacity: 1; }
    /* a second photo that fades in halfway through its slide (restarts each time the slide comes back) */
    .hx-bg2 { position: absolute; inset: 0; background-image: var(--img2); background-size: cover; background-position: var(--pos2); opacity: 0; }
    @keyframes hxSwap { 0%, 44% { opacity: 0; } 58%, 100% { opacity: 1; } }
    @media (prefers-reduced-motion: no-preference) {
      .hx-bg.active .hx-bg2 { animation: hxSwap 7s ease-in-out both; }
      .hx-bg.leaving .hx-bg2 { opacity: 1; }
    }
    .hx-bgs.no-anim .hx-bg { transition: none !important; }
    @keyframes hxKb { from { scale: 1; } to { scale: 1.08; } }
    @media (prefers-reduced-motion: no-preference) {
      .hx-bg.active, .hx-bg.leaving { animation: hxKb 8.2s linear both; }
    }
    @media (max-aspect-ratio: 1/1) {
      .hero { min-height: 0; }
      .hx-bgs { top: 72px; bottom: auto; height: 42svh; }
      .hx-bg {
        left: 0; width: auto;
        --mask: linear-gradient(180deg, #000 0, #000 70%, transparent 96%); --mask-op: add; --wmask-op: source-over;
        translate: none; transition: opacity 1.2s ease-in-out, visibility 0s linear 1.3s;
      }
      .hx-bg.leaving { opacity: 1; translate: none; }
    }

    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 0.75rem 2.5rem;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      column-gap: 25px;
      z-index: 100;
      transition: background 0.3s, padding 0.3s;
    }

    /* light links over the dark page; once it scrolls the header becomes a frosted black bar */
    .site-header.scrolled {
      background: rgba(47, 49, 54, 0.86);
      backdrop-filter: blur(10px);
      box-shadow: 0 1px 0 rgba(246, 241, 232, 0.06);
      padding: 0.5rem 2.5rem;
    }

    /* logo mark in the middle; it shrinks a little once the page scrolls */
    .brand { display: block; justify-self: center; line-height: 0; }
    .brand img {
      width: 46px;
      height: 46px;
      filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.35));
      transition: width 0.3s, height 0.3s, transform 0.25s;
    }
    .brand:hover img { transform: scale(1.07) rotate(-2deg); }
    .site-header.scrolled .brand img { width: 40px; height: 40px; }

    .hdr-left { display: flex; align-items: center; justify-content: flex-end; }
    .hdr-right { display: flex; align-items: center; justify-content: flex-start; gap: 1.1rem; }

    .desktop-nav a, .header-cta { white-space: nowrap; }
    .desktop-nav { display: flex; align-items: center; gap: 1.6rem; font-size: 14px; font-weight: 500; }
    @media (max-width: 1400px) { .desktop-nav { gap: 1.35rem; } }
    .desktop-nav a { color: rgba(246, 241, 232, 0.9); }
    .desktop-nav a:hover { color: var(--terracotta); }
    .desktop-nav a:not(.nav-dept) { position: relative; padding: 4px 0; }
    .desktop-nav a:not(.nav-dept)::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -1px;
      height: 1.5px;
      background: var(--terracotta);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }
    .desktop-nav a:not(.nav-dept):hover::after { transform: scaleX(1); }
    .desktop-nav a.nav-dept {
      border: 1px solid rgba(246, 241, 232, 0.3);
      padding: 8px 16px;
      border-radius: 100px;
      font-size: 14px;
      transition: border-color 0.2s, color 0.2s;
    }
    .desktop-nav a.nav-dept:hover { border-color: var(--terracotta); color: var(--terracotta); }

    .header-actions { display: flex; align-items: center; gap: 1rem; }
    .header-actions :global(.lang-switch) { color: var(--on-dark); }

    .header-cta {
      background: var(--terracotta);
      color: #fff;
      padding: 13px 27px;
      border-radius: 100px;
      font-size: 15px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .header-cta:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    .menu-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      padding: 6px;
    }
    .menu-toggle span { width: 22px; height: 2px; background: var(--on-dark); border-radius: 2px; }

    .mobile-menu {
      position: fixed;
      inset: 0;
      background: var(--night-2);
      z-index: 200;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-nav-link { font-family: 'Fraunces', serif; font-size: 28px; color: #fff; }
    .mobile-cta { margin-top: 1rem; background: var(--terracotta); color: #fff; padding: 14px 32px; border-radius: 100px; font-weight: 600; }
    .mobile-menu-close { position: absolute; top: 2rem; right: 2rem; background: none; border: none; color: #fff; font-size: 24px; }

    /* ---- Hero slides: what we do, one slide at a time (system taken from the RacksBrax Europe concept) ----
       The text block sits bottom-left over the film; a new slide's text slides in from one side while the old
       one leaves to the other (--d = direction), with a small stagger per line. */
    .hx {
      position: relative; z-index: 10; box-sizing: border-box;
      width: 100%; max-width: 1180px; margin: 0 auto; align-self: stretch;
      min-height: 100vh; min-height: 100svh;
      padding: 130px 1.75rem 34px;
      display: flex; flex-direction: column; justify-content: flex-end;
      color: var(--on-dark);
      --d: 1; --tx: clamp(60px, 7vw, 130px);
    }
    .hx-slides { display: grid; }
    .hx-slide { grid-area: 1 / 1; align-self: end; visibility: hidden; }
    .hx-slide.active, .hx-slide.leaving { visibility: visible; }
    .hx-inner { display: flex; flex-direction: column; align-items: flex-start; max-width: 600px; }
    .hx-inner > * {
      opacity: 0; translate: calc(var(--d) * var(--tx) * -1) 0;
      transition: translate 1.05s cubic-bezier(.65,0,.2,1) var(--dl, 0s), opacity .6s ease calc(var(--dl, 0s) + .3s);
    }
    .hx-inner > :nth-child(2) { --dl: .07s; }
    .hx-inner > :nth-child(3) { --dl: .14s; }
    .hx-inner > :nth-child(4) { --dl: .21s; }
    .hx-slide.active .hx-inner > * { opacity: 1; translate: 0 0; }
    .hx-slide.leaving .hx-inner > * {
      opacity: 0; translate: calc(var(--d) * var(--tx)) 0;
      transition: translate .9s cubic-bezier(.65,0,.2,1) var(--dl, 0s), opacity .45s ease var(--dl, 0s);
    }
    .hx-slides.no-anim, .hx-slides.no-anim * { transition: none !important; }

    .hx-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 2.4px; text-transform: uppercase; color: var(--peach); margin-bottom: 16px; }
    .hx-h {
      font-family: 'Fraunces', serif; font-weight: 600; color: var(--on-dark); margin: 0;
      font-size: clamp(34px, 4.4vw, 60px); line-height: 1.06; letter-spacing: -1.2px; text-wrap: balance;
    }
    .hx-h :global(em) { font-style: italic; color: var(--peach); }
    .hx-lead { margin: 18px 0 0; max-width: 540px; font-size: clamp(16px, 1.6vw, 19px); line-height: 1.55; color: var(--on-dark-soft); }
    .hx-web { margin-top: 14px; font-size: 15px; font-weight: 700; color: var(--on-dark); border-bottom: 1.5px solid var(--peach); padding-bottom: 2px; }
    .hx-web:hover { color: var(--peach); }

    .hx-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
    .hx-btn { display: inline-block; padding: 13px 26px; border-radius: 100px; font-size: 15px; font-weight: 600; border: 1.5px solid transparent; transition: background 0.2s, border-color 0.2s, transform 0.2s; }
    .hx-btn--fill { background: var(--terracotta); color: #fff; }
    .hx-btn--fill:hover { background: var(--terracotta-deep); transform: translateY(-1px); }
    .hx-btn--ghost { border-color: rgba(246, 241, 232, 0.6); color: var(--on-dark); }
    .hx-btn--ghost:hover { background: rgba(246, 241, 232, 0.1); }

    .hx-ctl { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-top: 34px; }
    .hx-ctl-left { display: flex; align-items: center; gap: 20px; }
    .hx-dots { display: flex; gap: 6px; }
    .hx-dot { width: 46px; height: 20px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; align-items: center; }
    .hx-dot i { display: block; height: 3px; border-radius: 3px; background: rgba(246,241,232,0.22); position: relative; overflow: hidden; }
    .hx-dot i::after { content: ''; position: absolute; inset: 0; background: var(--peach); transform: scaleX(0); transform-origin: left; }
    .hx-dot.done i::after { transform: scaleX(1); }
    .hx-dot.on i::after { animation: hxFill var(--dur, 7000ms) linear forwards; }
    .hx.paused .hx-dot.on i::after { animation-play-state: paused; }
    @keyframes hxFill { to { transform: scaleX(1); } }
    .hx-label { font-size: 12.5px; letter-spacing: 2px; text-transform: uppercase; color: var(--on-dark-faint); white-space: nowrap; }
    .hx-label b { color: var(--on-dark); font-weight: 700; }

    @media (max-width: 700px) {
      .hx { padding: calc(72px + 42svh + 6px) 1.25rem 26px; --tx: 0px; min-height: 0; justify-content: flex-start; }
      .hx-h { font-size: clamp(30px, 8.6vw, 42px); letter-spacing: -0.8px; }
      .hx-lead { font-size: 15.5px; margin-top: 14px; }
      .hx-eyebrow { font-size: 11px; margin-bottom: 12px; }
      .hx-cta { flex-direction: column; gap: 8px; margin-top: 24px; }
      .hx-btn { text-align: center; padding: 12px 18px; }
      .hx-ctl { margin-top: 22px; }
      .hx-label { display: none; }
      .hx-dots { gap: 4px; }
      .hx-dot { width: 26px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hx-inner > * { translate: none !important; transition: opacity .4s ease !important; }
      .hx-dot.on i::after { animation: none; transform: scaleX(1); }
    }

    /* ---------- WORK ---------- */
    .work-section { background: var(--night-2); }

    /* ---- The Work: one card per real project (Starpolar, Mister Jin, Japan) ---- */
    .pw { display: grid; gap: 1.75rem; margin-top: 2.6rem; }
    .pw-copy { min-width: 0; }
    .pw-tag { display: inline-block; font-size: 11.5px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: var(--accent, var(--peach)); margin-bottom: 0.9rem; }
    .pw h3 { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; line-height: 1.2; margin: 0 0 0.75rem; color: var(--on-dark); }
    .pw p { font-size: 16px; line-height: 1.65; color: var(--soft, var(--on-dark-soft)); margin: 0; max-width: 34rem; }
    .pw-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 1.1rem; }
    .pw-chips span { font-size: 11.5px; font-weight: 600; letter-spacing: 0.6px; text-transform: uppercase; border: 1px solid currentColor; border-radius: 999px; padding: 4px 12px; color: var(--accent, #f0c9a8); opacity: 0.85; }
    .pw-go { display: inline-block; margin-top: 1.4rem; font-size: 15px; font-weight: 700; color: var(--on-dark); border-bottom: 1.5px solid var(--accent, var(--peach)); padding-bottom: 2px; transition: color 0.2s, border-color 0.2s; }
    .pw-card:hover .pw-go { color: var(--accent, var(--peach)); }

    /* Starpolar (their palette: near-black + violet) */
    .pw-sp { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2.5rem; align-items: center; color: #f4f0ff; padding: 3rem 3.25rem;
      --base: #393a42; --glow: 168, 140, 255; --accent: #a88cff; --soft: #cfc7e6; }
    .pw-sp-logo { width: 250px; height: auto; display: block; margin-bottom: 1.4rem; }
    .pw-sp h3 { color: #f4f0ff; font-size: 30px; }
    .pw-sp p { color: #cfc7e6; }
        .pw-phones { display: flex; gap: 16px; justify-content: center; align-items: flex-end; }
    .pw-phone { position: relative; width: 156px; aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; background: #000; border: 3px solid #25262c; box-shadow: 0 18px 40px rgba(0,0,0,0.4); flex: none; }
    .pw-phone img, .pw-phone video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pw-phone--mid { width: 176px; transform: translateY(-14px); }
    .pw-play { position: absolute; inset: 0; display: grid; place-items: center; background: transparent; border: 0; cursor: pointer; padding: 0; }
    .pw-play i { width: 50px; height: 50px; border-radius: 50%; background: rgba(15,13,22,0.62); border: 1.5px solid rgba(255,255,255,0.75); display: grid; place-items: center; transition: transform 0.2s, background 0.2s; }
    .pw-play i::after { content: ''; margin-left: 4px; border-left: 14px solid #fff; border-top: 9px solid transparent; border-bottom: 9px solid transparent; }
    .pw-play:hover i { transform: scale(1.08); background: rgba(168,140,255,0.55); }

    /* every project card follows the Starpolar pattern on the site's slate grey: a base with a hint of the
       brand colour, a soft radial glow in the top corner, a neutral frame (brand-coloured on hover) and brand accents.
       --glow is the brand colour as "r, g, b"; --accent colours the tag, chips and link; --soft the text. */
    .pw-sp, .pw-card {
      position: relative; overflow: hidden; isolation: isolate; border-radius: 28px;
      background: var(--base, #27292d);
      border: 1px solid rgba(246, 241, 232, 0.12);
      box-shadow: 0 22px 44px -30px rgba(0, 0, 0, 0.6);
      transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
    }
    .pw-sp::before, .pw-card::before {
      content: ''; position: absolute; right: -140px; top: -170px; width: 540px; height: 540px; border-radius: 50%;
      background: radial-gradient(circle, rgba(var(--glow, 226, 134, 90), 0.26), transparent 66%);
      opacity: 0.55; pointer-events: none; z-index: -1;
    }
    /* the reflection: a band of light that sweeps diagonally from the top-left corner to the bottom-right one
       (the effect from the portfolio site, turned to run top to bottom) */
    .pw-sp::after, .pw-card::after, .service-block::after, .contact-form::after {
      content: ''; position: absolute; inset: -50%;
      background: linear-gradient(135deg, transparent 43%, rgba(255, 255, 255, 0.06) 47.5%, rgba(var(--glow, 226, 134, 90), 0.17) 50%, rgba(255, 255, 255, 0.06) 52.5%, transparent 57%);
      transform: translate(-60%, -60%);
      animation: pwShimmer 4.5s ease-in-out infinite; animation-delay: var(--shine-delay, 0s);
      will-change: transform; pointer-events: none; z-index: 3;
    }
    @keyframes pwShimmer { 0% { transform: translate(-60%, -60%); } 70%, 100% { transform: translate(60%, 60%); } }
    .pw > :nth-child(2) { --shine-delay: 0.9s; }
    .pw > :nth-child(3) { --shine-delay: 1.8s; }
    .pw > :nth-child(4) { --shine-delay: 2.7s; }
    .pw > :nth-child(5) { --shine-delay: 3.6s; }
    .pw-card:hover, .pw-sp:hover {
      border-color: rgba(var(--glow, 226, 134, 90), 0.55);
      box-shadow: 0 0 30px rgba(var(--glow, 226, 134, 90), 0.14), 0 24px 60px -28px rgba(0, 0, 0, 0.6);
    }
    .pw-card:hover { transform: translateY(-2px); }
    .services-grid > :nth-child(2) { --shine-delay: 1.2s; }
    .services-grid > :nth-child(3) { --shine-delay: 2.4s; }
    .contact-form { --shine-delay: 0.6s; }
    @media (prefers-reduced-motion: reduce) { .pw-sp::after, .pw-card::after, .service-block::after, .contact-form::after { animation: none; display: none; } }

    /* client cards: photo mosaic + copy */
    .pw-card { display: grid; grid-template-columns: 1.25fr 1fr; gap: 2.25rem; align-items: center; padding: 2.1rem; color: inherit; text-decoration: none; }
    /* brand colours */
    .pw-card--jin { --base: #353d3d; --glow: 47, 122, 94; --accent: #e8d3a0; --soft: #cfd8d2; }       /* Mister Jin: green + champagne gold */
    .pw-card--jin::before { background: radial-gradient(circle, rgba(47, 122, 94, 0.42), rgba(200, 162, 74, 0.08) 45%, transparent 68%); }
    .pw-card--nonna { --base: #3d3a3e; --glow: 244, 166, 189; --accent: #f8c4d3; --soft: #eedbe0; }   /* La Nonna: light pink */
    .pw-card--nonna::before { right: -100px; top: -140px; width: 640px; height: 640px; background: radial-gradient(circle, rgba(244, 166, 189, 0.4), rgba(244, 166, 189, 0.1) 45%, transparent 70%); }
    .pw-card--mvg { --base: #353d41; --glow: 150, 212, 212; --accent: #a8e0e0; --soft: #d2e2e1; }     /* MVG: aqua + peach */
    .pw-card--mvg::before { background: radial-gradient(circle, rgba(150, 212, 212, 0.3), rgba(240, 201, 184, 0.08) 45%, transparent 68%); }
    .pw-card--jp { --base: #373b46; --glow: 122, 148, 224; --accent: #aebef0; --soft: #d1d6ea; }      /* Japan: indigo */
    .pw-card--flip { grid-template-columns: 1fr 1.25fr; }
    .pw-mosaic { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: 150px 150px; gap: 10px; min-width: 0; }
    .pw-mosaic img { width: 100%; height: 100%; object-fit: cover; border-radius: 14px; display: block; }
    .pw-mosaic .pw-tall { grid-row: span 2; }
    /* website projects: the logo whole in the tall cell, screenshots cropped from the top */
    .pw-mosaic .pw-logo { object-fit: contain; }
    .pw-mosaic--web img:not(.pw-logo) { object-position: 50% 0; border: 1px solid rgba(246, 241, 232, 0.1); box-sizing: border-box; }
    /* button to the Web & Full-Stack page (under the projects and in the Web & Booking service card) */
    .web-cta-row { display: flex; justify-content: center; margin-top: 2.4rem; }
    /* filled orange, like the "Say hello" button in the header */
    .web-cta {
      position: relative; overflow: hidden; display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 13px 26px; border-radius: 100px; border: 0; background: var(--terracotta); color: #fff;
      font-size: 15px; font-weight: 600; white-space: nowrap;
      box-shadow: 0 10px 28px -12px rgba(226, 134, 90, 0.7);
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .web-cta:hover { background: var(--terracotta-deep); color: #fff; transform: translateY(-1px); box-shadow: 0 14px 32px -12px rgba(226, 134, 90, 0.85); }
    .web-cta--card { margin-top: 1.4rem; align-self: flex-start; padding: 11px 20px; font-size: 14px; }
    .pw-live { margin-left: 8px; font-size: 10.5px; letter-spacing: 1.2px; background: #dcefe2; color: #24563a; border-radius: 6px; padding: 2px 8px; vertical-align: 1px; }

    @media (max-width: 900px) {
      .pw-sp, .pw-card, .pw-card--flip { grid-template-columns: 1fr; }
      .pw-card--flip .pw-mosaic { order: -1; }
      .pw-sp { padding: 2.1rem 1.5rem; gap: 1.75rem; }
      .pw-sp h3 { font-size: 25px; }
      .pw h3 { font-size: 24px; }
      .pw-card { padding: 1.35rem; gap: 1.4rem; }
      .pw-phones { gap: 10px; }
      .pw-phone { width: 30%; }
      .pw-phone--mid { width: 34%; }
      .pw-mosaic { grid-template-rows: 112px 112px; gap: 8px; }
      .pw-sp-logo { width: 200px; }
    }


    .work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .work-grid--single {
      grid-template-columns: 1fr;
    }
    .work-grid--single .work-card--lg {
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }

    .work-card {
      position: relative;
      display: block;
      border-radius: 4px;
      overflow: hidden;
      background: var(--cream-deep);
      aspect-ratio: 4 / 5;
    }

    .work-card--lg { grid-row: span 2; aspect-ratio: auto; }

    .work-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .work-card:hover img { transform: scale(1.04); }

    .work-card-info {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 1.5rem;
      background: linear-gradient(180deg, transparent, rgba(20,16,10,0.85) 70%);
      color: #fff;
    }

    .work-card-tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #fff;
      background: var(--terracotta);
      padding: 4px 10px;
      border-radius: 100px;
      margin-bottom: 0.6rem;
    }
    .work-card-info h3 { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; margin: 0 0 0.35rem; }
    .work-card-info p { font-size: 13px; color: rgba(255,255,255,0.85); margin: 0; line-height: 1.5; }

    .work-card--placeholder { cursor: default; }

    /* ---------- SERVICES ---------- */
    .services-section { background: var(--night); }

    /* service cards: the same black + orange frame as the project cards; the middle one (most asked for) is
       highlighted with a stronger orange wash. All three share the text colours. */
    .tone-green, .tone-orange, .tone-beige {
      --card-ink: #fff; --card-soft: rgba(246,241,232,0.78); --card-faint: #e2865a;
      --card-accent: #e2865a; --card-line: rgba(226,134,90,0.45); --card-icon: #e2865a;
      --pill-bg: rgba(226,134,90,0.1); --pill-bd: rgba(226,134,90,0.4); --pill-ink: #f0c9a8; --pill-ink-local: #f0c9a8;
      --card-bg: linear-gradient(160deg, rgba(226,134,90,0.2) 0%, rgba(226,134,90,0.06) 45%, rgba(226,134,90,0.02) 100%), #27292d;
      --card-border: rgba(226,134,90,0.55);
    }
    .tone-orange {
      --card-bg: linear-gradient(160deg, rgba(226,134,90,0.42) 0%, rgba(193,102,62,0.2) 50%, rgba(193,102,62,0.1) 100%), #161210;
      --card-border: #e2865a;
    }

    .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }

    .service-block {
      position: relative;
      overflow: hidden;
      isolation: isolate;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      background: var(--card-bg);
      border: 1.5px solid var(--card-border);
      border-radius: 18px;
      padding: 2.75rem;
      box-shadow: 0 0 46px -18px rgba(226,134,90,0.35), 0 22px 44px -28px rgba(0,0,0,0.7);
    }

    .service-icon { color: var(--card-icon); margin-bottom: 1.5rem; }

    .service-kicker { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; color: var(--card-faint); margin-bottom: 0.75rem; text-transform: uppercase; }

    .service-block h3 { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; color: var(--card-ink); margin: 0 0 1rem; }
    .service-block p { font-size: 15px; color: var(--card-soft); line-height: 1.7; margin: 0 0 1.25rem; }
    .service-checklist {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 1rem;
      margin-bottom: 1.5rem;
    }
    .service-checklist span { font-size: 12.5px; color: var(--card-soft); }
    .service-location {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-size: 12px; font-weight: 600; letter-spacing: 0.3px;
      color: var(--pill-ink);
      background: var(--pill-bg);
      border: 1px solid var(--pill-bd);
      border-radius: 100px;
      padding: 0.4rem 0.85rem;
      margin-top: auto;
    }
    .service-location svg { flex-shrink: 0; }
    .service-location--local { color: var(--pill-ink-local); }


    /* ---------- CASCADE: steps down and to the right, same as the About page ---------- */
    .cas { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.1rem; align-items: start; margin-top: 3rem; padding-bottom: 0.5rem; }
    .cas-item { grid-column: var(--c) / span 4; grid-row: 1; margin: calc(var(--k) * 3.2rem) 0 0 -2rem; position: relative; z-index: var(--n); }
    .cas-first { margin-left: 0; }
    .cas-ph { display: block; overflow: hidden; box-sizing: border-box; border: 5px solid #fff; border-radius: 10px; background: #2f3136; box-shadow: 0 22px 44px -22px rgba(0,0,0,0.6); }
    .cas-r43 { aspect-ratio: 4 / 3; }
    .cas-r34 { aspect-ratio: 3 / 4; }
    .cas-ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
    .cas-ph:hover img { transform: scale(1.035); }
    .cas-cap { position: absolute; left: 0.7rem; top: 0.7rem; font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #fff; background: rgba(47, 49, 54,0.55); backdrop-filter: blur(4px); padding: 4px 10px; border-radius: 999px; }
    .cas-panel { display: block; color: var(--card-ink); background: var(--card-bg); border-radius: 10px; padding: 1.7rem 1.6rem 1.8rem; box-shadow: 0 22px 44px -22px rgba(34,24,16,0.6); }
    .cas-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: var(--tag-ink); background: var(--tag-bg); padding: 4px 10px; border-radius: 100px; margin-bottom: 0.9rem; }
    .cas-panel h3 { font-family: 'Fraunces', serif; font-size: 24px; font-weight: 600; line-height: 1.2; margin: 0 0 0.6rem; }
    .cas-panel p { font-size: 14px; line-height: 1.6; color: var(--card-soft); margin: 0 0 1.1rem; }
    .cas-go { font-size: 14px; font-weight: 700; color: var(--card-accent); border-bottom: 1px solid var(--card-line); padding-bottom: 2px; transition: color 0.2s, border-color 0.2s; }
    .cas-panel:hover .cas-go { color: var(--card-ink); border-color: var(--card-ink); }

    /* services: the three cards take one step each */
    @media (min-width: 901px) {
      .services-grid { align-items: start; }
      .cas-step { margin-top: calc(var(--k) * 2.6rem); }
    }

    /* entry: each piece drifts in from the left and settles, one step after the other */
    :global(.cas-js) .cas-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--k, 0) * 120ms); }
    :global(.cas-js) .cas-reveal.in { opacity: 1; transform: none; }
    :global(.cas-js) .cas .cas-item.cas-reveal, :global(.cas-js) .cas-step.cas-reveal { transform: translate(-34px, 30px); }
    :global(.cas-js) .cas .cas-item.cas-reveal.in, :global(.cas-js) .cas-step.cas-reveal.in { transform: none; }
    @media (prefers-reduced-motion: reduce) {
      :global(.cas-js) .cas-reveal, :global(.cas-js) .cas .cas-item.cas-reveal, :global(.cas-js) .cas-step.cas-reveal { opacity: 1; transform: none; transition: none; }
    }
    @media (max-width: 960px) {
      .cas { column-gap: 0.8rem; }
      .cas-item { margin-top: calc(var(--k) * 2.2rem); margin-left: -1.4rem; }
      .cas-first { margin-left: 0; }
    }
    /* small screens: a gentler zigzag instead of the full cascade */
    @media (max-width: 720px) {
      .cas { display: flex; flex-direction: column; margin-top: 2.2rem; padding-bottom: 1.6rem; }
      .cas .cas-item { width: 76%; margin: 0 0 -1.6rem 0; }
      .cas .cas-item:nth-child(odd) { align-self: flex-start; }
      .cas .cas-item:nth-child(even) { align-self: flex-end; }
      .cas .cas-item.cas-panel { align-self: stretch; width: auto; margin: 2.6rem 0 0; }
      :global(.cas-js) .cas .cas-item.cas-reveal:nth-child(even) { transform: translate(34px, 30px); }
      :global(.cas-js) .cas .cas-item.cas-reveal.in, :global(.cas-js) .cas .cas-item.cas-reveal.in:nth-child(even) { transform: none; }
    }

    /* ---------- CONTACT ---------- */
    .contact-section { background: var(--night-2); }
    .contact-inner { max-width: 700px; text-align: center; }
    .contact-inner .section-lead { margin-left: auto; margin-right: auto; }

    /* the form sits in the same black + orange panel as the project and service cards */
    .contact-form {
      position: relative; overflow: hidden; isolation: isolate;
      text-align: left; margin-top: 1rem;
      padding: 2.4rem 2.4rem 1.8rem;
      border: 1.5px solid rgba(226,134,90,0.55);
      border-radius: 22px;
      background: linear-gradient(160deg, rgba(226,134,90,0.18) 0%, rgba(226,134,90,0.05) 45%, rgba(226,134,90,0.02) 100%), #27292d;
      box-shadow: 0 0 46px -18px rgba(226,134,90,0.35), 0 22px 44px -28px rgba(0,0,0,0.7);
    }
    .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .cf-field { margin-bottom: 1.1rem; }
    .cf-field label { display: block; font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--peach); margin-bottom: 0.5rem; }
    .cf-field input, .cf-field select, .cf-field textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid rgba(226,134,90,0.28);
      background: rgba(47, 49, 54,0.55);
      font-family: inherit;
      font-size: 14px;
      color: var(--on-dark);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .cf-field input:hover, .cf-field select:hover, .cf-field textarea:hover { border-color: rgba(226,134,90,0.5); }
    .cf-field input:focus, .cf-field select:focus, .cf-field textarea:focus {
      outline: none; border-color: #e2865a; box-shadow: 0 0 0 3px rgba(226,134,90,0.22);
    }
    .cf-field.cf-error input, .cf-field.cf-error textarea { border-color: #d64545; }
    .cf-honeypot { position: absolute; left: -9999px; }
    .cf-field input::placeholder, .cf-field textarea::placeholder { color: var(--on-dark-faint); }
    .cf-field select option { color: var(--ink); background: #fff; }

    .cf-submit {
      width: 100%;
      background: var(--terracotta);
      color: #fff;
      border: none;
      padding: 15px;
      border-radius: 100px;
      font-size: 15px;
      font-weight: 600;
      margin-top: 0.5rem;
      cursor: pointer;
      box-shadow: 0 10px 30px -12px rgba(226,134,90,0.6);
      transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    }
    .cf-submit:hover { background: var(--terracotta-deep); transform: translateY(-1px); box-shadow: 0 14px 34px -12px rgba(226,134,90,0.7); }
    .cf-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    .cf-status { margin-top: 1rem; font-size: 14px; text-align: center; min-height: 20px; }
    .cf-status.success { color: #f0c9a8; }
    .cf-status.error { color: #f2a59a; }

    /* ---------- FOOTER ---------- */
    .footer { background: var(--night-3); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; border-top: 1px solid rgba(255,255,255,0.06); }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0 0 1rem; max-width: 300px; }
    .footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .footer-col a, .footer-col .footer-note { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .footer-col a:hover { color: var(--terracotta); }
    .footer-note { font-size: 12px; color: rgba(255,255,255,0.4); }
    .footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .work-grid { grid-template-columns: 1fr 1fr; }
      .work-card--lg { grid-column: span 2; aspect-ratio: 16/10; grid-row: auto; }
      .services-grid { grid-template-columns: 1fr; }
      .cf-row { grid-template-columns: 1fr; }
      .contact-form { padding: 1.6rem 1.25rem 1.2rem; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    /* With seven links the full nav needs ~1215px in English and ~1270px in German and Spanish
       (measured with the tighter 1.5rem gap); below that the header switches to the menu button
       instead of overlapping the logo and CTA. */
    @media (max-width: 1215px) {
      .desktop-nav, .header-cta { display: none; }
      .menu-toggle { display: flex; }
      .hdr-left { justify-content: flex-start; }
      .hdr-right { justify-content: flex-end; }
    }
    @media (max-width: 1270px) {
      .site-header--de .desktop-nav, .site-header--de .header-cta { display: none; }
      .site-header--de .menu-toggle { display: flex; }
      .site-header--de .hdr-left { justify-content: flex-start; }
      .site-header--de .hdr-right { justify-content: flex-end; }
    }

    /* Phones: the language switch now sits next to the menu button, so trim the
       header padding to keep the logo on one line. */
    @media (max-width: 560px) {
      .site-header, .site-header.scrolled { padding-left: 1.25rem; padding-right: 1.25rem; }
      .brand img { width: 36px; height: 36px; }
      .site-header.scrolled .brand img { width: 32px; height: 32px; }
    }
    @media (max-width: 380px) {
      .brand img { width: 34px; height: 34px; }
      .header-actions { gap: 0.75rem; }
    }

    @media (max-width: 560px) {
      .work-grid { grid-template-columns: 1fr; }
      .work-card--lg { grid-column: auto; }
      .footer-grid { grid-template-columns: 1fr; }
    }

  </style>

  <script>
    // Header scroll state
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      if (!header) return;
      header.classList.toggle('scrolled', window.scrollY > 40);
    });

    // Hero slides (what we do): a new slide every 7 s, a progress bar per slide, arrows, swipe and the arrow keys.
    // Same behaviour as the RacksBrax Europe concept; it pauses while the hero is off screen or the tab is hidden,
    // and people who ask for less motion get no auto-advance (the arrows and bars still work).
    (() => {
      const root = document.getElementById('hx');
      const slidesEl = root?.querySelector<HTMLElement>('.hx-slides');
      if (!root || !slidesEl) return;
      const slides = Array.from(root.querySelectorAll<HTMLElement>('.hx-slide'));
      const bgsEl = document.getElementById('hx-bgs');
      const bgs = Array.from(document.querySelectorAll<HTMLElement>('.hx-bg'));
      const dots = Array.from(root.querySelectorAll<HTMLElement>('.hx-dot'));
      const num = document.getElementById('hx-num');
      const nm = document.getElementById('hx-name');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const DUR = 7000;
      let cur = 0;
      let timer: number | undefined;
      let locked = false;
      let inView = true;
      root.style.setProperty('--dur', DUR + 'ms');

      // Background videos: loaded when their slide is shown (or is next), played from data-start while the
      // slide is on screen, and unloaded once it has faded out, so no frame of the film stays on any layer.
      const videoOf = (i: number) => bgs[i]?.querySelector('video') ?? null;
      function load(i: number) {
        const v = videoOf(i);
        if (!v || reduce) return;
        const src = v.dataset.src;
        if (src && v.getAttribute('src') !== src) { v.src = src; v.preload = 'auto'; }
      }
      function playBg(i: number) {
        const v = videoOf(i);
        if (!v || reduce) return;
        load(i);
        const start = Number(v.dataset.start || 0);
        const begin = () => { try { v.currentTime = start; } catch (e) { /* not seekable yet */ } void v.play().catch(() => {}); };
        if (v.readyState >= 1) begin(); else v.addEventListener('loadedmetadata', begin, { once: true });
      }
      function stopBg(i: number) {
        const v = videoOf(i);
        if (!v) return;
        window.setTimeout(() => {
          if (bgs[i].classList.contains('active')) return;
          v.pause();
          v.removeAttribute('src');
          v.load();
        }, 1500);
      }

      function setDots(n: number) {
        dots.forEach((d, i) => {
          d.classList.toggle('done', i < n);
          d.classList.toggle('on', i === n);
          d.setAttribute('aria-selected', i === n ? 'true' : 'false');
          const bar = d.firstElementChild as HTMLElement | null;
          if (bar) { bar.style.animation = 'none'; void bar.offsetWidth; bar.style.animation = ''; }
        });
        if (num) num.textContent = String(n + 1).padStart(2, '0');
        if (nm) nm.textContent = slides[n].dataset.name || '';
      }
      function restart() {
        window.clearTimeout(timer);
        if (reduce || document.hidden || !inView) return;
        timer = window.setTimeout(() => go(cur + 1, 1), DUR);
      }
      function go(target: number, dir?: number) {
        const n = (target + slides.length) % slides.length;
        if (n === cur || locked) return;
        const out = slides[cur];
        const inn = slides[n];
        locked = true;
        const d = typeof dir === 'number' ? dir : n > cur ? 1 : -1; // +1: the text travels right; -1: left
        const prev = cur;
        [slidesEl!, bgsEl].forEach((el) => {
          if (!el) return;
          el.classList.add('no-anim');
          el.style.setProperty('--d', String(d));
          void el.offsetWidth;
          el.classList.remove('no-anim');
        });
        out.classList.remove('active');
        out.classList.add('leaving');
        inn.classList.add('active');
        bgs[prev]?.classList.remove('active');
        bgs[prev]?.classList.add('leaving');
        bgs[n]?.classList.add('active');
        playBg(n);
        stopBg(prev);
        load((n + 1) % slides.length); // get the next slide's film ready
        cur = n;
        setDots(n);
        restart();
        window.setTimeout(() => { out.classList.remove('leaving'); bgs[prev]?.classList.remove('leaving'); locked = false; }, reduce ? 50 : 1400);
      }

      dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) window.clearTimeout(timer);
        else { setDots(cur); restart(); }
      });
      // The arrow keys move the slides anywhere on the page while the hero is on screen,
      // except while typing in a field (the contact form) or with a modifier key held.
      document.addEventListener('keydown', (e) => {
        if (!inView || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        const t = e.target as HTMLElement | null;
        if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
        if (e.key === 'ArrowRight') { e.preventDefault(); go(cur + 1, 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(cur - 1, -1); }
      });
      let sx: number | null = null;
      root.addEventListener('pointerdown', (e) => {
        sx = (e.target as Element).closest('a, button') ? null : e.clientX;
      });
      root.addEventListener('pointerup', (e) => {
        if (sx === null) return;
        const dx = e.clientX - sx;
        sx = null;
        if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      });
      root.addEventListener('pointercancel', () => { sx = null; });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([en]) => {
          inView = en.isIntersecting;
          root.classList.toggle('paused', !inView);
          if (inView) { setDots(cur); restart(); void videoOf(cur)?.play().catch(() => {}); }
          else { window.clearTimeout(timer); videoOf(cur)?.pause(); }
        }, { threshold: 0 }).observe(root);
      }
      setDots(0);
      playBg(0);
      restart();
    })();

    // Mobile menu
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    menuToggle?.addEventListener('click', () => mobileMenu?.classList.add('open'));
    mobileMenuClose?.addEventListener('click', () => mobileMenu?.classList.remove('open'));
    mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => mobileMenu.classList.remove('open')));

    // Contact form (Web3Forms)
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('cf-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (form.querySelector('#cf-name') as HTMLInputElement).value.trim();
      const email = (form.querySelector('#cf-email') as HTMLInputElement).value.trim();
      const location = (form.querySelector('#cf-location') as HTMLInputElement).value.trim();
      const message = (form.querySelector('#cf-message') as HTMLTextAreaElement).value.trim();
      const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      let firstInvalid: Element | null = null;

      ([
        [form.querySelector('#cf-name')!.closest('.cf-field')!, !!name],
        [form.querySelector('#cf-email')!.closest('.cf-field')!, emailValid],
        [form.querySelector('#cf-location')!.closest('.cf-field')!, !!location],
        [form.querySelector('#cf-message')!.closest('.cf-field')!, !!message],
      ] as [Element, boolean][]).forEach(([field, isValid]) => {
        field.classList.toggle('cf-error', !isValid);
        if (!isValid && !firstInvalid) firstInvalid = field;
      });

      if (firstInvalid) {
        (firstInvalid as Element).querySelector<HTMLElement>('input, textarea')?.focus();
        return;
      }

      const submitBtn = form.querySelector('.cf-submit') as HTMLButtonElement | null;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = form.dataset.sending || 'Sending…'; }
      if (status) { status.textContent = ''; status.className = 'cf-status'; }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (data.success) {
          if (status) { status.textContent = form.dataset.ok || "Thank you — your message arrived. A reply follows soon."; status.className = 'cf-status success'; }
          form.reset();
        } else {
          throw new Error(data.message || 'Something went wrong.');
        }
      } catch (err) {
        if (status) { status.textContent = form.dataset.error || 'Something went wrong. Please send an email directly instead.'; status.className = 'cf-status error'; }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = form.dataset.send || 'Send message'; }
      }
    });

    form?.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => {
        el.closest('.cf-field')?.classList.remove('cf-error');
      });
    });
  </script>

</Layout>
