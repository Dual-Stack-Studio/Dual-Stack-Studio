function lineIcon(name: string, size = 32, strokeWidth = 1.6) {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round">${lineIcons[name] ?? ''}</svg>`;
}

// Hero backgrounds, one per hero slide (same order as `heroSlides` in the copy), all our own work:
// two buffet photos from Mister Jin, restaurant photography from Japan, a moving cut of the Dual-Stack reel,
// two live client websites, the reel on phones, and the lanterns on the Mister Jin facade for "from idea to brand".
// `pos` is the crop focus. `img2` fades in halfway through the slide. A `video` plays from `start` while its
// slide is shown; the image is its poster.
// `narrow` replaces `img` on 4:3 to 16:10 windows, where the panel shows less of the picture.
type HeroBg = { img: string; narrow?: string; pos?: string; img2?: string; pos2?: string; video?: { src: string; start: number } };
const heroBgs: HeroBg[] = [
  { img: '/images/hero-slides/mj-buffet-1.jpg', pos: '40% 60%', img2: '/images/hero-slides/mj-buffet-2.jpg', pos2: '35% 55%' },
