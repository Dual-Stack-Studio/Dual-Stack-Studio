---
import { altPaths } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  class?: string;
  /** Which languages to offer on this page. Pages without a Spanish version keep the default. */
  langs?: Lang[];
}

const { lang, class: className = '', langs = ['en', 'de'] } = Astro.props;
const paths = altPaths(Astro.url.pathname);
const hrefs: Record<Lang, string> = { en: paths.en, de: paths.de, es: paths.es };
const labels: Record<Lang, string> = { en: 'EN', de: 'DE', es: 'ES' };
---

<span class={`lang-switch ${className}`} role="group" aria-label="Language / Sprache / Idioma">
  {langs.map((l, i) => (
    <>
      {i > 0 && <span class="lang-switch-sep" aria-hidden="true">/</span>}
      <a href={hrefs[l]} hreflang={l} lang={l} aria-current={lang === l ? 'true' : undefined} class:list={[{ 'is-active': lang === l }]}>{labels[l]}</a>
    </>
  ))}
</span>

<style is:global>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    line-height: 1;
  }
  .lang-switch a {
    color: inherit;
    opacity: 0.55;
    padding: 4px 2px;
    transition: opacity 0.2s ease;
  }
  .lang-switch a:hover { opacity: 0.9; }
  .lang-switch a.is-active { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  .lang-switch-sep { opacity: 0.35; }
</style>
