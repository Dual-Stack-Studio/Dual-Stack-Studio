---
import { SITE, altPaths } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, lang = "en", description = lang === "de" ? "Dual-Stack Studio — Wir bauen Full-Stack-Produkte" : "Dual-Stack Studio — We build full-stack products" } = Astro.props;
const alt = altPaths(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="en" href={SITE + alt.en} />
    <link rel="alternate" hreflang="de" href={SITE + alt.de} />
    <link rel="alternate" hreflang="x-default" href={SITE + alt.en} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #1a1a1a;
        background:
          radial-gradient(800px 500px at 50% 86%, rgba(193, 102, 62, 0.09), transparent),
          radial-gradient(900px 600px at 88% 99%, rgba(193, 102, 62, 0.12), transparent),
          radial-gradient(600px 400px at 6% 93%, rgba(193, 102, 62, 0.06), transparent),
          linear-gradient(180deg, #0a0a0a 0%, #1a1a1a 6%, #3a3d32 8.5%, #808070 10.5%, #d0d0c8 12.5%, #eeeeee 14%, #eeeeee 68%, #d8d8d8 72%, #2a2a2a 77%, #121212 85%, #0a0a0a 100%);
        line-height: 1.6;
        animation: dssPageIn 0.5s ease both;
      }

      @keyframes dssPageIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        body { animation: none; }
      }

      a {
        color: #ebebeb;
        text-decoration: none;
        transition: color 0.3s;
      }

      a:hover {
        color: #e2865a;
      }

      button {
        cursor: pointer;
        transition: all 0.3s;
      }

      @keyframes float {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(10px, 10px); }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
