---
import Layout from './Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const de = lang === 'de';
---

<Layout title={title} description={description} lang={lang}>
  <div class="legal-page">
    <header class="legal-header">
      <a href={l(lang, '/')} class="legal-logo"><img src="/logo.svg" alt="" width="24" height="24" style="border-radius: 6px;" /> Dual-Stack Studio</a>
      <span class="legal-header-right">
        <LangSwitch lang={lang} />
        <a href={l(lang, '/')} class="legal-back">{de ? '← Zurück zur Website' : '← Back to site'}</a>
      </span>
    </header>

    <main class="legal-content">
      <slot />
    </main>

    <footer class="legal-footer">
      <p>{de ? '© 2026 Dual-Stack Studio. Unabhängig betrieben.' : '© 2026 Dual-Stack Studio. Independently operated.'}</p>
      <div>
        <a href={l(lang, '/privacy-policy')}>{de ? 'Datenschutzerklärung' : 'Privacy Policy'}</a>
        <a href={l(lang, '/terms-of-service')}>{de ? 'Nutzungsbedingungen' : 'Terms of Service'}</a>
        <a href={l(lang, '/impressum')}>Impressum</a>
      </div>
    </footer>
  </div>

  <style is:global>
    .legal-header-right { display: inline-flex; align-items: center; gap: 1.5rem; }
    body {
      background: #eeeeee;
      color: #333;
    }

    .legal-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 2rem 6rem;
    }

    .legal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 2rem 0;
      border-bottom: 1px solid rgba(0, 0, 0, 0.08);
      margin-bottom: 3rem;
    }

    .legal-logo {
      font-size: 18px;
      font-weight: 800;
      color: #0a0a0a !important;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .legal-logo span {
      color: #0a0a0a;
    }

    .legal-back {
      font-size: 14px;
      color: #666 !important;
    }

    .legal-back:hover {
      color: #0a0a0a !important;
    }

    .legal-eyebrow {
      font-size: 12px;
      font-weight: 700;
      color: #0a0a0a;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .legal-content h1 {
      font-size: clamp(28px, 9vw, 40px);
      font-weight: 800;
      letter-spacing: -1px;
      color: #0a0a0a;
      margin: 0.5rem 0 0.5rem;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .legal-updated {
      font-size: 13px;
      color: #777;
      margin-bottom: 2.5rem;
    }

    .legal-content p {
      font-size: 15px;
      line-height: 1.75;
      color: #444;
      margin: 0 0 1.25rem 0;
    }

    .legal-content h2 {
      font-size: 20px;
      font-weight: 700;
      color: #0a0a0a;
      margin: 2.5rem 0 1rem;
    }

    .legal-content ul {
      margin: 0 0 1.25rem 0;
      padding-left: 1.25rem;
    }

    .legal-content li {
      font-size: 15px;
      line-height: 1.75;
      color: #444;
      margin-bottom: 0.4rem;
    }

    .legal-content a {
      color: #0a0a0a;
    }

    .legal-disclaimer {
      font-size: 13px;
      font-style: italic;
      color: #777;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
    }

    .legal-footer {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 2.5rem;
      margin-top: 3rem;
      border-top: 1px solid rgba(0, 0, 0, 0.08);
      font-size: 13px;
      color: #777;
    }

    .legal-footer div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
    }

    .legal-footer a {
      color: #666;
    }

    .legal-footer a:hover {
      color: #0a0a0a;
    }

    @media (max-width: 600px) {
      .legal-footer {
        flex-direction: column;
      }
    }
  </style>
</Layout>
