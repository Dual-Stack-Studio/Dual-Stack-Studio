---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="legal-page">
    <header class="legal-header">
      <a href="/" class="legal-logo"><img src="/logo.svg" alt="" width="24" height="24" style="border-radius: 6px;" /> Dual-Stack Studio</a>
      <a href="/" class="legal-back">← Back to site</a>
    </header>

    <main class="legal-content">
      <slot />
    </main>

    <footer class="legal-footer">
      <p>© 2026 Dual-Stack Studio. Independently operated.</p>
      <div>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-service">Terms of Service</a>
      </div>
    </footer>
  </div>

  <style is:global>
    body {
      background: #0a0a0a;
      color: #ccc;
    }

    .legal-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 2rem 6rem;
    }

    .legal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 2rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 3rem;
    }

    .legal-logo {
      font-size: 18px;
      font-weight: 800;
      color: #ffffff !important;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .legal-logo span {
      color: #22d3ee;
    }

    .legal-back {
      font-size: 14px;
      color: #999 !important;
    }

    .legal-back:hover {
      color: #22d3ee !important;
    }

    .legal-eyebrow {
      font-size: 12px;
      font-weight: 700;
      color: #22d3ee;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .legal-content h1 {
      font-size: 40px;
      font-weight: 800;
      letter-spacing: -1px;
      color: #ffffff;
      margin: 0.5rem 0 0.5rem;
    }

    .legal-updated {
      font-size: 13px;
      color: #666;
      margin-bottom: 2.5rem;
    }

    .legal-content p {
      font-size: 15px;
      line-height: 1.75;
      color: #bbb;
      margin: 0 0 1.25rem 0;
    }

    .legal-content h2 {
      font-size: 20px;
      font-weight: 700;
      color: #ffffff;
      margin: 2.5rem 0 1rem;
    }

    .legal-content ul {
      margin: 0 0 1.25rem 0;
      padding-left: 1.25rem;
    }

    .legal-content li {
      font-size: 15px;
      line-height: 1.75;
      color: #bbb;
      margin-bottom: 0.4rem;
    }

    .legal-content a {
      color: #22d3ee;
    }

    .legal-disclaimer {
      font-size: 13px;
      font-style: italic;
      color: #666;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .legal-footer {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 2.5rem;
      margin-top: 3rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 13px;
      color: #555;
    }

    .legal-footer div {
      display: flex;
      gap: 1.5rem;
    }

    .legal-footer a {
      color: #777;
    }

    .legal-footer a:hover {
      color: #22d3ee;
    }

    @media (max-width: 600px) {
      .legal-footer {
        flex-direction: column;
      }
    }
  </style>
</Layout>
