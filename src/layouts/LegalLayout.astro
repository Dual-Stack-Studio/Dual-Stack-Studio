---
import Layout from './Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  langs?: Lang[];
}

const { title, description, lang = 'en', langs = ['en', 'de'] } = Astro.props;
const t = {
  en: { back: '← Back to site', rights: '© 2026 Dual-Stack Studio. Independently operated.', privacy: 'Privacy Policy', terms: 'Terms of Service' },
  de: { back: '← Zurück zur Website', rights: '© 2026 Dual-Stack Studio. Unabhängig betrieben.', privacy: 'Datenschutzerklärung', terms: 'Nutzungsbedingungen' },
  es: { back: '← Volver al sitio', rights: '© 2026 Dual-Stack Studio. Operado de forma independiente.', privacy: 'Política de Privacidad', terms: 'Términos de Servicio' },
}[lang];
---

<Layout title={title} description={description} lang={lang} langs={langs}>
  <div class="legal-page">
    <header class="legal-header">
      <a href={l(lang, '/')} class="legal-logo" aria-label="Dual-Stack Studio"><img src="/logo.svg" alt="" width="44" height="44" style="border-radius: 25%;" /> Dual-Stack Studio</a>
      <span class="legal-header-right">
        <LangSwitch lang={lang} langs={langs} />
        <a href={l(lang, '/')} class="legal-back">{t.back}</a>
      </span>
    </header>

    <main class="legal-content">
      <slot />
    </main>

    <footer class="legal-footer">
      <p>{t.rights}</p>
      <div>
        <a href={l(lang, '/privacy-policy')}>{t.privacy}</a>
        <a href={l(lang, '/terms-of-service')}>{t.terms}</a>
        <a href={l(lang, '/impressum')}>Impressum</a>
      </div>
    </footer>
  </div>

  <style is:global>
    .legal-header-right { display: inline-flex; align-items: center; gap: 1.5rem; }
    body {
      background: #1a1a1a;
      color: #d8d4cc;
    }

    .legal-page {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 2rem 6rem;
    }

    .legal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 2rem 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      margin-bottom: 3rem;
    }

    .legal-logo {
      font-size: 18px;
      font-weight: 800;
      color: #f6f1e8 !important;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .legal-logo span {
      color: #f6f1e8;
    }

    .legal-back {
      font-size: 14px;
      color: #a9a29a !important;
    }

    .legal-back:hover {
      color: #e2865a !important;
    }

    .legal-eyebrow {
      font-size: 12px;
      font-weight: 700;
      color: #f6f1e8;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .legal-content h1 {
      font-size: clamp(28px, 9vw, 40px);
      font-weight: 800;
      letter-spacing: -1px;
      color: #f6f1e8;
      margin: 0.5rem 0 0.5rem;
      overflow-wrap: break-word;
      hyphens: auto;
    }

    .legal-updated {
      font-size: 13px;
      color: #9a948c;
      margin-bottom: 2.5rem;
    }

    .legal-content p {
      font-size: 15px;
      line-height: 1.75;
      color: #c9c3ba;
      margin: 0 0 1.25rem 0;
    }

    .legal-content h2 {
      font-size: 20px;
      font-weight: 700;
      color: #f6f1e8;
      margin: 2.5rem 0 1rem;
    }

    .legal-content ul {
      margin: 0 0 1.25rem 0;
      padding-left: 1.25rem;
    }

    .legal-content li {
      font-size: 15px;
      line-height: 1.75;
      color: #c9c3ba;
      margin-bottom: 0.4rem;
    }

    .legal-content a {
      color: #f6f1e8;
    }

    .legal-disclaimer {
      font-size: 13px;
      font-style: italic;
      color: #9a948c;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .legal-footer {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-top: 2.5rem;
      margin-top: 3rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 13px;
      color: #9a948c;
    }

    .legal-footer div {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
    }

    .legal-footer a {
      color: #a9a29a;
    }

    .legal-footer a:hover {
      color: #f6f1e8;
    }

    @media (max-width: 600px) {
      .legal-footer {
        flex-direction: column;
      }

      .legal-header-right {
        gap: 0.9rem;
      }

      .legal-logo {
        font-size: 16px;
        white-space: nowrap;
      }

      .legal-back {
        font-size: 0;
      }

      .legal-back::before {
        content: '←';
        font-size: 22px;
        font-weight: 700;
      }
    }

    @media (max-width: 480px) {
      .legal-logo {
        font-size: 0;
        gap: 0;
      }
    }
  </style>
</Layout>
