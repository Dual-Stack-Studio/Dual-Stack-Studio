---
import { SITE, altPaths } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
}

const { title, lang = "en", description = lang === "de" ? "Dual-Stack Studio — Wir erzählen die Geschichten kleiner Orte, die echte Arbeit leisten" : "Dual-Stack Studio — We tell the story of small places doing real work" } = Astro.props;
const alt = altPaths(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="alternate" hreflang="en" href={SITE + alt.en} />
    <link rel="alternate" hreflang="de" href={SITE + alt.de} />
    <link rel="alternate" hreflang="x-default" href={SITE + alt.en} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #2b2420;
        background: #f7f2e7;
        line-height: 1.6;
        animation: dssPageIn 0.5s ease both;
      }

      @keyframes dssPageIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        body { animation: none; }
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.3s;
      }

      button {
        cursor: pointer;
        transition: all 0.3s;
        font-family: inherit;
      }

      h1, h2, h3, .serif {
        font-family: 'Fraunces', Georgia, serif;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
