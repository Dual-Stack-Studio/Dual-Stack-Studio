---
import { SITE, altPaths } from "../i18n";
import type { Lang } from "../i18n";

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  /** Which languages actually exist for this page (controls which hreflang alternates are emitted). */
  langs?: Lang[];
}

const descriptions: Record<Lang, string> = {
  en: "Dual-Stack Studio — Stories for family businesses and small places doing real work",
  de: "Dual-Stack Studio — Geschichten für Familienbetriebe und kleine Orte, die echte Arbeit leisten",
  es: "Dual-Stack Studio — Historias para negocios familiares y lugares pequeños que hacen un trabajo real",
};
const { title, lang = "en", description = descriptions[lang as Lang] ?? descriptions.en, langs = ["en", "de"] } = Astro.props;
const alt = altPaths(Astro.url.pathname);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {langs.includes('en') && <link rel="alternate" hreflang="en" href={SITE + alt.en} />}
    {langs.includes('de') && <link rel="alternate" hreflang="de" href={SITE + alt.de} />}
    {langs.includes('es') && <link rel="alternate" hreflang="es" href={SITE + alt.es} />}
    <link rel="alternate" hreflang="x-default" href={SITE + alt.en} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <!-- fonts are served from this site, so no visitor data goes to Google -->
    <link rel="preload" href="/fonts/inter-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <title>{title}</title>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: #f6f1e8;
        background: #0a0a0a;
        line-height: 1.6;
        animation: dssPageIn 0.5s ease both;
      }

      @keyframes dssPageIn {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      @media (prefers-reduced-motion: reduce) {
        body { animation: none; }
      }

      a {
        color: inherit;
        text-decoration: none;
        transition: color 0.3s;
      }

      button {
        cursor: pointer;
        transition: all 0.3s;
        font-family: inherit;
      }

      h1, h2, h3, .serif {
        font-family: 'Fraunces', Georgia, serif;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
