const c = copy[lang];
// Photography, the Journal and the Japan case study don't have Spanish pages yet — fall back to English for those links.
const lOut: Lang = lang === 'es' ? 'en' : lang;
---

<Layout title={c.title} lang={lang} langs={['en', 'de', 'es']}>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-slides" aria-hidden="true">
      <div
        class="hero-slide hero-slide--first is-active"
        style={`--pos-wide: ${wideFirst.pos}; --dim-wide: ${wideFirst.dim}; --pos-tall: ${tallFirst.pos}; --dim-tall: ${tallFirst.dim};`}
      >
        <picture>
          <source media="(max-aspect-ratio: 1/1)" srcset={tallFirst.srcset} sizes="max(100vw, 57vh)" />
          <img src={wideFirst.src} srcset={wideFirst.srcset} sizes="max(100vw, 178vh)" alt="" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      {wideRest.map((s) => (
        <div class="hero-slide hero-slide--wide" style={`--pos: ${s.pos}; --dim: ${s.dim};`}>
          <img data-src={s.src} data-srcset={s.srcset} sizes="max(100vw, 178vh)" alt="" decoding="async" />
        </div>
      ))}
      {tallRest.map((s) => (
        <div class="hero-slide hero-slide--tall" style={`--pos: ${s.pos}; --dim: ${s.dim};`}>
          <img data-src={s.src} data-srcset={s.srcset} sizes="max(100vw, 57vh)" alt="" decoding="async" />
        </div>
      ))}
    </div>
    <div class="hero-scrim"></div>

    <header id="site-header" class:list={['site-header', { 'site-header--de': lang === 'de' || lang === 'es' }]}>
      <a href={l(lang, '/creative')} class="brand">
        <img src="/logo.svg" alt="Dual-Stack Studio" width="34" height="34" style="border-radius: 8px;" />
        <span>Dual-Stack Studio</span>
      </a>
      <nav class="desktop-nav">
        <a href="#work">{c.navWork}</a>
        <a href={l(lang, '/photography')}>{c.navPhotography}</a>
        <a href="#services">{c.navServices}</a>
        <a href="#team">{c.navTeam}</a>
        <a href={l(lOut, '/journal')}>{c.navJournal}</a>
        <a href={l(lang, '/web')} class="nav-dept">{c.navWeb}</a>
      </nav>
      <div class="header-actions">
        <LangSwitch lang={lang} langs={['en', 'de', 'es']} />
        <a href="#contact" class="header-cta">{c.cta}</a>
      </div>
      <button id="menu-toggle" class="menu-toggle" aria-label={c.menuToggle} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div id="mobile-menu" class="mobile-menu">
      <button id="mobile-menu-close" class="mobile-menu-close" aria-label={c.menuClose}>✕</button>
      <a href="#work" class="mobile-nav-link">{c.navWork}</a>
      <a href={l(lang, '/photography')} class="mobile-nav-link">{c.navPhotography}</a>
      <a href="#services" class="mobile-nav-link">{c.navServices}</a>
      <a href="#team" class="mobile-nav-link">{c.navTeam}</a>
      <a href={l(lOut, '/journal')} class="mobile-nav-link">{c.navJournal}</a>
      <a href={l(lang, '/web')} class="mobile-nav-link">{c.navWeb}</a>
      <a href="#contact" class="mobile-cta">{c.cta}</a>
    </div>

    <div class:list={['hero-content', { 'hero-content--de': lang === 'de' || lang === 'es' }]}>
      <h1 class:list={['hero-title', { 'hero-title--de': lang === 'de' || lang === 'es' }]} set:html={c.heroTitle}></h1>
      <p class="hero-sub">{c.heroSub}</p>
    </div>

    <div class="scroll-hint">
      <p>{c.scroll}</p>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ============ OUR WORK ============ -->
  <section id="work" class="section work-section">
    <div class="section-inner">
      <span class="eyebrow">{c.workEyebrow}</span>
      <h2 class="section-title">{c.workTitle}</h2>
      <p class="section-lead">{c.workLead}</p>

      <div class="work-grid work-grid--single">
        <a href={l(lOut, '/work/japan-restaurant')} class="work-card work-card--lg">
