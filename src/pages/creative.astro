---
import Layout from '../layouts/Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };

// Minimal line-icon set (Lucide-style), used for team role badges
const lineIcons: Record<string, string> = {
  laptop: '<path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z" /><path d="M20.054 15.987H3.946" />',
  design: '<path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z" /><circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />',
  camera: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" /><circle cx="12" cy="13" r="3" />',
  globe: '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
  share: '<circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.59 13.51 6.83 3.98" /><path d="m15.41 6.51-6.82 3.98" />',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" /><circle cx="12" cy="10" r="3" />',
};

function lineIcon(name: string, size = 32, strokeWidth = 1.6) {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round">${lineIcons[name] ?? ''}</svg>`;
}

// Hero background: our own photography, crossfaded by the script at the bottom.
// Two sets: wide photos for landscape windows, and portrait photos for tall ones (phones,
// portrait tablets), where a wide photo would be cropped hard. The first slide is shared and
// art-directed with <picture> (Alps lake on wide windows, first portrait photo on tall ones);
// it loads eagerly because it is the LCP image. The rest are requested after the page has
// loaded. Each photo fills the hero and is cropped around `pos` (where its subject sits), and
// `dim` evens out the brighter photos so the white headline stays readable.
const heroSlide = (name: string, widths: number[], pos: string, dim: number) => ({
  src: `/images/hero/${name}-${widths[widths.length - 1]}.webp`,
  srcset: widths.map((w) => `/images/hero/${name}-${w}.webp ${w}w`).join(', '),
  pos,
  dim,
});
const wideSlides = [
  heroSlide('wide-forest-cabin', [1280, 1920], '50% 50%', 0.1),
  heroSlide('wide-pink-basilica', [1280, 1920], '60% 50%', 0.2),
  heroSlide('wide-hunting-stand', [1280, 1920], '50% 50%', 0.1),
  heroSlide('wide-yellow-van', [1280, 1920], '50% 50%', 0.14),
  heroSlide('wide-beech-forest', [1280, 1920], '50% 50%', 0.14),
  heroSlide('wide-church-tower', [1280, 1920], '50% 50%', 0.16),
  heroSlide('wide-rally-car', [1280, 1920], '55% 50%', 0.12),
  heroSlide('wide-tree-carving', [1280, 1920], '50% 50%', 0.2),
];
const tallSlides = [
  heroSlide('mobile-forest-cabin', [750, 1000], '50% 50%', 0.08),
  heroSlide('mobile-pink-basilica', [750, 1125], '58% 50%', 0.2),
  heroSlide('mobile-hunting-stand', [750, 1125], '50% 50%', 0.08),
  heroSlide('mobile-yellow-van', [750, 1029], '50% 50%', 0.12),
  heroSlide('mobile-beech-forest', [750, 1000], '50% 50%', 0.1),
  heroSlide('mobile-church-tower', [750, 1125], '56% 50%', 0.18),
  heroSlide('mobile-rally-car', [750, 844], '50% 50%', 0.1),
  heroSlide('mobile-tree-carving', [750, 1125], '50% 46%', 0.16),
];
const [wideFirst, ...wideRest] = wideSlides;
const [tallFirst, ...tallRest] = tallSlides;

