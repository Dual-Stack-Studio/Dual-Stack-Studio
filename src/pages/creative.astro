    .work-card--lg { grid-row: span 2; aspect-ratio: auto; }

    .work-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .work-card:hover img { transform: scale(1.04); }

    .work-card-info {
      position: absolute;
      left: 0; right: 0; bottom: 0;
