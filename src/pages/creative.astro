---
import Layout from '../layouts/Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };

// Minimal line-icon set (Lucide-style), used for team role badges
const lineIcons: Record<string, string> = {
  laptop: '<path d="M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2z" /><path d="M20.054 15.987H3.946" />',
  design: '<path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z" /><circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" />',
  camera: '<path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z" /><circle cx="12" cy="13" r="3" />',
  globe: '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
};

function lineIcon(name: string, size = 32, strokeWidth = 1.6) {
  return `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${strokeWidth}" stroke-linecap="round" stroke-linejoin="round">${lineIcons[name] ?? ''}</svg>`;
}

// Hero background: our own photography, crossfaded by the script at the bottom.
// The first slide is the Alps lake photo and loads eagerly (it is the LCP image); the others
// are requested after the page has loaded. Each photo fills the hero and is cropped around
// `pos` (where its subject sits), and `dim` evens out the brighter photos so the white
// headline stays readable.
const heroSlide = (name: string, widths: number[], pos: string, dim: number) => ({
  src: `/images/hero/${name}-${widths[widths.length - 1]}.webp`,
  srcset: widths.map((w) => `/images/hero/${name}-${w}.webp ${w}w`).join(', '),
  pos,
  dim,
});
const heroSlides = [
  { src: '/images/hero-alps.jpg', srcset: '', pos: '50% 50%', dim: 0 },
  heroSlide('austria-valley', [1280, 1920], '28% 50%', 0.06),
  heroSlide('japan-sunset', [1280, 1920], '22% 50%', 0),
  heroSlide('tasmania-boardwalk', [1280, 1600], '30% 62%', 0.08),
  heroSlide('japan-toya-snow', [1280, 1920], '40% 60%', 0.24),
  heroSlide('austria-meadow', [1280, 1920], '72% 50%', 0),
  heroSlide('tasmania-fog', [1280, 1920], '45% 50%', 0.08),
  heroSlide('japan-window', [1280, 1920], '62% 50%', 0.3),
];

const copy = {
  en: {
    title: 'Dual-Stack Studio — We tell the story of small places doing real work',
    navWork: 'Work', navServices: 'Services', navTeam: 'Team', navJournal: 'Journal',
    navWeb: 'Web & Full-Stack ↗', cta: "Let's talk", menuToggle: 'Toggle menu', menuClose: 'Close menu',
    heroTitle: 'Telling the stories<br />of small places<br />doing real work.',
    heroSub: "We build the digital presence for farms, guesthouses and small local businesses — the photos, the film, the story, and the site behind it when you're ready.",
    scroll: 'Scroll',
    workEyebrow: 'Selected work', workTitle: 'Our Work',
    workLead: 'Real places, real stories — years of photography for a lodge in the mountains of Japan.',
    lodgeAlt: 'Mountain lodge, Japan', lodgeTag: 'Photography', lodgeTitle: 'A Lodge in Japan',
    lodgeText: 'Years of photography for a lodge and its restaurant in the mountains of Japan.',
    journalEyebrow: 'The Journal', journalTitle: 'Our Journal',
    journalLead: "Part travelogue, part about-us — the story of who we are, told one place at a time. We're starting with Australia.",
    journalAlt: 'The Brisbane skyline seen across the bush from a lookout',
    journalTag: 'Journal · Part 01', journalCardTitle: 'Australia',
    journalCardText: 'Months on the other side of the world — a city on the river, rainforest at the edge of it, and the work in between.',
    journalAll: 'Read the whole journal →',
    servicesEyebrow: 'What we do', servicesTitle: 'Two ways we help',
    s1Kicker: '01 — Where most people start', s1Title: 'Content & Storytelling',
    s1Text: 'Photography, drone footage and short-form video that actually shows what makes your place worth visiting. We shoot it, edit it, and help you tell the story on social — no website required to get started.',
    s2Kicker: "02 — When you're ready to grow", s2Title: 'Web & Booking',
    s2Text: 'Once content is working, we build the site behind it — a real online presence, and a booking system if you need one. Same team, same story, just the next step.',
    teamEyebrow: 'Who I am', teamTitle: 'One person, three disciplines',
    teamLead: 'Every step handled start to finish — from the first photo to production deploy.',
    t1Title: 'Content & Storytelling', t1Text: 'Photography, drone video and social storytelling for small local businesses.',
    t2Title: 'Design', t2Text: 'Brand and visual identity, from a logo to a full site — clean, warm, and true to the place.',
    t3Title: 'Full-Stack Development', t3Text: 'The site and booking system behind the story, when you need one.',
    contactEyebrow: 'Get in touch', contactTitle: "Let's tell your story.",
    contactLead: "Tell us a bit about your business and we'll get back to you within 1–2 business days.",
    fName: 'Name', fNamePh: 'Your name', fEmail: 'Email', fEmailPh: 'you@business.com',
    fService: 'What do you need?', optContent: 'Content & Storytelling', optWeb: 'Web & Booking', optOther: 'Something else',
    fMessage: 'Message', fMessagePh: "Tell us a bit about your business and what you're looking for.",
    send: 'Send message', sending: 'Sending…',
    okMsg: "Thanks — we'll get back to you soon.", errMsg: 'Something went wrong. Please email us directly instead.',
    footTagline: 'We tell the story of small places doing real work — content, storytelling, and the web presence behind it.',
    builtTitle: 'Built in parallel',
    builtText: 'This website was built in parallel — design & vision by Dual-Stack Studio, implementation assisted by Claude AI.',
    licencesTitle: 'Trade licences',
    footNavTitle: 'Navigate', footLegalTitle: 'Legal', privacy: 'Privacy Policy', terms: 'Terms of Service',
    footContactTitle: 'Get in touch', footReply: 'Usually replies within 1–2 business days.',
    rights: '© 2026 Dual-Stack Studio. Independently operated.', builtWith: 'Built with Astro, deployed on Vercel.',
  },
  de: {
    title: 'Dual-Stack Studio — Wir erzählen die Geschichten kleiner Orte, die echte Arbeit leisten',
    navWork: 'Arbeiten', navServices: 'Leistungen', navTeam: 'Team', navJournal: 'Journal',
    navWeb: 'Web & Full-Stack ↗', cta: 'Sprechen wir', menuToggle: 'Menü umschalten', menuClose: 'Menü schließen',
    heroTitle: 'Wir erzählen die <br />Geschichten kleiner Orte, <br />die echte Arbeit leisten.',
    heroSub: 'Wir bauen den digitalen Auftritt für Bauernhöfe, Gästehäuser und kleine lokale Betriebe — die Fotos, den Film, die Geschichte und die Website dahinter, wenn Sie so weit sind.',
    scroll: 'Scrollen',
    workEyebrow: 'Ausgewählte Arbeiten', workTitle: 'Unsere Arbeiten',
    workLead: 'Echte Orte, echte Geschichten — jahrelange Fotografie für eine Lodge in den Bergen Japans.',
    lodgeAlt: 'Berglodge in Japan', lodgeTag: 'Fotografie', lodgeTitle: 'Eine Lodge in Japan',
    lodgeText: 'Jahrelange Fotografie für eine Lodge und ihr Restaurant in den Bergen Japans.',
    journalEyebrow: 'Das Journal', journalTitle: 'Unser Journal',
    journalLead: 'Halb Reisetagebuch, halb Über-uns — die Geschichte, wer wir sind, Ort für Ort erzählt. Wir beginnen mit Australien.',
    journalAlt: 'Die Skyline von Brisbane, von einem Aussichtspunkt über den Busch gesehen',
    journalTag: 'Journal · Teil 01', journalCardTitle: 'Australien',
    journalCardText: 'Monate am anderen Ende der Welt — eine Stadt am Fluss, Regenwald an ihrem Rand und die Arbeit dazwischen.',
    journalAll: 'Das ganze Journal lesen →',
    servicesEyebrow: 'Was wir tun', servicesTitle: 'Zwei Wege, wie wir helfen',
    s1Kicker: '01 — Hier beginnen die meisten', s1Title: 'Content & Storytelling',
    s1Text: 'Fotografie, Drohnenaufnahmen und Kurzvideos, die wirklich zeigen, was Ihren Ort besuchenswert macht. Wir drehen, schneiden und helfen Ihnen, die Geschichte auf Social Media zu erzählen — für den Anfang brauchen Sie keine Website.',
    s2Kicker: '02 — Wenn Sie wachsen möchten', s2Title: 'Web & Buchung',
    s2Text: 'Sobald der Content funktioniert, bauen wir die Website dahinter — einen echten Online-Auftritt und, wenn nötig, ein Buchungssystem. Gleiches Team, gleiche Geschichte, nur der nächste Schritt.',
    teamEyebrow: 'Wer ich bin', teamTitle: 'Eine Person, drei Disziplinen',
    teamLead: 'Jeder Schritt aus einer Hand — vom ersten Foto bis zum Livegang.',
    t1Title: 'Content & Storytelling', t1Text: 'Fotografie, Drohnenvideo und Social-Storytelling für kleine lokale Betriebe.',
    t2Title: 'Design', t2Text: 'Marke und visuelle Identität, vom Logo bis zur kompletten Website — klar, warm und dem Ort treu.',
    t3Title: 'Full-Stack-Entwicklung', t3Text: 'Die Website und das Buchungssystem hinter der Geschichte, wenn Sie eines brauchen.',
    contactEyebrow: 'Kontakt', contactTitle: 'Erzählen wir Ihre Geschichte.',
    contactLead: 'Erzählen Sie uns kurz von Ihrem Betrieb, wir melden uns innerhalb von 1–2 Werktagen.',
    fName: 'Name', fNamePh: 'Ihr Name', fEmail: 'E-Mail', fEmailPh: 'sie@betrieb.at',
    fService: 'Was brauchen Sie?', optContent: 'Content & Storytelling', optWeb: 'Web & Buchung', optOther: 'Etwas anderes',
    fMessage: 'Nachricht', fMessagePh: 'Erzählen Sie uns kurz von Ihrem Betrieb und was Sie suchen.',
    send: 'Nachricht senden', sending: 'Wird gesendet…',
    okMsg: 'Danke — wir melden uns bald bei Ihnen.', errMsg: 'Etwas ist schiefgelaufen. Bitte schreiben Sie uns stattdessen direkt eine E-Mail.',
    footTagline: 'Wir erzählen die Geschichten kleiner Orte, die echte Arbeit leisten — Content, Storytelling und der Webauftritt dahinter.',
    builtTitle: 'Parallel gebaut',
    builtText: 'Diese Website wurde parallel gebaut — Design und Vision von Dual-Stack Studio, Umsetzung unterstützt durch Claude AI.',
    licencesTitle: 'Gewerbeberechtigungen',
    footNavTitle: 'Navigation', footLegalTitle: 'Rechtliches', privacy: 'Datenschutzerklärung', terms: 'Nutzungsbedingungen',
    footContactTitle: 'Kontakt', footReply: 'Antwortet in der Regel innerhalb von 1–2 Werktagen.',
    rights: '© 2026 Dual-Stack Studio. Unabhängig betrieben.', builtWith: 'Erstellt mit Astro, bereitgestellt auf Vercel.',
  },
};
const c = copy[lang];
---

<Layout title={c.title} lang={lang}>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-slides" aria-hidden="true">
      {heroSlides.map((s, i) => (
        <div
          class:list={['hero-slide', { 'is-active': i === 0 }]}
          style={`--pos: ${s.pos}; --dim: ${s.dim};`}
        >
          {i === 0 ? (
            <img src={s.src} alt="" fetchpriority="high" decoding="async" />
          ) : (
            <img data-src={s.src} data-srcset={s.srcset} sizes="max(100vw, 178vh)" alt="" decoding="async" />
          )}
        </div>
      ))}
    </div>
    <div class="hero-scrim"></div>

    <header id="site-header" class:list={['site-header', { 'site-header--de': lang === 'de' }]}>
      <a href={l(lang, '/creative')} class="brand">
        <img src="/logo.svg" alt="Dual-Stack Studio" width="34" height="34" style="border-radius: 8px;" />
        <span>Dual-Stack Studio</span>
      </a>
      <nav class="desktop-nav">
        <a href="#work">{c.navWork}</a>
        <a href="#services">{c.navServices}</a>
        <a href="#team">{c.navTeam}</a>
        <a href={l(lang, '/journal')}>{c.navJournal}</a>
        <a href={l(lang, '/web')} class="nav-dept">{c.navWeb}</a>
      </nav>
      <div class="header-actions">
        <LangSwitch lang={lang} />
        <a href="#contact" class="header-cta">{c.cta}</a>
      </div>
      <button id="menu-toggle" class="menu-toggle" aria-label={c.menuToggle} aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </header>

    <div id="mobile-menu" class="mobile-menu">
      <button id="mobile-menu-close" class="mobile-menu-close" aria-label={c.menuClose}>✕</button>
      <a href="#work" class="mobile-nav-link">{c.navWork}</a>
      <a href="#services" class="mobile-nav-link">{c.navServices}</a>
      <a href="#team" class="mobile-nav-link">{c.navTeam}</a>
      <a href={l(lang, '/journal')} class="mobile-nav-link">{c.navJournal}</a>
      <a href={l(lang, '/web')} class="mobile-nav-link">{c.navWeb}</a>
      <a href="#contact" class="mobile-cta">{c.cta}</a>
    </div>

    <div class:list={['hero-content', { 'hero-content--de': lang === 'de' }]}>
      <h1 class:list={['hero-title', { 'hero-title--de': lang === 'de' }]} set:html={c.heroTitle}></h1>
      <p class="hero-sub">{c.heroSub}</p>
    </div>

    <div class="scroll-hint">
      <p>{c.scroll}</p>
      <div class="scroll-line"></div>
    </div>
  </section>

  <!-- ============ OUR WORK ============ -->
  <section id="work" class="section work-section">
    <div class="section-inner">
      <span class="eyebrow">{c.workEyebrow}</span>
      <h2 class="section-title">{c.workTitle}</h2>
      <p class="section-lead">{c.workLead}</p>

      <div class="work-grid work-grid--single">
        <a href={l(lang, '/work/japan-lodge')} class="work-card work-card--lg">
          <img src="/images/japan-lodge/lodge-hero-mountain-cabin.jpg" alt={c.lodgeAlt} loading="lazy" />
          <div class="work-card-info">
            <span class="work-card-tag">{c.lodgeTag}</span>
            <h3>{c.lodgeTitle}</h3>
            <p>{c.lodgeText}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ JOURNAL ============ -->
  <section id="journal" class="section journal-section">
    <div class="section-inner">
      <span class="eyebrow">{c.journalEyebrow}</span>
      <h2 class="section-title">{c.journalTitle}</h2>
      <p class="section-lead">{c.journalLead}</p>

      <div class="work-grid work-grid--single">
        <a href={l(lang, '/journal/australia')} class="work-card work-card--lg">
          <img src="/images/journal/australia/au-28.jpg" alt={c.journalAlt} loading="lazy" />
          <div class="work-card-info">
            <span class="work-card-tag">{c.journalTag}</span>
            <h3>{c.journalCardTitle}</h3>
            <p>{c.journalCardText}</p>
          </div>
        </a>
      </div>

      <a href={l(lang, '/journal')} class="journal-all-link">{c.journalAll}</a>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="section services-section">
    <div class="section-inner">
      <span class="eyebrow">{c.servicesEyebrow}</span>
      <h2 class="section-title">{c.servicesTitle}</h2>

      <div class="services-grid">
        <div class="service-block service-block--primary">
          <div class="service-icon" set:html={lineIcon('camera', 34)} />
          <span class="service-kicker">{c.s1Kicker}</span>
          <h3>{c.s1Title}</h3>
          <p>{c.s1Text}</p>
        </div>

        <div class="service-block">
          <div class="service-icon" set:html={lineIcon('globe', 34)} />
          <span class="service-kicker">{c.s2Kicker}</span>
          <h3>{c.s2Title}</h3>
          <p>{c.s2Text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TEAM ============ -->
  <section id="team" class="section team-section">
    <div class="section-inner">
      <span class="eyebrow">{c.teamEyebrow}</span>
      <h2 class="section-title">{c.teamTitle}</h2>
      <p class="section-lead">{c.teamLead}</p>

      <div class="team-grid">
        <div class="team-member">
          <div class="team-avatar" set:html={lineIcon('camera', 30)} />
          <h3>{c.t1Title}</h3>
          <p>{c.t1Text}</p>
        </div>
        <div class="team-member">
          <div class="team-avatar" set:html={lineIcon('design', 30)} />
          <h3>{c.t2Title}</h3>
          <p>{c.t2Text}</p>
        </div>
        <div class="team-member">
          <div class="team-avatar" set:html={lineIcon('laptop', 30)} />
          <h3>{c.t3Title}</h3>
          <p>{c.t3Text}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT ============ -->
  <section id="contact" class="section contact-section">
    <div class="section-inner contact-inner">
      <span class="eyebrow">{c.contactEyebrow}</span>
      <h2 class="section-title">{c.contactTitle}</h2>
      <p class="section-lead">{c.contactLead}</p>

      <form id="contact-form" class="contact-form" novalidate data-sending={c.sending} data-send={c.send} data-ok={c.okMsg} data-error={c.errMsg}>
        <!-- Web3Forms -->
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New inquiry from dualstackstudio.com" />
        <input type="hidden" name="from_name" value="Dual-Stack Studio site" />
        <input type="hidden" name="language" value={lang} />
        <input type="checkbox" name="botcheck" class="cf-honeypot" tabindex="-1" autocomplete="off" />

        <div class="cf-row">
          <div class="cf-field">
            <label for="cf-name">{c.fName}</label>
            <input type="text" id="cf-name" name="name" required placeholder={c.fNamePh} />
          </div>
          <div class="cf-field">
            <label for="cf-email">{c.fEmail}</label>
            <input type="email" id="cf-email" name="email" required placeholder={c.fEmailPh} />
          </div>
        </div>

        <div class="cf-field">
          <label for="cf-service">{c.fService}</label>
          <select id="cf-service" name="service">
            <option>{c.optContent}</option>
            <option>{c.optWeb}</option>
            <option>{c.optOther}</option>
          </select>
        </div>

        <div class="cf-field">
          <label for="cf-message">{c.fMessage}</label>
          <textarea id="cf-message" name="message" rows="5" required placeholder={c.fMessagePh}></textarea>
        </div>

        <button type="submit" class="cf-submit">{c.send}</button>
        <p id="cf-status" class="cf-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <!-- ============ FOOTER ============ -->
  <footer class="footer">
    <div class="section-inner">
      <div class="footer-grid">
        <div class="footer-brand">
          <div class="footer-logo">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="28" height="28" style="border-radius: 7px;" />
            Dual-Stack Studio
          </div>
          <p>{c.footTagline}</p>
          <h4>{c.builtTitle}</h4>
          <p class="footer-note-text">{c.builtText}</p>
          <h4>{c.licencesTitle}</h4>
          <p class="footer-note-text">Werbeagentur (GISA 40150451) · Berufsfotograf (GISA 40150383)<br />Sebastian Rodriguez, Haag. <a href={l(lang, '/impressum')}>Impressum</a></p>
        </div>

        <div class="footer-col">
          <h4>{c.footNavTitle}</h4>
          <a href="#work">{c.navWork}</a>
          <a href="#services">{c.navServices}</a>
          <a href="#team">{c.navTeam}</a>
          <a href={l(lang, '/journal')}>{c.navJournal}</a>
          <a href={l(lang, '/web')}>{c.navWeb}</a>
        </div>

        <div class="footer-col">
          <h4>{c.footLegalTitle}</h4>
          <a href={l(lang, '/privacy-policy')}>{c.privacy}</a>
          <a href={l(lang, '/terms-of-service')}>{c.terms}</a>
          <a href={l(lang, '/impressum')}>Impressum</a>
        </div>

        <div class="footer-col">
          <h4>{c.footContactTitle}</h4>
          <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
          <span class="footer-note">{c.footReply}</span>
        </div>
      </div>

      <div class="footer-bottom">
        <p>{c.rights}</p>
        <p>{c.builtWith}</p>
      </div>
    </div>
  </footer>

  <style>
    :root {
      --cream: #f7f2e7;
      --cream-deep: #efe6d4;
      --forest: #2f4436;
      --forest-deep: #223226;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --muted: #6b6156;
    }

    .section-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.75rem;
    }

    .eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--terracotta-deep);
      margin-bottom: 0.75rem;
    }

    .section-title {
      font-size: clamp(30px, 4.2vw, 46px);
      font-weight: 600;
      letter-spacing: -1px;
      color: var(--ink);
      margin: 0 0 0.9rem;
      line-height: 1.08;
    }

    .section-lead {
      font-size: 17px;
      color: var(--muted);
      max-width: 560px;
      margin: 0 0 3rem;
      line-height: 1.65;
    }

    .section { padding: 6rem 0; }

    /* ---------- HERO ---------- */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: var(--forest-deep);
    }

    /* Background slideshow. The incoming photo fades in on top of the outgoing one
       (which stays fully opaque underneath), so the picture never dips to the
       dark background mid-fade. Photos fill the hero edge to edge. */
    .hero-slides {
      position: absolute;
      inset: 0;
      overflow: hidden;
      isolation: isolate;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      z-index: 0;
      transition: opacity 2.2s ease-in-out;
    }
    .hero-slide.is-prev { opacity: 1; z-index: 1; transition: none; }
    .hero-slide.is-active { opacity: 1; z-index: 2; }

    .hero-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--pos, 50% 50%);
    }

    /* Per-photo dimming (--dim) for the brighter shots. */
    .hero-slide::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(14, 18, 10, var(--dim, 0));
    }

    .hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(20, 24, 16, 0.55) 0%, rgba(20, 24, 16, 0.15) 38%, rgba(20, 24, 16, 0.15) 60%, rgba(20, 24, 16, 0.75) 100%);
    }

    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 1.5rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      transition: background 0.3s, padding 0.3s;
    }

    /* keeps the white logo and links readable over the brighter photos */
    .site-header { text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35); }
    .site-header.scrolled, .header-cta { text-shadow: none; }
    .menu-toggle span { box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35); }

    .site-header.scrolled {
      background: rgba(20, 24, 16, 0.72);
      backdrop-filter: blur(8px);
      padding: 1rem 2.5rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Fraunces', serif;
      font-size: 19px;
      font-weight: 600;
      color: #fff;
    }

    .desktop-nav a, .header-cta { white-space: nowrap; }
    @media (min-width: 1001px) { .brand { white-space: nowrap; } }
    .desktop-nav { display: flex; gap: 2.25rem; font-size: 14px; font-weight: 500; }
    .desktop-nav a { color: rgba(255,255,255,0.9); }
    .desktop-nav a:hover { color: var(--terracotta); }
    .desktop-nav a.nav-dept {
      border: 1px solid rgba(255,255,255,0.35);
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 13px;
      transition: border-color 0.2s, color 0.2s;
    }
    .desktop-nav a.nav-dept:hover { border-color: var(--terracotta); color: var(--terracotta); }

    .header-actions { display: flex; align-items: center; gap: 1.25rem; }
    .header-actions :global(.lang-switch) { color: #fff; }

    .header-cta {
      background: var(--terracotta);
      color: #fff;
      padding: 12px 26px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .header-cta:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    .menu-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      padding: 6px;
    }
    .menu-toggle span { width: 22px; height: 2px; background: #fff; border-radius: 2px; }

    .mobile-menu {
      position: fixed;
      inset: 0;
      background: var(--forest-deep);
      z-index: 200;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-nav-link { font-family: 'Fraunces', serif; font-size: 28px; color: #fff; }
    .mobile-cta { margin-top: 1rem; background: var(--terracotta); color: #fff; padding: 14px 32px; border-radius: 100px; font-weight: 600; }
    .mobile-menu-close { position: absolute; top: 2rem; right: 2rem; background: none; border: none; color: #fff; font-size: 24px; }

    .hero-content {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 900px;
      padding: 2rem 1.5rem;
      text-align: center;
    }

    .hero-title {
      font-size: clamp(40px, 8vw, 84px);
      font-weight: 600;
      letter-spacing: -2px;
      line-height: 1.08;
      color: #fff;
      margin: 0;
      text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45), 0 0 3px rgba(0, 0, 0, 0.2);
    }

    /* The German headline has longer lines than the English one, so it gets a
       smaller cap and a wider box; on phones the forced breaks are dropped and
       the text balances itself. */
    .hero-content--de { max-width: 1100px; }
    .hero-title--de {
      font-size: clamp(32px, 5.4vw, 60px);
      letter-spacing: -1.5px;
      text-wrap: balance;
    }
    @media (max-width: 700px) {
      .hero-title--de :global(br) { display: none; }
    }

    .hero-sub {
      font-size: 18px;
      color: rgba(255,255,255,0.85);
      margin: 1.75rem auto 0;
      max-width: 520px;
      line-height: 1.7;
      font-weight: 400;
      text-shadow: 0 1px 16px rgba(0, 0, 0, 0.6), 0 0 3px rgba(0, 0, 0, 0.3);
    }

    .scroll-hint {
      position: absolute;
      bottom: 42px;
      left: 48px;
      z-index: 10;
      color: rgba(255,255,255,0.7);
    }
    .scroll-hint p { font-size: 12px; letter-spacing: 1px; margin: 0 0 8px; text-transform: uppercase; }
    .scroll-line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,0.8), transparent); }

    /* ---------- WORK ---------- */
    .work-section { background: var(--cream); }

    /* ---------- JOURNAL ---------- */
    .journal-section { background: var(--cream-deep); }
    .journal-all-link {
      display: inline-block;
      margin-top: 1.75rem;
      font-size: 15px;
      font-weight: 700;
      color: var(--forest);
      transition: color 0.2s;
    }
    .journal-all-link:hover { color: var(--terracotta); }

    .work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .work-grid--single {
      grid-template-columns: 1fr;
    }
    .work-grid--single .work-card--lg {
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }

    .work-card {
      position: relative;
      display: block;
      border-radius: 4px;
      overflow: hidden;
      background: var(--cream-deep);
      aspect-ratio: 4 / 5;
    }

    .work-card--lg { grid-row: span 2; aspect-ratio: auto; }

    .work-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .work-card:hover img { transform: scale(1.04); }

    .work-card-info {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 1.5rem;
      background: linear-gradient(180deg, transparent, rgba(20,16,10,0.85) 70%);
      color: #fff;
    }

    .work-card-tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #fff;
      background: var(--forest);
      padding: 4px 10px;
      border-radius: 100px;
      margin-bottom: 0.6rem;
    }
    .work-card-info h3 { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; margin: 0 0 0.35rem; }
    .work-card-info p { font-size: 13px; color: rgba(255,255,255,0.85); margin: 0; line-height: 1.5; }

    .work-card--placeholder { cursor: default; }

    /* ---------- SERVICES ---------- */
    .services-section { background: var(--forest); }
    .services-section .eyebrow { color: var(--terracotta); }
    .services-section .section-title,
    .services-section .section-lead { color: #fff; }
    .services-section .section-lead { color: rgba(255,255,255,0.75); }

    .services-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; }

    .service-block {
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 6px;
      padding: 2.75rem;
    }
    .service-block--primary { background: rgba(193, 102, 62, 0.14); border-color: rgba(193, 102, 62, 0.4); }

    .service-icon { color: var(--terracotta); margin-bottom: 1.5rem; }

    .service-kicker { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; color: rgba(255,255,255,0.55); margin-bottom: 0.75rem; text-transform: uppercase; }

    .service-block h3 { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; color: #fff; margin: 0 0 1rem; }
    .service-block p { font-size: 15px; color: rgba(255,255,255,0.78); line-height: 1.7; margin: 0; }

    /* ---------- TEAM ---------- */
    .team-section { background: var(--cream); }

    .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.75rem; }

    .team-member {
      padding: 2.25rem 1.75rem;
      border-radius: 6px;
      border: 1px solid rgba(43,36,32,0.1);
      background: #fff;
    }

    .team-avatar {
      width: 60px; height: 60px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      background: var(--forest);
      color: var(--terracotta);
      margin-bottom: 1.5rem;
    }

    .team-member h3 { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; margin: 0 0 0.6rem; color: var(--ink); }
    .team-member p { font-size: 14px; color: var(--muted); margin: 0; line-height: 1.65; }

    /* ---------- CONTACT ---------- */
    .contact-section { background: var(--cream-deep); }
    .contact-inner { max-width: 640px; text-align: center; }
    .contact-inner .section-lead { margin-left: auto; margin-right: auto; }

    .contact-form { text-align: left; margin-top: 1rem; }
    .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .cf-field { margin-bottom: 1.1rem; }
    .cf-field label { display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; }
    .cf-field input, .cf-field select, .cf-field textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 4px;
      border: 1px solid rgba(43,36,32,0.2);
      background: #fff;
      font-family: inherit;
      font-size: 14px;
      color: var(--ink);
    }
    .cf-field input:focus, .cf-field select:focus, .cf-field textarea:focus {
      outline: none; border-color: var(--terracotta);
    }
    .cf-honeypot { position: absolute; left: -9999px; }

    .cf-submit {
      width: 100%;
      background: var(--terracotta);
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 4px;
      font-size: 15px;
      font-weight: 600;
      margin-top: 0.5rem;
    }
    .cf-submit:hover { background: var(--terracotta-deep); }
    .cf-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    .cf-status { margin-top: 1rem; font-size: 14px; text-align: center; min-height: 20px; }
    .cf-status.success { color: var(--forest); }
    .cf-status.error { color: #a4302f; }

    /* ---------- FOOTER ---------- */
    .footer { background: var(--forest-deep); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0 0 1rem; max-width: 300px; }
    .footer-brand h4 { font-size: 11px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: rgba(255,255,255,0.5); margin: 1.5rem 0 0.5rem; }
    .footer-note-text { font-size: 13px; color: rgba(255,255,255,0.55); max-width: 280px; }
    .footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .footer-col a, .footer-col .footer-note { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .footer-col a:hover { color: var(--terracotta); }
    .footer-note { font-size: 12px; color: rgba(255,255,255,0.4); }
    .footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .work-grid { grid-template-columns: 1fr 1fr; }
      .work-card--lg { grid-column: span 2; aspect-ratio: 16/10; grid-row: auto; }
      .services-grid { grid-template-columns: 1fr; }
      .cf-row { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    /* The full nav needs ~1000px in English and ~1070px in German; below that the
       header switches to the menu button instead of wrapping the logo and CTA. */
    @media (max-width: 1000px) {
      .desktop-nav, .header-cta { display: none; }
      .menu-toggle { display: flex; }
    }
    @media (max-width: 1080px) {
      .site-header--de .desktop-nav, .site-header--de .header-cta { display: none; }
      .site-header--de .menu-toggle { display: flex; }
    }

    /* Phones: the language switch now sits next to the menu button, so trim the
       header padding to keep the logo on one line. */
    @media (max-width: 560px) {
      .site-header, .site-header.scrolled { padding-left: 1.25rem; padding-right: 1.25rem; }
    }
    @media (max-width: 380px) {
      .brand { font-size: 16px; gap: 8px; }
      .brand img { width: 28px; height: 28px; }
      .header-actions { gap: 0.75rem; }
    }

    @media (max-width: 560px) {
      .work-grid { grid-template-columns: 1fr; }
      .work-card--lg { grid-column: auto; }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    // Header scroll state
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      if (!header) return;
      header.classList.toggle('scrolled', window.scrollY > 40);
    });

    // Hero background slideshow: crossfades through the photos, no controls.
    (() => {
      const slides = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
      const hero = document.querySelector('.hero');
      if (slides.length < 2 || !hero) return;
      // People who ask their system for less motion just get the first photo.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const HOLD_MS = 7000; // how long a photo stays before the next one fades in
      const FADE_MS = 2200; // keep in sync with the CSS transition
      let current = 0;
      let heroInView = true;
      let timer: number | undefined;

      // Photos after the first are only requested once the page has loaded, one ahead of
      // the slide being shown, and are decoded before they are faded in so the crossfade
      // never stalls on a big image. Resolves false if a photo fails to load.
      function ready(slide: HTMLElement): Promise<boolean> {
        const img = slide.querySelector('img');
        if (!img) return Promise.resolve(false);
        if (!img.getAttribute('src') && img.dataset.src) {
          if (img.dataset.srcset) img.srcset = img.dataset.srcset;
          img.src = img.dataset.src;
        }
        return img
          .decode()
          .then(() => true)
          .catch(() => img.complete && img.naturalWidth > 0);
      }

      function show(next: number) {
        const prev = slides[current];
        prev.classList.remove('is-active');
        prev.classList.add('is-prev'); // stays opaque underneath while the new photo fades in
        slides[next].classList.add('is-active');
        window.setTimeout(() => prev.classList.remove('is-prev'), FADE_MS + 100);
        current = next;
        void ready(slides[(next + 1) % slides.length]); // start loading the one after
      }

      async function advance() {
        for (let step = 1; step < slides.length; step++) {
          const next = (current + step) % slides.length;
          if (await ready(slides[next])) {
            show(next);
            return;
          }
        }
      }

      function schedule() {
        window.clearTimeout(timer);
        timer = window.setTimeout(async () => {
          // Idle while the tab is in the background or the hero is scrolled out of view.
          if (!document.hidden && heroInView) await advance();
          schedule();
        }, HOLD_MS);
      }

      new IntersectionObserver(([entry]) => { heroInView = entry.isIntersecting; }, { threshold: 0.05 }).observe(hero);

      const start = () => {
        void ready(slides[1]);
        schedule();
      };
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    })();

    // Mobile menu
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    menuToggle?.addEventListener('click', () => mobileMenu?.classList.add('open'));
    mobileMenuClose?.addEventListener('click', () => mobileMenu?.classList.remove('open'));
    mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => mobileMenu.classList.remove('open')));

    // Contact form (Web3Forms)
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('cf-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('.cf-submit') as HTMLButtonElement | null;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = form.dataset.sending || 'Sending…'; }
      if (status) { status.textContent = ''; status.className = 'cf-status'; }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (data.success) {
          if (status) { status.textContent = form.dataset.ok || "Thanks — we'll get back to you soon."; status.className = 'cf-status success'; }
          form.reset();
        } else {
          throw new Error(data.message || 'Something went wrong.');
        }
      } catch (err) {
        if (status) { status.textContent = form.dataset.error || 'Something went wrong. Please email us directly instead.'; status.className = 'cf-status error'; }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = form.dataset.send || 'Send message'; }
      }
    });
  </script>

</Layout>
