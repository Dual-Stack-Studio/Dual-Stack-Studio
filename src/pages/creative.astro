  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.cas-reveal');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        els.forEach(function (e) { e.classList.add('in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach(function (e) { io.observe(e); });
    })();
  </script>

  <style>
    :root {
      --cream: #fffdf9;
      --cream-deep: #fbf8f3;
      --beige: #efe6d4;
      --forest: #2f4436;
      --forest-deep: #223226;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --muted: #6b6156;
    }

    .section-inner {
      max-width: 1180px;
      margin: 0 auto;
      padding: 0 1.75rem;
    }

    .eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--terracotta-deep);
      margin-bottom: 0.75rem;
    }

    .section-title {
      font-size: clamp(30px, 4.2vw, 46px);
      font-weight: 600;
      letter-spacing: -1px;
      color: var(--ink);
      margin: 0 0 0.9rem;
      line-height: 1.08;
    }

    .section-lead {
      font-size: 17px;
      color: var(--muted);
      max-width: 560px;
      margin: 0 0 3rem;
      line-height: 1.65;
    }

    .section { padding: 6rem 0; }
    .section + .section { border-top: 1px solid rgba(43, 36, 32, 0.07); }

    /* ---------- HERO ---------- */
    .hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      background: var(--forest-deep);
    }

    /* Background slideshow. The incoming photo fades in on top of the outgoing one
       (which stays fully opaque underneath), so the picture never dips to the
       dark background mid-fade. Photos fill the hero edge to edge. */
    .hero-slides {
      position: absolute;
      inset: 0;
      overflow: hidden;
      isolation: isolate;
    }

    .hero-slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      z-index: 0;
      transition: opacity 2.2s ease-in-out;
    }
    .hero-slide.is-prev { opacity: 1; z-index: 1; transition: none; }
    .hero-slide.is-active { opacity: 1; z-index: 2; }

    /* Ken Burns: each photo slowly zooms in while it's on screen, so the hero feels alive
       rather than static. Keyed off .is-active, so it restarts fresh every time a slide
       comes back around in the loop. Also applied to .is-prev — same animation shorthand,
       so the browser keeps it running seamlessly through the crossfade instead of snapping
       back to scale(1) the instant a slide stops being the active one. */
    @keyframes heroKenBurns {
      from { transform: scale(1); }
      to   { transform: scale(1.08); }
    }
    @media (prefers-reduced-motion: no-preference) {
      .hero-slide.is-active, .hero-slide.is-prev { animation: heroKenBurns 9s ease-out forwards; }
    }

    .hero-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: var(--pos, 50% 50%);
    }
    .hero-slide picture { display: contents; }

    /* Two photo sets: landscape windows get the wide photos, portrait windows (phones,
       portrait tablets) get the tall ones. The first slide belongs to both. */
    .hero-slide--first { --pos: var(--pos-wide); --dim: var(--dim-wide); }
    .hero-slide--tall { display: none; }
    @media (max-aspect-ratio: 1/1) {
      .hero-slide--wide { display: none; }
      .hero-slide--tall { display: block; }
      .hero-slide--first { --pos: var(--pos-tall); --dim: var(--dim-tall); }
    }

    /* Per-photo dimming (--dim) for the brighter shots. */
    .hero-slide::after {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(14, 18, 10, var(--dim, 0));
    }

    .hero-scrim {
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(20, 24, 16, 0.55) 0%, rgba(20, 24, 16, 0.15) 38%, rgba(20, 24, 16, 0.15) 60%, rgba(20, 24, 16, 0.75) 100%);
    }

    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 1.5rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      transition: background 0.3s, padding 0.3s;
    }

    /* keeps the white logo and links readable over the brighter photos */
    .site-header { text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35); }
    .site-header.scrolled, .header-cta { text-shadow: none; }
    .menu-toggle span { box-shadow: 0 1px 6px rgba(0, 0, 0, 0.35); }

    .site-header.scrolled {
      background: rgba(20, 24, 16, 0.72);
      backdrop-filter: blur(8px);
      padding: 1rem 2.5rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'Fraunces', serif;
      font-size: 19px;
      font-weight: 600;
      color: #fff;
    }

    .desktop-nav a, .header-cta { white-space: nowrap; }
    @media (min-width: 1216px) { .brand { white-space: nowrap; } }
    .desktop-nav { display: flex; gap: 2.25rem; font-size: 14px; font-weight: 500; }
    @media (max-width: 1400px) { .desktop-nav { gap: 1.5rem; } }
    .desktop-nav a { color: rgba(255,255,255,0.9); }
    .desktop-nav a:hover { color: var(--terracotta); }
    .desktop-nav a.nav-dept {
      border: 1px solid rgba(255,255,255,0.35);
      padding: 6px 14px;
      border-radius: 100px;
      font-size: 13px;
      transition: border-color 0.2s, color 0.2s;
    }
    .desktop-nav a.nav-dept:hover { border-color: var(--terracotta); color: var(--terracotta); }

    .header-actions { display: flex; align-items: center; gap: 1.25rem; }
    .header-actions :global(.lang-switch) { color: #fff; }

    .header-cta {
      background: var(--terracotta);
      color: #fff;
      padding: 12px 26px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .header-cta:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    .menu-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      padding: 6px;
    }
    .menu-toggle span { width: 22px; height: 2px; background: #fff; border-radius: 2px; }

    .mobile-menu {
      position: fixed;
      inset: 0;
      background: var(--forest-deep);
      z-index: 200;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
    }
    .mobile-menu.open { display: flex; }
    .mobile-nav-link { font-family: 'Fraunces', serif; font-size: 28px; color: #fff; }
    .mobile-cta { margin-top: 1rem; background: var(--terracotta); color: #fff; padding: 14px 32px; border-radius: 100px; font-weight: 600; }
    .mobile-menu-close { position: absolute; top: 2rem; right: 2rem; background: none; border: none; color: #fff; font-size: 24px; }

    .hero-content {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 900px;
      padding: 2rem 1.5rem;
      text-align: center;
    }

    .hero-title {
      font-size: clamp(40px, 8vw, 84px);
      font-weight: 600;
      letter-spacing: -2px;
      line-height: 1.08;
      color: #fff;
      margin: 0;
      text-shadow: 0 2px 30px rgba(0, 0, 0, 0.45), 0 0 3px rgba(0, 0, 0, 0.2);
    }

    /* The German headline has longer lines than the English one, so it gets a
       smaller cap and a wider box; on phones the forced breaks are dropped and
       the text balances itself. */
    .hero-content--de { max-width: 1100px; }
    .hero-title--de {
      font-size: clamp(32px, 5.4vw, 60px);
      letter-spacing: -1.5px;
      text-wrap: balance;
    }
    @media (max-width: 700px) {
      .hero-title--de :global(br) { display: none; }
    }

    .hero-sub {
      font-size: 18px;
      color: rgba(255,255,255,0.85);
      margin: 1.75rem auto 0;
      max-width: 520px;
      line-height: 1.7;
      font-weight: 400;
      text-shadow: 0 1px 16px rgba(0, 0, 0, 0.6), 0 0 3px rgba(0, 0, 0, 0.3);
    }

    .scroll-hint {
      position: absolute;
      bottom: 42px;
      left: 48px;
      z-index: 10;
      color: rgba(255,255,255,0.7);
    }
    .scroll-hint p { font-size: 12px; letter-spacing: 1px; margin: 0 0 8px; text-transform: uppercase; }
    .scroll-line { width: 1px; height: 38px; background: linear-gradient(180deg, rgba(255,255,255,0.8), transparent); }

    /* ---------- WORK ---------- */
    .work-section { background: var(--cream); }

    /* ---------- JOURNAL ---------- */
    .journal-section { background: var(--cream); }
    .photo-section { background: var(--cream-deep); }
    .journal-all-link {
      display: inline-block;
      margin-top: 1.75rem;
      font-size: 15px;
      font-weight: 700;
      color: var(--forest);
      transition: color 0.2s;
    }
    .journal-all-link:hover { color: var(--terracotta); }

    .work-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 1.5rem;
    }

    .work-grid--single {
      grid-template-columns: 1fr;
    }
    .work-grid--single .work-card--lg {
      grid-row: auto;
      aspect-ratio: 16 / 9;
    }

    .work-card {
      position: relative;
      display: block;
      border-radius: 4px;
      overflow: hidden;
      background: var(--cream-deep);
      aspect-ratio: 4 / 5;
    }

    .work-card--lg { grid-row: span 2; aspect-ratio: auto; }

    .work-card img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
    }
    .work-card:hover img { transform: scale(1.04); }

    .work-card-info {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      padding: 1.5rem;
      background: linear-gradient(180deg, transparent, rgba(20,16,10,0.85) 70%);
      color: #fff;
    }

    .work-card-tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #fff;
      background: var(--forest);
      padding: 4px 10px;
      border-radius: 100px;
      margin-bottom: 0.6rem;
    }
    .work-card-info h3 { font-family: 'Fraunces', serif; font-size: 22px; font-weight: 600; margin: 0 0 0.35rem; }
    .work-card-info p { font-size: 13px; color: rgba(255,255,255,0.85); margin: 0; line-height: 1.5; }

    .work-card--placeholder { cursor: default; }

    /* ---------- SERVICES ---------- */
    .services-section { background: var(--cream-deep); }

    /* card colours follow the logo: green, orange, beige */
    .tone-green {
      --card-bg: var(--forest); --card-ink: #fff; --card-soft: rgba(255,255,255,0.84); --card-faint: rgba(255,255,255,0.62);
      --card-accent: #f0a47a; --card-line: rgba(240,164,122,0.45); --card-icon: var(--terracotta);
      --pill-bg: rgba(255,255,255,0.08); --pill-bd: rgba(255,255,255,0.2); --pill-ink: #a8d9b8; --pill-ink-local: #f0c9a8;
      --avatar-bg: var(--terracotta); --avatar-ink: #fff; --tag-bg: #b95c35; --tag-ink: #fff;
    }
    .tone-orange {
      --card-bg: #b95c35; --card-ink: #fff; --card-soft: #fff; --card-faint: #fff;
      --card-accent: #fff; --card-line: rgba(255,255,255,0.55); --card-icon: #fff;
      --pill-bg: rgba(40,16,6,0.24); --pill-bd: rgba(255,255,255,0.4); --pill-ink: #fff; --pill-ink-local: #fff;
      --avatar-bg: rgba(40,16,6,0.22); --avatar-ink: #fff; --tag-bg: #fff; --tag-ink: #a4522f;
    }
    .tone-beige {
      --card-bg: var(--beige); --card-ink: var(--ink); --card-soft: rgba(43,36,32,0.84); --card-faint: rgba(43,36,32,0.74);
      --card-accent: var(--terracotta-deep); --card-line: rgba(164,82,47,0.45); --card-icon: var(--terracotta-deep);
      --pill-bg: rgba(47,68,54,0.08); --pill-bd: rgba(47,68,54,0.24); --pill-ink: var(--forest); --pill-ink-local: var(--terracotta-deep);
      --avatar-bg: var(--forest); --avatar-ink: var(--terracotta); --tag-bg: var(--forest); --tag-ink: #fff;
    }

    .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }

    .service-block {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      background: var(--card-bg);
      border-radius: 10px;
      padding: 2.75rem;
      box-shadow: 0 22px 44px -28px rgba(34,24,16,0.5);
    }

    .service-icon { color: var(--card-icon); margin-bottom: 1.5rem; }

    .service-kicker { display: block; font-size: 12px; font-weight: 600; letter-spacing: 0.5px; color: var(--card-faint); margin-bottom: 0.75rem; text-transform: uppercase; }

    .service-block h3 { font-family: 'Fraunces', serif; font-size: 28px; font-weight: 600; color: var(--card-ink); margin: 0 0 1rem; }
    .service-block p { font-size: 15px; color: var(--card-soft); line-height: 1.7; margin: 0 0 1.25rem; }
    .service-checklist {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 1rem;
      margin-bottom: 1.5rem;
    }
    .service-checklist span { font-size: 12.5px; color: var(--card-soft); }
    .service-location {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-size: 12px; font-weight: 600; letter-spacing: 0.3px;
      color: var(--pill-ink);
      background: var(--pill-bg);
      border: 1px solid var(--pill-bd);
      border-radius: 100px;
      padding: 0.4rem 0.85rem;
      margin-top: auto;
    }
    .service-location svg { flex-shrink: 0; }
    .service-location--local { color: var(--pill-ink-local); }

    /* ---------- TEAM ---------- */
    .team-section { background: var(--cream); }

    .team-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.75rem; }

    .team-member {
      padding: 2.25rem 1.75rem;
      border-radius: 10px;
      background: var(--card-bg);
      box-shadow: 0 22px 44px -28px rgba(34,24,16,0.5);
    }

    .team-avatar {
      width: 60px; height: 60px;
      border-radius: 12px;
      display: flex; align-items: center; justify-content: center;
      background: var(--avatar-bg);
      color: var(--avatar-ink);
      margin-bottom: 1.5rem;
    }

    .team-about { display: inline-block; margin-top: 2.5rem; padding: 13px 28px; border-radius: 100px; border: 1px solid var(--terracotta); color: var(--terracotta-deep); font-size: 14px; font-weight: 600; transition: background 0.2s, color 0.2s, transform 0.2s; }
    .team-about:hover { background: var(--terracotta); color: #fff; transform: translateY(-1px); }
    .team-member h3 { font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; margin: 0 0 0.6rem; color: var(--card-ink); }
    .team-member p { font-size: 14px; color: var(--card-soft); margin: 0; line-height: 1.65; }

    /* ---------- CASCADE: steps down and to the right, same as the About page ---------- */
    .cas { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.1rem; align-items: start; margin-top: 3rem; padding-bottom: 0.5rem; }
    .cas-item { grid-column: var(--c) / span 4; grid-row: 1; margin: calc(var(--k) * 3.2rem) 0 0 -2rem; position: relative; z-index: var(--n); }
    .cas-first { margin-left: 0; }
    .cas-ph { display: block; overflow: hidden; box-sizing: border-box; border: 5px solid #fff; border-radius: 10px; background: var(--forest-deep); box-shadow: 0 22px 44px -22px rgba(34,24,16,0.6); }
    .cas-r43 { aspect-ratio: 4 / 3; }
    .cas-r34 { aspect-ratio: 3 / 4; }
    .cas-ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
    .cas-ph:hover img { transform: scale(1.035); }
    .cas-cap { position: absolute; left: 0.7rem; top: 0.7rem; font-size: 10.5px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: #fff; background: rgba(20,24,16,0.55); backdrop-filter: blur(4px); padding: 4px 10px; border-radius: 999px; }
    .cas-panel { display: block; color: var(--card-ink); background: var(--card-bg); border-radius: 10px; padding: 1.7rem 1.6rem 1.8rem; box-shadow: 0 22px 44px -22px rgba(34,24,16,0.6); }
    .cas-tag { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: var(--tag-ink); background: var(--tag-bg); padding: 4px 10px; border-radius: 100px; margin-bottom: 0.9rem; }
    .cas-panel h3 { font-family: 'Fraunces', serif; font-size: 24px; font-weight: 600; line-height: 1.2; margin: 0 0 0.6rem; }
    .cas-panel p { font-size: 14px; line-height: 1.6; color: var(--card-soft); margin: 0 0 1.1rem; }
    .cas-go { font-size: 14px; font-weight: 700; color: var(--card-accent); border-bottom: 1px solid var(--card-line); padding-bottom: 2px; transition: color 0.2s, border-color 0.2s; }
    .cas-panel:hover .cas-go { color: var(--card-ink); border-color: var(--card-ink); }

    /* services and team: the three cards take one step each */
    @media (min-width: 901px) {
      .services-grid, .team-grid { align-items: start; }
      .cas-step { margin-top: calc(var(--k) * 2.6rem); }
    }

    /* entry: each piece drifts in from the left and settles, one step after the other */
    :global(.cas-js) .cas-reveal { opacity: 0; transform: translateY(26px); transition: opacity 0.8s ease, transform 0.8s cubic-bezier(.2,.7,.2,1); transition-delay: calc(var(--k, 0) * 120ms); }
    :global(.cas-js) .cas-reveal.in { opacity: 1; transform: none; }
    :global(.cas-js) .cas .cas-item.cas-reveal, :global(.cas-js) .cas-step.cas-reveal { transform: translate(-34px, 30px); }
    :global(.cas-js) .cas .cas-item.cas-reveal.in, :global(.cas-js) .cas-step.cas-reveal.in { transform: none; }
    @media (prefers-reduced-motion: reduce) {
      :global(.cas-js) .cas-reveal, :global(.cas-js) .cas .cas-item.cas-reveal, :global(.cas-js) .cas-step.cas-reveal { opacity: 1; transform: none; transition: none; }
    }
    @media (max-width: 960px) {
      .cas { column-gap: 0.8rem; }
      .cas-item { margin-top: calc(var(--k) * 2.2rem); margin-left: -1.4rem; }
      .cas-first { margin-left: 0; }
    }
    /* small screens: a gentler zigzag instead of the full cascade */
    @media (max-width: 720px) {
      .cas { display: flex; flex-direction: column; margin-top: 2.2rem; padding-bottom: 1.6rem; }
      .cas .cas-item { width: 76%; margin: 0 0 -1.6rem 0; }
      .cas .cas-item:nth-child(odd) { align-self: flex-start; }
      .cas .cas-item:nth-child(even) { align-self: flex-end; }
      .cas .cas-item.cas-panel { align-self: stretch; width: auto; margin: 2.6rem 0 0; }
      :global(.cas-js) .cas .cas-item.cas-reveal:nth-child(even) { transform: translate(34px, 30px); }
      :global(.cas-js) .cas .cas-item.cas-reveal.in, :global(.cas-js) .cas .cas-item.cas-reveal.in:nth-child(even) { transform: none; }
    }

    /* ---------- CONTACT ---------- */
    .contact-section { background: var(--cream-deep); }
    .contact-inner { max-width: 640px; text-align: center; }
    .contact-inner .section-lead { margin-left: auto; margin-right: auto; }

    .contact-form { text-align: left; margin-top: 1rem; }
    .cf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .cf-field { margin-bottom: 1.1rem; }
    .cf-field label { display: block; font-size: 13px; font-weight: 600; color: var(--ink); margin-bottom: 0.4rem; }
    .cf-field input, .cf-field select, .cf-field textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 4px;
      border: 1px solid rgba(43,36,32,0.2);
      background: #fff;
      font-family: inherit;
      font-size: 14px;
      color: var(--ink);
    }
    .cf-field input:focus, .cf-field select:focus, .cf-field textarea:focus {
      outline: none; border-color: var(--terracotta);
    }
    .cf-field.cf-error input, .cf-field.cf-error textarea { border-color: #d64545; }
    .cf-honeypot { position: absolute; left: -9999px; }

    .cf-submit {
      width: 100%;
      background: var(--terracotta);
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 4px;
      font-size: 15px;
      font-weight: 600;
      margin-top: 0.5rem;
    }
    .cf-submit:hover { background: var(--terracotta-deep); }
    .cf-submit:disabled { opacity: 0.6; cursor: not-allowed; }

    .cf-status { margin-top: 1rem; font-size: 14px; text-align: center; min-height: 20px; }
    .cf-status.success { color: var(--forest); }
    .cf-status.error { color: #a4302f; }

    /* ---------- FOOTER ---------- */
    .footer { background: var(--forest-deep); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; }
    .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0 0 1rem; max-width: 300px; }
    .footer-brand h4 { font-size: 11px; font-weight: 700; letter-spacing: 0.8px; text-transform: uppercase; color: rgba(255,255,255,0.5); margin: 1.5rem 0 0.5rem; }
    .footer-note-text { font-size: 13px; color: rgba(255,255,255,0.55); max-width: 280px; }
    .footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .footer-col a, .footer-col .footer-note { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .footer-col a:hover { color: var(--terracotta); }
    .footer-note { font-size: 12px; color: rgba(255,255,255,0.4); }
    .footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .work-grid { grid-template-columns: 1fr 1fr; }
      .work-card--lg { grid-column: span 2; aspect-ratio: 16/10; grid-row: auto; }
      .services-grid { grid-template-columns: 1fr; }
      .cf-row { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr 1fr; }
    }

    /* With seven links the full nav needs ~1215px in English and ~1270px in German and Spanish
       (measured with the tighter 1.5rem gap); below that the header switches to the menu button
       instead of overlapping the logo and CTA. */
    @media (max-width: 1215px) {
      .desktop-nav, .header-cta { display: none; }
      .menu-toggle { display: flex; }
    }
    @media (max-width: 1270px) {
      .site-header--de .desktop-nav, .site-header--de .header-cta { display: none; }
      .site-header--de .menu-toggle { display: flex; }
    }

    /* Phones: the language switch now sits next to the menu button, so trim the
       header padding to keep the logo on one line. */
    @media (max-width: 560px) {
      .site-header, .site-header.scrolled { padding-left: 1.25rem; padding-right: 1.25rem; }
    }
    @media (max-width: 380px) {
      .brand { font-size: 16px; gap: 8px; }
      .brand img { width: 28px; height: 28px; }
      .header-actions { gap: 0.75rem; }
    }

    @media (max-width: 560px) {
      .work-grid { grid-template-columns: 1fr; }
      .work-card--lg { grid-column: auto; }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    // Header scroll state
    const header = document.getElementById('site-header');
    window.addEventListener('scroll', () => {
      if (!header) return;
      header.classList.toggle('scrolled', window.scrollY > 40);
    });

    // Hero background slideshow: crossfades through the photos, no controls.
    (() => {
      const all = Array.from(document.querySelectorAll<HTMLElement>('.hero-slide'));
      const first = all.find((s) => s.classList.contains('hero-slide--first'));
      const hero = document.querySelector('.hero');
      if (all.length < 2 || !first || !hero) return;
      // People who ask their system for less motion just get the first photo.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const HOLD_MS = 7000; // how long a photo stays before the next one fades in
      const FADE_MS = 2200; // keep in sync with the CSS transition

      // The photo set follows the window shape (same query as the CSS): portrait windows
      // rotate the tall photos, everything else the wide ones. The first slide is in both.
      const tall = window.matchMedia('(max-aspect-ratio: 1/1)');
      const setFor = () => all.filter((s) => s === first || s.classList.contains(tall.matches ? 'hero-slide--tall' : 'hero-slide--wide'));
      let slides = setFor();
      let current = 0;
      let heroInView = true;
      let timer: number | undefined;

      // Photos after the first are only requested once the page has loaded, one ahead of
      // the slide being shown, and are decoded before they are faded in so the crossfade
      // never stalls on a big image. Resolves false if a photo fails to load.
      function ready(slide: HTMLElement): Promise<boolean> {
        const img = slide.querySelector('img');
        if (!img) return Promise.resolve(false);
        if (!img.getAttribute('src') && img.dataset.src) {
          if (img.dataset.srcset) img.srcset = img.dataset.srcset;
          img.src = img.dataset.src;
        }
        return img
          .decode()
          .then(() => true)
          .catch(() => img.complete && img.naturalWidth > 0);
      }

      function show(next: number) {
        const prev = slides[current];
        prev.classList.remove('is-active');
        prev.classList.add('is-prev'); // stays opaque underneath while the new photo fades in
        slides[next].classList.add('is-active');
        window.setTimeout(() => prev.classList.remove('is-prev'), FADE_MS + 100);
        current = next;
        void ready(slides[(next + 1) % slides.length]); // start loading the one after
      }

      async function advance() {
        for (let step = 1; step < slides.length; step++) {
          const next = (current + step) % slides.length;
          if (await ready(slides[next])) {
            show(next);
            return;
          }
        }
      }

      function schedule() {
        window.clearTimeout(timer);
        timer = window.setTimeout(async () => {
          // Idle while the tab is in the background or the hero is scrolled out of view.
          if (!document.hidden && heroInView) await advance();
          schedule();
        }, HOLD_MS);
      }

      // Rotating the phone (or resizing across the portrait/landscape line) swaps the set:
      // start over from the shared first slide.
      tall.addEventListener('change', () => {
        all.forEach((s) => s.classList.remove('is-active', 'is-prev'));
        first.classList.add('is-active');
        slides = setFor();
        current = 0;
        void ready(slides[1]);
        schedule();
      });

      new IntersectionObserver(([entry]) => { heroInView = entry.isIntersecting; }, { threshold: 0.05 }).observe(hero);

      const start = () => {
        void ready(slides[1]);
        schedule();
      };
      if (document.readyState === 'complete') start();
      else window.addEventListener('load', start, { once: true });
    })();

    // Mobile menu
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    menuToggle?.addEventListener('click', () => mobileMenu?.classList.add('open'));
    mobileMenuClose?.addEventListener('click', () => mobileMenu?.classList.remove('open'));
    mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => mobileMenu.classList.remove('open')));

    // Contact form (Web3Forms)
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('cf-status');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const name = (form.querySelector('#cf-name') as HTMLInputElement).value.trim();
      const email = (form.querySelector('#cf-email') as HTMLInputElement).value.trim();
      const location = (form.querySelector('#cf-location') as HTMLInputElement).value.trim();
      const message = (form.querySelector('#cf-message') as HTMLTextAreaElement).value.trim();
      const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      let firstInvalid: Element | null = null;

      ([
        [form.querySelector('#cf-name')!.closest('.cf-field')!, !!name],
        [form.querySelector('#cf-email')!.closest('.cf-field')!, emailValid],
        [form.querySelector('#cf-location')!.closest('.cf-field')!, !!location],
        [form.querySelector('#cf-message')!.closest('.cf-field')!, !!message],
      ] as [Element, boolean][]).forEach(([field, isValid]) => {
        field.classList.toggle('cf-error', !isValid);
        if (!isValid && !firstInvalid) firstInvalid = field;
      });

      if (firstInvalid) {
        (firstInvalid as Element).querySelector<HTMLElement>('input, textarea')?.focus();
        return;
      }

      const submitBtn = form.querySelector('.cf-submit') as HTMLButtonElement | null;
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = form.dataset.sending || 'Sending…'; }
      if (status) { status.textContent = ''; status.className = 'cf-status'; }
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await res.json();
        if (data.success) {
          if (status) { status.textContent = form.dataset.ok || "Thank you — your message arrived. A reply follows soon."; status.className = 'cf-status success'; }
          form.reset();
        } else {
          throw new Error(data.message || 'Something went wrong.');
        }
      } catch (err) {
        if (status) { status.textContent = form.dataset.error || 'Something went wrong. Please send an email directly instead.'; status.className = 'cf-status error'; }
      } finally {
        if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = form.dataset.send || 'Send message'; }
      }
    });

    form?.querySelectorAll('input, textarea').forEach((el) => {
      el.addEventListener('input', () => {
        el.closest('.cf-field')?.classList.remove('cf-error');
      });
    });
  </script>

</Layout>
