<Layout title="Dual-Stack Studio — We build full-stack products">

  <!-- Hero Section (visualidentity.studio-style: gray vignette, giant black wordmark, lime accent, rotating 3D glass asterisk) -->
  <section style="position: relative; min-height: 100vh; padding-top: 90px; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at 85% 88%, rgba(204, 255, 51, 0.16) 0%, transparent 45%), radial-gradient(circle at 8% 15%, rgba(204, 255, 51, 0.08) 0%, transparent 35%), radial-gradient(ellipse 140% 120% at 50% 0%, #8c8c8c 0%, #5c5c5c 50%, #242424 78%, #0a0a0a 100%); overflow: hidden; border-bottom: 2px solid #242424;">

    <!-- Header -->
    <header id="site-header" style="position: fixed; top: 0; left: 0; width: 100%; padding: 1.5rem 3rem; display: flex; justify-content: space-between; align-items: center; z-index: 100; transition: background 0.3s, box-shadow 0.3s, padding 0.3s;">
      <a href="/" style="font-size: 22px; font-weight: 800; letter-spacing: -0.5px; cursor: pointer; display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <img src="/logo.svg" alt="Dual-Stack Studio" width="32" height="32" style="border-radius: 8px;" />
        <span class="logo-text">Dual-Stack</span>
      </a>
      <nav class="desktop-nav" style="display: flex; gap: 2.25rem; font-size: 14px; font-weight: 500;">
        <a href="#work" class="nav-link">Projects</a>
        <a href="#services" class="nav-link">Services</a>
        <a href="#team" class="nav-link">Team</a>
      </nav>
      <a href="#contact" class="header-cta" style="background: #ccff33; color: #0a0a0a; padding: 14px 32px; border-radius: 100px; text-decoration: none; font-size: 14px; font-weight: 600; box-shadow: 0 8px 24px rgba(204, 255, 51, 0.35); transition: transform 0.2s;">
        Get proposal
      </a>
      <button id="menu-toggle" class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
        <span class="menu-toggle-bar"></span>
      </button>
    </header>

    <!-- Mobile menu overlay -->
    <div id="mobile-menu" class="mobile-menu">
      <button id="mobile-menu-close" class="mobile-menu-close" aria-label="Close menu">✕</button>
      <a href="#work" class="mobile-nav-link">Projects</a>
      <a href="#services" class="mobile-nav-link">Services</a>
      <a href="#team" class="mobile-nav-link">Team</a>
      <a href="#contact" class="mobile-cta">Get proposal</a>
    </div>

    <!-- Status badge, vertical, left edge -->
   

    <!-- Sparse full-hero particle network, ambient constellation -->
    <canvas id="hero-network-full" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1;"></canvas>

    <!-- Main Content (pointer-events: none so mouse reaches the network canvases beneath the text) -->
    <div style="position: relative; z-index: 10; width: 100%; max-width: 1300px; padding: 2rem 1.5rem; text-align: center; pointer-events: none;">

      <span style="display: inline-block; font-size: 13px; color: #ccff33; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 1rem;">
        Full-stack development studio
      </span>

      <h1 class="hero-title-shine" style="font-size: clamp(56px, 12vw, 180px); margin: 0; font-weight: 800; letter-spacing: -4px; line-height: 0.88;">
        Dual-Stack<br />Studio
      </h1>

      <p style="position: relative; z-index: 10; font-size: 18px; color: #ccc; margin: 1.5rem auto 0; max-width: 480px; line-height: 1.7; font-weight: 300;">
        From concept to production. React Native, React, Node.js. We ship products that matter.
      </p>

    </div>

    <!-- Scroll indicator, bottom left like the reference -->
    <div style="position: absolute; bottom: 48px; left: 48px; z-index: 10;">
      <p style="font-size: 13px; color: #ccff33; margin: 0 0 10px 0; letter-spacing: 0.5px; font-weight: 500;">Scroll down</p>
      <div style="width: 1px; height: 40px; background: linear-gradient(180deg, #ccff33 0%, transparent 100%); animation: scrollLine 2s infinite;"></div>
    </div>

  </section>

  <style>
    @keyframes pulseDot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
      50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    }

    @keyframes scrollLine {
      0% { transform: scaleY(0); transform-origin: top; opacity: 1; }
      50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
      51% { transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; opacity: 0.3; }
    }

    /* Diagonal lime/gray shine sweeping across the hero title — plays once
       smoothly then holds still; replayed by JS whenever the title scrolls
       back into view (see IntersectionObserver below). */
    .hero-title-shine {
      color: #c8c8c8;
      background-image: linear-gradient(
        115deg,
        #c8c8c8 0%,
        #c8c8c8 38%,
        #9ea88f 46%,
        #ccff33 50%,
        #eaffb0 52%,
        #9ea88f 56%,
        #c8c8c8 64%,
        #c8c8c8 100%
      );
      background-size: 300% 300%;
      background-position: -100% 0%;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    @keyframes heroTitleShine {
      0% { background-position: 200% 0%; }
      100% { background-position: -100% 0%; }
    }

    #site-header.scrolled {
      background: rgba(164, 162, 162, 0.85);
      backdrop-filter: blur(12px);
      box-shadow: 0 1px 0 rgba(0, 0, 0, 0.06);
      padding: 1rem 3rem;
    }

    /* Hamburger button — hidden on desktop */
    .menu-toggle {
      display: none;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
      width: 40px;
      height: 40px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 200;
    }

    .menu-toggle-bar {
      display: block;
      width: 24px;
      height: 2px;
      background: #ebebeb;
      border-radius: 2px;
      transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
    }

    #site-header.scrolled .menu-toggle-bar {
      background: #1a1a1a;
    }

    .menu-toggle.open .menu-toggle-bar:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    .menu-toggle.open .menu-toggle-bar:nth-child(2) {
      opacity: 0;
    }

    .menu-toggle.open .menu-toggle-bar:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile menu overlay */
    .mobile-menu {
      position: fixed;
      inset: 0;
      z-index: 150;
      background: #0a0a0a;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-12px);
      transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
    }

    .mobile-menu.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-nav-link {
      font-size: 28px;
      font-weight: 700;
      color: #eee;
      text-decoration: none;
      letter-spacing: -0.5px;
      transition: color 0.2s;
    }

    .mobile-nav-link:hover {
      color: #ccff33;
    }

    .mobile-cta {
      margin-top: 1rem;
      background: #ccff33;
      color: #0a0a0a;
      padding: 14px 36px;
      border-radius: 100px;
      text-decoration: none;
      font-size: 15px;
      font-weight: 700;
      box-shadow: 0 8px 24px rgba(204, 255, 51, 0.35);
    }

    .mobile-menu-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.15);
      background: rgba(255, 255, 255, 0.04);
      color: #eee;
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
    }

    .mobile-menu-close:hover {
      background: rgba(204, 255, 51, 0.12);
      border-color: rgba(204, 255, 51, 0.4);
      color: #ccff33;
    }

    @media (max-width: 768px) {
      #site-header {
        padding: 1.1rem 1.25rem !important;
      }

      #site-header.scrolled {
        padding: 0.9rem 1.25rem !important;
      }

      .desktop-nav,
      .header-cta {
        display: none !important;
      }

      .menu-toggle {
        display: flex;
      }
    }

  </style>

  <script>
    const header = document.getElementById('site-header');

    // Header picks up a subtle light glass backdrop once scrolled past the hero
    const darkZoneEnd = header.closest('section');
    const headerObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      },
      { threshold: 0 }
    );
    headerObserver.observe(darkZoneEnd);

    // Hero title shine: plays once, then replays each time the title
    // scrolls back into view (e.g. scroll away and back, or a fresh reload).
    const heroTitle = document.querySelector('.hero-title-shine');
    if (heroTitle) {
      function playHeroShine() {
        heroTitle.style.animation = 'none';
        void heroTitle.offsetWidth;
        heroTitle.style.animation = 'heroTitleShine 2.4s ease-in-out 1';
      }
      const shineObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) playHeroShine();
          });
        },
        { threshold: 0.4 }
      );
      shineObserver.observe(heroTitle);
    }

    // Mobile hamburger menu toggle
    const menuToggle = document.getElementById('menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    if (menuToggle && mobileMenu) {
      function closeMobileMenu() {
        menuToggle.classList.remove('open');
        menuToggle.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('open');
        document.body.style.overflow = '';
      }

      menuToggle.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('open');
        menuToggle.classList.toggle('open', isOpen);
        menuToggle.setAttribute('aria-expanded', String(isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
      });

      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeMobileMenu);
      });

      const mobileMenuClose = document.getElementById('mobile-menu-close');
      mobileMenuClose?.addEventListener('click', closeMobileMenu);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu.classList.contains('open')) closeMobileMenu();
      });
    }

    // Two hero-flanking particle networks — same algorithm as the Services canvas (black lines, lime dots, mouse-interactive), just denser
    function initNetworkCluster(canvasId, lineColor) {
      const line = lineColor || '10, 10, 10';
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let particles = [];
      let raf;
      const mouse = { x: -9999, y: -9999 };

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      }

      function initParticles() {
        const count = Math.round((canvas.width * canvas.height) / 70000);
        particles = Array.from({ length: Math.max(16, Math.min(count, 30)) }, () => ({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.2,
          vy: (Math.random() - 0.5) * 0.2,
          r: Math.random() * 1.6 + 1,
        }));
      }

      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });

      canvas.addEventListener('mouseleave', () => {
        mouse.x = -9999;
        mouse.y = -9999;
      });

      function tick() {
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;

          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 90) {
            p.x += (dx / dist) * 0.8;
            p.y += (dy / dist) * 0.8;
          }
        });

        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 320) {
              ctx.strokeStyle = `rgba(${line}, ${(1 - dist / 320) * 0.3})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }

        particles.forEach((p) => {
          const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
          glow.addColorStop(0, 'rgba(204, 255, 51, 0.5)');
          glow.addColorStop(1, 'rgba(204, 255, 51, 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#ccff33';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        });

        raf = requestAnimationFrame(tick);
      }

      resizeCanvas();
      initParticles();
      tick();

      window.addEventListener('resize', () => {
        cancelAnimationFrame(raf);
        resizeCanvas();
        initParticles();
        tick();
      });
    }

    window.initNetworkCluster = initNetworkCluster;

    initNetworkCluster('hero-network-full');
    initNetworkCluster('contact-network', '255, 255, 255');
    initNetworkCluster('footer-network', '255, 255, 255');
  </script>

  <!-- Projects Section (editorial zigzag, big media, no card boxes) -->
  <section id="work" style="position: relative; padding: 8rem 0 4rem; overflow: hidden;">

    <div style="position: absolute; top: 5%; right: -8%; width: 500px; height: 500px; background: radial-gradient(circle, rgba(204, 255, 51, 0.06) 0%, transparent 70%); pointer-events: none;"></div>
    <div style="position: absolute; bottom: 10%; left: -10%; width: 450px; height: 450px; background: radial-gradient(circle, rgba(217, 70, 239, 0.05) 0%, transparent 70%); pointer-events: none;"></div>

    <div style="max-width: 1200px; margin: 0 auto 3.5rem; padding: 0 2rem; position: relative; z-index: 1;">
      <div style="display: flex; align-items: baseline; gap: 1rem;">
        <h2 class="work-heading" style="font-size: 42px; margin: 0; font-weight: 800; letter-spacing: -1.5px;">Our Projects</h2>
        <span class="work-count" style="font-size: 14px; font-weight: 500;">Click on the projects to see more</span>
      </div>
    </div>

    <div class="work-carousel-wrap">
      <div id="work-carousel" class="mdw-curved-slider-speed-16-gap-9-curve-9-size-20">
        <div class="carousel-source">
          <a href="/work/astrofell" data-img="/images/astrofell.png">Astrofell — Astronomy web site</a>
          <a href="/work/bumeran" data-img="/images/bumeran-hero.svg">Bumerán — Neighborhood favor exchange</a>
          <a href="/work/echoesandpaths" data-img="/images/echoesandpaths-hero.png">Echoes &amp; Paths — Historical landmark app</a>
          <a href="/work/nonna" data-img="/images/nonna-logo-hero.jpg">El Dulce de la Nonna — Bakery e-commerce</a>
          <a href="/work/mvg" data-img="/images/mvg-logo-hero.jpg">MVG Lash &amp; Brow — Salon website</a>
        </div>
      </div>
      <p class="work-carousel-hint"><span class="hint-desktop">Hover a project to preview · Click to open</span><span class="hint-mobile">Drag to browse · Tap to open</span></p>
    </div>

  </section>

  <style>
    .eyebrow {
      font-size: 12px;
      font-weight: 700;
      color: #0a0a0a;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .view-all-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 14px;
      font-weight: 600;
      color: #555;
      text-decoration: none;
      transition: color 0.3s, gap 0.3s;
    }

    .view-all-link:hover {
      color: #0a0a0a;
      gap: 0.65rem;
    }

    .view-all-link i {
      font-style: normal;
    }

    #work {
      background:
        radial-gradient(ellipse 120% 90% at 50% 0%, rgba(204, 255, 51, 0.1) 0%, transparent 60%),
        #d8d8d8;
    }

    .work-heading {
      color: #0a0a0a;
    }

    .work-count {
      color: #666;
    }

    .work-eyebrow {
      color: #6b7a1e;
    }

    .work-carousel-wrap {
      position: relative;
      height: var(--min-height, 58vh);
      --min-height: 58vh;
    }

    [class^='mdw-curved-slider'] {
      position: absolute;
      top: -32px;
      bottom: -56px;
      left: 0;
      right: 0;
      width: 100%;
      cursor: pointer;
      touch-action: pan-y;
      background:
        radial-gradient(ellipse 90% 90% at 50% 50%, rgba(204, 255, 51, 0.1) 0%, transparent 60%),
        #d8d8d8;
    }

    [class^='mdw-curved-slider'] canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    .carousel-source {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .work-carousel-hint {
      text-align: center;
      margin: 1.75rem 0 0;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.5px;
      color: #999;
    }

    .work-carousel-hint .hint-mobile {
      display: none;
    }

    @media (max-width: 800px) {
      .work-carousel-wrap {
        --min-height: 36vh;
      }

      .work-carousel-hint .hint-desktop {
        display: none;
      }

      .work-carousel-hint .hint-mobile {
        display: inline;
      }
    }
  </style>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js" is:inline></script>

  <script>
    addEventListener('DOMContentLoaded', function () {
      const el = document.getElementById('work-carousel');
      if (!el || typeof THREE === 'undefined') return;

      const className = el.getAttribute('class') ?? '';
      const parts = className.split('-');
      const options = { speed: 16, gap: 9, curve: 9, size: 17, direction: -1 };
      parts.forEach((value, i) => {
        const next = parts[i + 1];
        if (value === 'speed' && next) options.speed = Number(next);
        if (value === 'gap' && next) options.gap = Number(next);
        if (value === 'curve' && next) options.curve = Number(next);
        if (value === 'size' && next) options.size = Number(next);
        if (value === 'reverse') options.direction = 1;
      });

      const getGapWidth = (gap) => 1 + gap / 100;
      const getPixelsPerUnit = (container, camera) => {
        const vFov = (camera.fov * Math.PI) / 180;
        const height = 2 * Math.tan(vFov / 2) * camera.position.z;
        const width = height * (container.clientWidth / container.clientHeight);
        return container.clientWidth / width;
      };

      const planeWidth = options.size / 10;
      const planeHeight = planeWidth * 0.625;

      const links = Array.from(el.querySelectorAll('.carousel-source a'));
      const baseImages = links.map((a) => a.getAttribute('data-img'));
      const baseHrefs = links.map((a) => a.getAttribute('href'));
      const slideCount = baseImages.length;

      let scene, camera, renderer, raycaster, mouseNDC, planes, pxPerUnit;

      function build() {
        const oldCanvas = el.querySelector('canvas');
        if (oldCanvas) el.removeChild(oldCanvas);

        scene = new THREE.Scene();
        camera = new THREE.PerspectiveCamera(75, el.clientWidth / el.clientHeight, 0.1, 20);
        camera.position.z = 1.9;

        renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        renderer.setSize(el.clientWidth, el.clientHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.domElement.style.position = 'absolute';
        renderer.domElement.style.top = '0';
        renderer.domElement.style.left = '0';
        const edgeMask = 'linear-gradient(to bottom, transparent 0%, black 12%, black 88%, transparent 100%)';
        renderer.domElement.style.maskImage = edgeMask;
        renderer.domElement.style.webkitMaskImage = edgeMask;
        el.appendChild(renderer.domElement);

        pxPerUnit = getPixelsPerUnit(el, camera);
        const planeSpacePx = pxPerUnit * planeWidth * getGapWidth(options.gap);
        const totalImages = Math.ceil(el.clientWidth / planeSpacePx) + 1 + slideCount;
        const initialOffset = Math.ceil(el.clientWidth / (2 * planeSpacePx) - 0.5);

        const images = baseImages.slice();
        const hrefs = baseHrefs.slice();
        for (let i = slideCount; i < totalImages; i++) {
          images.push(baseImages[i % slideCount]);
          hrefs.push(baseHrefs[i % slideCount]);
        }

        const geometry = new THREE.PlaneGeometry(planeWidth, planeHeight, 20, 20);
        planes = new Array(images.length).fill(null);

        images.forEach((src, i) => {
          new THREE.TextureLoader().load(src, (texture) => {
            // The fragment shader below outputs the sampled texel straight to
            // gl_FragColor with no re-encode step, so the texture must stay
            // un-decoded (raw sRGB bytes in, same bytes out) — setting
            // SRGBColorSpace here made Three decode to linear on sample while
            // the canvas still declares sRGB output, silently darkening/
            // desaturating every carousel image (gold read as brown, etc).
            const material = new THREE.ShaderMaterial({
              uniforms: {
                tex: { value: texture },
                curve: { value: options.curve },
              },
              vertexShader: `
                uniform float curve;
                varying vec2 vertexUV;
                void main() {
                  vertexUV = uv;
                  vec3 newPosition = position;
                  float distanceFromCenter = abs((modelMatrix * vec4(position, 1.0)).x);
                  newPosition.y *= 1.0 + (curve / 100.0) * pow(distanceFromCenter, 2.0);
                  gl_Position = projectionMatrix * modelViewMatrix * vec4(newPosition, 1.0);
                }
              `,
              fragmentShader: `
                uniform sampler2D tex;
                varying vec2 vertexUV;
                void main() {
                  gl_FragColor = texture2D(tex, vertexUV);
                }
              `,
            });

            const mesh = new THREE.Mesh(geometry, material);
            mesh.position.x = -1 * options.direction * (i - initialOffset) * planeWidth * getGapWidth(options.gap);
            mesh.userData.href = hrefs[i];
            planes[i] = mesh;
            scene.add(mesh);
          });
        });

        raycaster = new THREE.Raycaster();
        mouseNDC = new THREE.Vector2(-10, -10);
      }

      build();

      function updateNDC(clientX, clientY) {
        const rect = el.getBoundingClientRect();
        mouseNDC.x = ((clientX - rect.left) / rect.width) * 2 - 1;
        mouseNDC.y = -((clientY - rect.top) / rect.height) * 2 + 1;
      }

      function navigateToHit() {
        raycaster.setFromCamera(mouseNDC, camera);
        const hit = raycaster.intersectObjects(planes.filter(Boolean))[0];
        if (hit && hit.object.userData.href) window.location.href = hit.object.userData.href;
      }

      el.addEventListener('mousemove', (e) => updateNDC(e.clientX, e.clientY));
      el.addEventListener('mouseleave', () => mouseNDC.set(-10, -10));

      // Pointer-based drag: works for touch (swipe the carousel side to side)
      // and mouse (click-drag), unified via the Pointer Events API. A tap/click
      // with negligible movement still navigates via the raycaster hit-test.
      let isDragging = false;
      let dragStartClientX = 0;
      let dragStartSceneX = 0;
      let dragMoved = false;
      const DRAG_THRESHOLD_PX = 6;

      el.addEventListener('pointerdown', (e) => {
        isDragging = true;
        dragMoved = false;
        dragStartClientX = e.clientX;
        dragStartSceneX = scene.position.x;
        updateNDC(e.clientX, e.clientY);
        el.setPointerCapture?.(e.pointerId);
      });

      window.addEventListener('pointermove', (e) => {
        if (!isDragging) return;
        const deltaPx = e.clientX - dragStartClientX;
        if (Math.abs(deltaPx) > DRAG_THRESHOLD_PX) dragMoved = true;
        if (dragMoved) scene.position.x = dragStartSceneX + deltaPx / pxPerUnit;
        updateNDC(e.clientX, e.clientY);
      });

      function endDrag(shouldNavigate) {
        if (!isDragging) return;
        isDragging = false;
        if (dragMoved) {
          time = scene.position.x / options.speed;
        } else if (shouldNavigate) {
          navigateToHit();
        }
      }

      window.addEventListener('pointerup', () => endDrag(true));
      window.addEventListener('pointercancel', () => endDrag(false));

      const resetThreshold = planeWidth * getGapWidth(options.gap) * slideCount;
      let time = 0;
      let previousTime = 0;

      function animate(currentTime) {
        const delta = currentTime - previousTime;
        previousTime = currentTime;

        raycaster.setFromCamera(mouseNDC, camera);
        const hit = raycaster.intersectObjects(planes.filter(Boolean))[0];
        const hoveredMesh = hit ? hit.object : null;
        el.style.cursor = hoveredMesh ? 'pointer' : 'default';

        if (!hoveredMesh && !isDragging) {
          if (Math.abs(scene.position.x) >= resetThreshold) time = 0;
          time += options.direction * delta * 0.00001;
          scene.position.x = time * options.speed;
        }

        planes.forEach((mesh) => {
          if (!mesh) return;
          const isHovered = mesh === hoveredMesh;

          const scaleTarget = isHovered ? 1.25 : 1;
          mesh.scale.x += (scaleTarget - mesh.scale.x) * 0.1;
          mesh.scale.y += (scaleTarget - mesh.scale.y) * 0.1;

          const zTarget = isHovered ? 0.3 : 0;
          mesh.position.z += (zTarget - mesh.position.z) * 0.1;

          const curveTarget = isHovered ? options.curve * 0.6 : options.curve;
          mesh.material.uniforms.curve.value += (curveTarget - mesh.material.uniforms.curve.value) * 0.1;
        });

        renderer.render(scene, camera);
        requestAnimationFrame(animate);
      }
      requestAnimationFrame(animate);

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(build, 150);
      });
    });
  </script>

