      <span style="width: 8px; height: 8px; border-radius: 50%; background: #22c55e; animation: pulseDot 2s infinite;"></span>
      <span style="writing-mode: vertical-rl; transform: rotate(180deg); font-size: 11px; font-weight: 700; letter-spacing: 1px; color: #0a0a0a; text-transform: uppercase;">Open for projects</span>
    </div>

    <!-- Floating 3D Elements Background -->
    <div id="hero-container" style="position: absolute; width: 100%; height: 100%; top: 0; left: 0;">

      

    </div>

    <!-- Main Content -->
    <div style="position: relative; z-index: 10; width: 100%; max-width: 1100px; padding: 2rem 3rem;">

      <span style="display: inline-block; font-size: 13px; color: #22d3ee; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 1.5rem;">
        Full-stack development studio
