  <style is:global>
    /*
      This block is global (not Astro-scoped) on purpose: most of the modal's
      content — feature list items, tag chips, tech icons — is created at
      runtime via document.createElement, so it never receives Astro's
      per-component data-astro-cid scoping attribute. Scoped selectors like
      ".pm-features li" would silently fail to match that JS-created markup
      and fall back to invisible default text color on the dark background.
    */
    .project-modal {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: none;
    }

    .project-modal.open {
      display: block;
    }

    .project-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .project-modal.open .project-modal-backdrop {
      opacity: 1;
    }

    .project-modal-panel {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -48%) scale(0.96);
      opacity: 0;
      width: min(720px, 92vw);
      max-height: 88vh;
      overflow-y: auto;
      background: #111111;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      box-shadow: 0 60px 120px -30px rgba(0, 0, 0, 0.8);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }

    .project-modal.open .project-modal-panel {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }

    .project-modal-close {
      position: absolute;
      top: 1.25rem;
      right: 1.25rem;
