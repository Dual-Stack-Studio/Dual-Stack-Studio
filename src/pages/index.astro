    const modal = document.getElementById('project-modal');
    const pmMedia = document.getElementById('pm-media');
    const pmClient = document.getElementById('pm-client');
    const pmTitle = document.getElementById('pm-title');
    const pmTagline = document.getElementById('pm-tagline');
    const pmDesc = document.getElementById('pm-desc');
    const pmFeatures = document.getElementById('pm-features');
    const pmTechTrack = document.getElementById('pm-tech-track');
    const pmExtraTech = document.getElementById('pm-extra-tech');
    const pmStatus = document.getElementById('pm-status');
    const pmCta = document.getElementById('pm-cta');
    const panel = modal.querySelector('.project-modal-panel');

    function openProjectModal(key) {
      const data = projectsData[key];
      if (!data) return;

      panel.style.setProperty('--pm-accent', data.accent);
      pmClient.textContent = data.client;
      pmClient.style.color = data.accent;
      pmTitle.textContent = data.title;
      pmTagline.textContent = data.tagline;
      pmDesc.textContent = data.description;
      pmStatus.textContent = data.status;

      pmFeatures.innerHTML = '';
      data.features.forEach((f) => {
        const li = document.createElement('li');
        li.textContent = f;
        pmFeatures.appendChild(li);
      });

      pmTechTrack.innerHTML = '';
      const iconized = data.stack.filter((t) => t.icon && techIconPaths[t.icon]);
      const textOnly = data.stack.filter((t) => !t.icon || !techIconPaths[t.icon]);

      // Render each icon twice back-to-back so translateX(-50%) loops seamlessly
      [...iconized, ...iconized].forEach((t) => {
        const iconData = techIconPaths[t.icon];
        const chip = document.createElement('div');
        chip.className = 'pm-tech-chip';

        const box = document.createElement('div');
        box.className = 'pm-tech-icon-box';
        box.innerHTML = `<svg viewBox="0 0 24 24" fill="${iconData.accent}"><path d="${iconData.path}"></path></svg>`;

        const label = document.createElement('span');
        label.textContent = t.name;

        chip.appendChild(box);
        chip.appendChild(label);
        pmTechTrack.appendChild(chip);
      });

      pmExtraTech.innerHTML = textOnly.length
        ? `<strong>Also used:</strong> ${textOnly.map((t) => t.name).join(', ')}`
        : '';

      pmMedia.innerHTML = '';
      if (data.video) {
        const video = document.createElement('video');
        video.src = data.video;
        video.controls = true;
        video.preload = 'none';
        video.style.background = `linear-gradient(135deg, ${data.accent} 0%, #0a0a0a 140%)`;
        pmMedia.appendChild(video);
      } else {
        pmMedia.style.background = `linear-gradient(135deg, ${data.accent} 0%, #0a0a0a 140%)`;
        const iconSpan = document.createElement('span');
        iconSpan.className = 'pm-media-icon';
        iconSpan.innerHTML = `<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${mediaLineIcons[data.icon] || ''}</svg>`;
        pmMedia.appendChild(iconSpan);
      }

      if (data.url) {
        pmCta.href = data.url;
        pmCta.classList.remove('pm-cta-disabled');
        pmCta.style.background = data.accent;
      } else {
        pmCta.href = '#';
        pmCta.classList.add('pm-cta-disabled');
      }

      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeProjectModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      const video = pmMedia.querySelector('video');
      if (video) video.pause();
    }

    document.querySelectorAll('.work-item[data-project]').forEach((item) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        openProjectModal(item.dataset.project);
      });
    });

    modal.querySelectorAll('[data-close]').forEach((el) => {
      el.addEventListener('click', closeProjectModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeProjectModal();
      }
    });
  </script>
