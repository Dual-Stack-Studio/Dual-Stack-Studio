  <script>
    // Services intro network — same shared function/pattern as Hero, Contact and Footer
    window.initNetworkCluster('network-canvas');

    // "Learn More" links jump to the contact form and preselect the matching service
    document.querySelectorAll('.service-learn-more[data-service]').forEach((link) => {
      link.addEventListener('click', () => {
        const select = document.getElementById('cf-service');
        if (select) select.value = link.dataset.service;
      });
    });

    // Contact form: validate, then submit directly to hello@dualstackstudio.com via Web3Forms
    const contactForm = document.getElementById('contact-form');
    if (contactForm) {
      const cfNote = document.getElementById('cf-note');
      const cfNoteDefault = cfNote.innerHTML;
      const cfSubmitBtn = document.getElementById('cf-submit-btn');
      const cfSubmitDefault = cfSubmitBtn.innerHTML;
      const cfSuccess = document.getElementById('cf-success');

      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = contactForm.name.value.trim();
        const email = contactForm.email.value.trim();
        const service = contactForm.service.value;
        const message = contactForm.message.value.trim();

        const emailValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
        let firstInvalid = null;

        [
          [contactForm.querySelector('#cf-name').closest('.cf-field'), !!name],
          [contactForm.querySelector('#cf-email').closest('.cf-field'), emailValid],
          [contactForm.querySelector('#cf-message').closest('.cf-field'), !!message],
        ].forEach(([field, isValid]) => {
          field.classList.toggle('cf-error', !isValid);
          if (!isValid && !firstInvalid) firstInvalid = field;
        });

        if (firstInvalid) {
          firstInvalid.querySelector('input, textarea').focus();
          return;
        }

        contactForm.subject.value = `${service} inquiry from ${name}`;
        cfSubmitBtn.disabled = true;
        cfSubmitBtn.textContent = 'Sending…';
        cfNote.textContent = '';

        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: new FormData(contactForm),
          });
          const result = await res.json();

          if (result.success) {
            contactForm.reset();
            contactForm.hidden = true;
            cfSuccess.hidden = false;
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } else {
            throw new Error(result.message || 'Submission failed');
          }
        } catch (err) {
          cfNote.textContent = 'Something went wrong. Please email us directly at hello@dualstackstudio.com.';
          cfSubmitBtn.disabled = false;
          cfSubmitBtn.innerHTML = cfSubmitDefault;
        }
      });

      contactForm.querySelectorAll('input, textarea').forEach((el) => {
        el.addEventListener('input', () => {
          el.closest('.cf-field').classList.remove('cf-error');
        });
      });
    }
  </script>

