  <style>
    .eyebrow {
      font-size: 12px;
      font-weight: 700;
      color: #22d3ee;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .view-all-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 14px;
      font-weight: 600;
      color: #ccc;
      text-decoration: none;
      transition: color 0.3s, gap 0.3s;
    }

    .view-all-link:hover {
      color: #22d3ee;
      gap: 0.65rem;
    }

    .view-all-link i {
      font-style: normal;
    }

    .work-stack {
      display: flex;
      flex-direction: column;
      gap: 7rem;
    }

    .work-item {
      display: flex;
      align-items: center;
      gap: 3.5rem;
      text-decoration: none;
      cursor: pointer;
    }

    .work-item-reverse {
      flex-direction: row-reverse;
    }

    .work-media {
      position: relative;
      flex: 0 0 60%;
      aspect-ratio: 16 / 10;
      border-radius: 14px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s;
      box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.8);
    }

    .work-media-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .work-media-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.1) 100%);
      z-index: 1;
    }

    .work-media:not(:has(img))::after {
      content: '';
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0px, rgba(255, 255, 255, 0.05) 2px, transparent 2px, transparent 14px);
    }

    .work-item:hover .work-media {
      transform: scale(1.02);
      box-shadow: 0 40px 80px -20px var(--accent);
    }

    .work-media-icon {
      position: relative;
      z-index: 1;
      display: inline-flex;
      color: rgba(255, 255, 255, 0.9);
      transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .work-item:hover .work-media-icon {
      transform: scale(1.15) rotate(-6deg);
    }

    .work-info {
      position: relative;
      flex: 1;
      min-width: 0;
    }

    .work-index {
      position: absolute;
      top: -2.5rem;
      right: 0;
      font-size: 90px;
      font-weight: 800;
      line-height: 1;
      color: rgba(255, 255, 255, 0.05);
      user-select: none;
      z-index: 0;
    }

    .work-item-reverse .work-index {
      right: auto;
      left: 0;
    }

    .work-tags {
      position: relative;
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin-bottom: 1rem;
    }

    .work-tags span {
      font-size: 11px;
      font-weight: 600;
      padding: 0.3rem 0.7rem;
      border-radius: 100px;
    }

    .tag-pink {
      background: color-mix(in srgb, var(--accent2) 22%, transparent);
      color: color-mix(in srgb, var(--accent2) 65%, white);
    }

    .tag-blue {
      background: color-mix(in srgb, var(--accent) 22%, transparent);
      color: color-mix(in srgb, var(--accent) 65%, white);
    }

    .work-client {
      position: relative;
      display: block;
      font-size: 13px;
      color: #777;
      margin-bottom: 0.5rem;
    }

    .work-info h3 {
      position: relative;
      margin: 0 0 1rem 0;
      font-size: clamp(26px, 3vw, 38px);
      font-weight: 800;
      letter-spacing: -1px;
      color: #ffffff;
    }

    .work-info p {
      position: relative;
      margin: 0 0 1.5rem 0;
      font-size: 15px;
      color: #999;
      line-height: 1.7;
      max-width: 420px;
    }

    .work-link {
      position: relative;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 14px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.6);
      transition: color 0.3s, gap 0.3s;
    }

    .work-item:hover .work-link {
      color: var(--accent);
      gap: 0.85rem;
    }

