---
import Layout from '../layouts/Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };

const copy = {
  en: {
    title: 'Dual-Stack Studio — Creative & Web',
    description: 'One team, two crafts. Slide to choose a department: Creative & Marketing, or Web & Full-Stack.',
    tag: 'One team. Two crafts. Slide to choose.',
    dept1: 'Department 01',
    dept2: 'Department 02',
    creativeLong: 'Photography, film and storytelling for places worth remembering plus the social presence that carries it.',
    creativeShort: 'Photography, film & storytelling — and the social presence behind it.',
    webLong: 'Websites, web apps and the booking systems behind them designed, built and shipped end to end.',
    webShort: 'Websites, apps & booking systems — built end to end.',
    enterCreative: 'Enter Creative & Marketing',
    enterWeb: 'Enter Web & Full-Stack',
    sliderLabel: 'Slide left for Creative, right for Web',
    hintIdle: 'drag to choose',
    hintCreative: 'release for Creative',
    hintWeb: 'release for Web',
  },
  de: {
    title: 'Dual-Stack Studio — Creative & Web',
    description: 'Ein Team, zwei Disziplinen. Ziehen Sie, um einen Bereich zu wählen: Creative & Marketing oder Web & Full-Stack.',
    tag: 'Ein Team. Zwei Disziplinen. Ziehen zum Wählen.',
    dept1: 'Bereich 01',
    dept2: 'Bereich 02',
    creativeLong: 'Fotografie, Film und Storytelling für Orte, an die man sich gerne erinnert — plus der Social-Media-Auftritt, der sie trägt.',
    creativeShort: 'Fotografie, Film & Storytelling — und der Social-Media-Auftritt dahinter.',
    webLong: 'Websites, Web-Apps und die Buchungssysteme dahinter — von Anfang bis Ende entworfen, gebaut und ausgeliefert.',
    webShort: 'Websites, Apps & Buchungssysteme — von A bis Z gebaut.',
    enterCreative: 'Creative & Marketing öffnen',
    enterWeb: 'Web & Full-Stack öffnen',
    sliderLabel: 'Nach links ziehen für Creative, nach rechts für Web',
    hintIdle: 'ziehen zum Wählen',
    hintCreative: 'loslassen für Creative',
    hintWeb: 'loslassen für Web',
  },
};
const c = copy[lang];
---

<Layout title={c.title} description={c.description} lang={lang}>

  <div class="door" id="door" data-hint-idle={c.hintIdle} data-hint-creative={c.hintCreative} data-hint-web={c.hintWeb}>

    <!-- Language switch -->
    <div class="door-lang"><LangSwitch lang={lang} /></div>

    <!-- Brand, centred over both panels -->
    <div class="door-brand">
      <img src="/logo.svg" alt="Dual-Stack Studio" width="46" height="46" />
      <span class="door-brand-name">Dual-Stack Studio</span>
      <span class="door-brand-tag">{c.tag}</span>
    </div>

    <!-- CREATIVE & MARKETING -->
    <a href={l(lang, '/creative')} class="door-half door-half--creative" id="half-creative" aria-label={c.enterCreative}>
      <div class="door-half-bg" style="background-image: url('/images/journal/austria/austria-01.jpg');"></div>
      <div class="door-scrim door-scrim--creative"></div>
      <div class="door-content">
        <span class="door-eyebrow">{c.dept1}</span>
        <h2 class="door-title">Creative &amp;<br />Marketing</h2>
        <p class="door-desc"><span class="desc-long">{c.creativeLong}</span><span class="desc-short">{c.creativeShort}</span></p>
      </div>
    </a>

    <!-- WEB & FULL-STACK -->
    <a href={l(lang, '/web')} class="door-half door-half--web" id="half-web" aria-label={c.enterWeb}>
      <div class="door-half-bg" style="background-image: url('/images/web-hero-bg.jpg');"></div>
      <div class="door-scrim door-scrim--web"></div>
      <div class="door-content">
        <span class="door-eyebrow door-eyebrow--lime">{c.dept2}</span>
        <h2 class="door-title door-title--light">Web &amp;<br />Full-Stack</h2>
        <p class="door-desc door-desc--light"><span class="desc-long">{c.webLong}</span><span class="desc-short">{c.webShort}</span></p>
      </div>
    </a>

    <!-- Drag handle, centre -->
    <div class="door-handle" id="door-handle" role="slider" aria-label={c.sliderLabel} aria-valuemin="-100" aria-valuemax="100" aria-valuenow="0" tabindex="0">
      <span class="door-handle-grip">
        <span class="door-handle-arrow">‹</span>
        <span class="door-handle-dots"></span>
        <span class="door-handle-arrow">›</span>
      </span>
      <span class="door-handle-hint">{c.hintIdle}</span>
    </div>

    <!-- Legal notice (Impressum must be reachable from every page) -->
    <a href={l(lang, '/impressum')} class="door-legal">Impressum</a>

    <!-- Commit curtain -->
    <div class="door-curtain" id="door-curtain"></div>

  </div>

  <style>
    :root {
      --cream: #f7f2e7;
      --forest: #2f4436;
      --forest-deep: #223226;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --lime: #ccff33;
    }

    .door {
      display: flex;
      min-height: 100vh;
      min-height: 100svh;
      width: 100%;
      position: relative;
      overflow: hidden;
      touch-action: pan-y;
    }
    .door.is-grabbing { cursor: grabbing; }

    /* ---------- BRAND ---------- */
    .door-brand {
      position: absolute;
      top: 2rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 20;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      text-align: center;
      pointer-events: none;
      padding: 0 1rem;
    }
    .door-brand img { border-radius: 11px; box-shadow: 0 8px 24px -10px rgba(0,0,0,0.5); }
    .door-brand-name {
      font-family: 'Fraunces', serif;
      font-size: clamp(20px, 3vw, 26px);
      font-weight: 600;
      color: #fff;
      letter-spacing: -0.5px;
      text-shadow: 0 2px 14px rgba(0,0,0,0.55);
      margin-top: 0.4rem;
    }
    .door-brand-tag {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      text-shadow: 0 1px 10px rgba(0,0,0,0.6);
    }

    /* ---------- HALVES ---------- */
    .door-half {
      position: relative;
      flex: 1 1 0;
      flex-grow: 1;
      min-height: 100vh;
      min-height: 100svh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      text-decoration: none;
      will-change: flex-grow;
    }
    .door.is-animating .door-half { transition: flex-grow 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
    .door-half--web { background: #0a0a0a; }

    .door-half-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      transform: scale(1.03);
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .door-half:hover .door-half-bg { transform: scale(1.08); }

    .door-scrim { position: absolute; inset: 0; transition: opacity 0.4s ease; }
    .door-scrim--creative {
      background:
        radial-gradient(62% 58% at 50% 52%, rgba(20,24,16,0.55) 0%, rgba(20,24,16,0) 78%),
        linear-gradient(180deg, rgba(34,50,38,0.45) 0%, rgba(34,50,38,0.3) 42%, rgba(20,24,16,0.85) 100%);
    }
    .door-scrim--web {
      background:
        radial-gradient(58% 55% at 50% 52%, rgba(10,10,10,0.5) 0%, rgba(10,10,10,0) 78%),
        linear-gradient(180deg, rgba(10,10,10,0.12) 0%, rgba(10,10,10,0.55) 100%);
    }
    .door-half--web::before {
      content: '';
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255,255,255,0.06) 1px, transparent 1px);
      background-size: 22px 22px;
      z-index: 1;
    }

    .door-content {
      position: relative;
      z-index: 5;
      padding: 2rem clamp(1.75rem, 5vw, 4.5rem);
      max-width: 520px;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      transition: opacity 0.4s ease, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .door-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      margin-bottom: 1rem;
    }
    .door-eyebrow--lime { color: var(--lime); }

    .door-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(38px, 6vw, 68px);
      font-weight: 600;
      line-height: 0.98;
      letter-spacing: -2px;
      color: #fff;
      margin: 0 0 1.25rem;
    }
    .door-title--light {
      font-family: 'Inter', system-ui, sans-serif;
      font-weight: 800;
      letter-spacing: -2.5px;
    }

    .door-desc {
      font-size: clamp(15px, 1.6vw, 17px);
      line-height: 1.6;
      color: rgba(255,255,255,0.9);
      margin: 0 0 2rem;
      max-width: 420px;
    }
    .door-desc--light { color: rgba(255,255,255,0.7); }
    .desc-short { display: none; }

    /* the side being chosen leans in */
    .door-half.is-target .door-content { transform: translateY(-6px); }

    /* ---------- HANDLE ---------- */
    .door-handle {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 30;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
      transform: translate(-50%, -50%);
      cursor: grab;
      user-select: none;
      touch-action: none;
      will-change: transform, opacity;
    }
    .door.is-animating .door-handle { transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.4s ease; }
    .door-handle:active { cursor: grabbing; }
    .door-handle-grip {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 16px 18px;
      border-radius: 100px;
      background: rgba(255,255,255,0.16);
      border: 1.5px solid rgba(255,255,255,0.5);
      backdrop-filter: blur(12px);
      box-shadow: 0 14px 38px -12px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.25);
      color: #fff;
      transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, transform 0.25s cubic-bezier(0.22,1,0.36,1);
    }
    .door-handle-arrow { font-size: 20px; line-height: 1; font-weight: 700; opacity: 0.9; }
    .door-handle-dots {
      width: 4px; height: 24px;
      border-radius: 4px;
      background:
        radial-gradient(circle, currentColor 1.4px, transparent 1.6px) center / 4px 7px repeat-y;
      opacity: 0.9;
    }
    .door-handle-hint {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.9);
      text-shadow: 0 1px 8px rgba(0,0,0,0.6);
      background: rgba(0,0,0,0.28);
      padding: 4px 10px;
      border-radius: 100px;
      transition: opacity 0.3s ease, color 0.3s ease;
      white-space: nowrap;
    }

    /* dynamic tint: grip adopts the palette of the side being dragged toward */
    .door-handle.lean-creative .door-handle-grip {
      background: var(--terracotta);
      border-color: rgba(247,242,231,0.9);
      color: #fff;
      box-shadow: 0 16px 44px -12px rgba(193,102,62,0.75), inset 0 1px 0 rgba(255,255,255,0.3);
      transform: scale(1.08);
    }
    .door-handle.lean-web .door-handle-grip {
      background: var(--lime);
      border-color: #0a0a0a;
      color: #0a0a0a;
      box-shadow: 0 16px 44px -12px rgba(204,255,51,0.65), inset 0 1px 0 rgba(255,255,255,0.5);
      transform: scale(1.08);
    }
    .door-handle.lean-creative .door-handle-hint { color: #fff; }
    .door-handle.lean-web .door-handle-hint { color: var(--lime); }
    .door.is-grabbing .door-handle-hint { opacity: 0; }
    /* attention pulse — an expanding ring that pings to invite the drag.
       Uses box-shadow only (no transform) so it works in both the horizontal
       desktop layout and the rotated vertical mobile handle. */
    @keyframes doorPulse {
      0%   { box-shadow: 0 14px 38px -12px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.25), 0 0 0 0 rgba(255,255,255,0.55); }
      70%  { box-shadow: 0 14px 38px -12px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.25), 0 0 0 16px rgba(255,255,255,0); }
      100% { box-shadow: 0 14px 38px -12px rgba(0,0,0,0.65), inset 0 1px 0 rgba(255,255,255,0.25), 0 0 0 0 rgba(255,255,255,0); }
    }
    .door-handle-grip { animation: doorPulse 1.9s ease-out infinite; }
    .door.is-grabbing .door-handle-grip, .door.is-animating .door-handle-grip { animation: none; }

    /* ---------- LANGUAGE SWITCH ---------- */
    .door-lang {
      position: absolute;
      top: 1rem;
      right: 1.25rem;
      z-index: 26;
      color: #fff;
      text-shadow: 0 1px 8px rgba(0,0,0,0.6);
    }

    /* ---------- LEGAL LINK ---------- */
    .door-legal {
      position: absolute;
      bottom: 0.9rem;
      left: 50%;
      transform: translateX(-50%);
      z-index: 25;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.65);
      text-decoration: none;
      text-shadow: 0 1px 8px rgba(0,0,0,0.6);
      transition: color 0.2s ease;
    }
    .door-legal:hover { color: #fff; }

    /* ---------- COMMIT CURTAIN ---------- */
    .door-curtain {
      position: absolute;
      inset: 0;
      z-index: 40;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.5s ease;
    }
    .door-curtain.to-creative { background: var(--forest-deep); }
    .door-curtain.to-web { background: #0a0a0a; }
    .door-curtain.show { opacity: 1; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      /* Stack into two panels that split one viewport, so the handle can be
         dragged UP (Creative) or DOWN (Web). */
      .door { flex-direction: column; height: 100vh; height: 100svh; }
      .door-half { min-height: 0; }
      .door-brand { top: 0.9rem; }
      .door-brand img { width: 38px; height: 38px; }
      .door-brand-name { font-size: 18px; margin-top: 0.25rem; }
      .door-brand-tag { display: none; }
      .door-content { padding: 1.25rem 1.5rem; }
      .door-eyebrow { margin-bottom: 0.5rem; }
      .door-title { font-size: clamp(28px, 8vw, 40px); margin-bottom: 0.6rem; }
      .door-desc { font-size: 13.5px; margin-bottom: 0; max-width: 360px; }
      /* keep the top panel's content clear of the brand */
      .door-half--creative .door-content { padding-top: 4rem; }
      /* rotate the grip so its arrows point up / down for the vertical drag.
         The attention pulse is box-shadow only, so it keeps running here too. */
      .door-handle-grip { transform: rotate(90deg); }
      .door-handle.lean-creative .door-handle-grip,
      .door-handle.lean-web .door-handle-grip { transform: rotate(90deg) scale(1.08); }
    }
    @media (max-width: 480px) {
      .door-title { font-size: clamp(25px, 8.5vw, 34px); }
      .door-desc { font-size: 13px; margin-bottom: 0.85rem; }
      .door-brand-name { font-size: 16px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .door.is-animating .door-half,
      .door.is-animating .door-handle,
      .door-curtain { transition: none; }
      .door-handle-grip { animation: none; }
    }
  </style>

  <script>
    (function () {
      const door = document.getElementById('door');
      const creative = document.getElementById('half-creative') as HTMLAnchorElement | null;
      const web = document.getElementById('half-web') as HTMLAnchorElement | null;
      const handle = document.getElementById('door-handle');
      const curtain = document.getElementById('door-curtain');
      const hint = handle?.querySelector('.door-handle-hint') as HTMLElement | null;
      if (!door || !creative || !web || !handle || !curtain) return;

      const HINT_IDLE = door.dataset.hintIdle || 'drag to choose';

      function setLean(side: 'creative' | 'web' | null) {
        handle!.classList.toggle('lean-creative', side === 'creative');
        handle!.classList.toggle('lean-web', side === 'web');
        if (hint) {
          hint.textContent = side === 'creative' ? (door!.dataset.hintCreative || 'release for Creative')
            : side === 'web' ? (door!.dataset.hintWeb || 'release for Web')
            : HINT_IDLE;
        }
      }

      const COMMIT = 0.45;      // fraction of half-width to trigger open
      const MAX_LEAN = 5;       // grow ratio at full drag
      const isHorizontal = () => window.matchMedia('(min-width: 861px)').matches;

      let dragging = false;
      let committed = false;
      let startX = 0;
      let startY = 0;
      let t = 0;                // -1 (creative) .. 0 .. +1 (web)
      let moved = false;

      function setGrow(tt: number) {
        // Drag toward a side grows THAT side. Right(+) => web grows; Left(-) => creative grows.
        const lean = Math.abs(tt) * (MAX_LEAN - 1);
        if (tt >= 0) {
          web!.style.flexGrow = String(1 + lean);
          creative!.style.flexGrow = String(1 / (1 + lean));
          web!.classList.toggle('is-target', tt > 0.05);
          creative!.classList.remove('is-target');
          setLean(tt > 0.05 ? 'web' : null);
        } else {
          creative!.style.flexGrow = String(1 + lean);
          web!.style.flexGrow = String(1 / (1 + lean));
          creative!.classList.toggle('is-target', tt < -0.05);
          web!.classList.remove('is-target');
          setLean(tt < -0.05 ? 'creative' : null);
        }
        handle!.style.transform = handleShift(tt * 46);
        handle!.style.opacity = String(handleFadeFor(tt));
        handle!.setAttribute('aria-valuenow', String(Math.round(tt * 100)));
      }

      // As the handle is dragged toward a side, fade it out in a graduated
      // curve (not an abrupt cut) so the title underneath isn't covered —
      // by the time you're near the commit threshold it's nearly gone.
      const FADE_START = 0.08;
      function handleFadeFor(tt: number) {
        const absT = Math.abs(tt);
        const progress = Math.max(0, Math.min(1, (absT - FADE_START) / (COMMIT - FADE_START)));
        return 1 - progress * 0.88; // eases down to ~0.12, fully 0 once committed
      }

      // Move the handle along the active axis: horizontal on desktop, vertical on mobile.
      function handleShift(px: number) {
        return isHorizontal()
          ? `translate(calc(-50% + ${px}px), -50%)`
          : `translate(-50%, calc(-50% + ${px}px))`;
      }

      function reset() {
        door!.classList.add('is-animating');
        creative!.style.flexGrow = '1';
        web!.style.flexGrow = '1';
        creative!.classList.remove('is-target');
        web!.classList.remove('is-target');
        setLean(null);
        handle!.style.transform = 'translate(-50%, -50%)';
        handle!.style.opacity = '1';
        window.setTimeout(() => door!.classList.remove('is-animating'), 620);
        t = 0;
      }

      function commit(side: 'creative' | 'web') {
        if (committed) return;
        committed = true;
        setLean(side);
        door!.classList.add('is-animating');
        // expand the chosen side to fill
        if (side === 'web') {
          web!.style.flexGrow = '60';
          creative!.style.flexGrow = '0.0001';
          handle!.style.transform = handleShift(60);
        } else {
          creative!.style.flexGrow = '60';
          web!.style.flexGrow = '0.0001';
          handle!.style.transform = handleShift(-60);
        }
        handle!.style.opacity = '0';
        // fade the curtain in the destination's colour, then navigate
        curtain!.classList.add(side === 'web' ? 'to-web' : 'to-creative');
        window.setTimeout(() => curtain!.classList.add('show'), 260);
        const target = (side === 'web' ? web : creative)!.getAttribute('href') || (side === 'web' ? '/web' : '/creative');
        window.setTimeout(() => { window.location.href = target; }, 760);
      }

      function onDown(e: PointerEvent) {
        if (committed) return;
        dragging = true;
        moved = false;
        startX = e.clientX;
        startY = e.clientY;
        door!.classList.remove('is-animating');
        door!.classList.add('is-grabbing');
        try { (e.target as Element).setPointerCapture?.(e.pointerId); } catch {}
      }
      // Pointer events can fire far faster than the screen refreshes (high-
      // polling-rate mice/trackpads). Recomputing layout + repainting the
      // blurred handle on every single one makes the drag feel sluggish, so
      // only the latest position is kept and applied once per animation frame.
      let pendingEvent: PointerEvent | null = null;
      let rafId: number | null = null;

      function applyMove(e: PointerEvent) {
        // Horizontal drag on desktop, vertical drag on stacked mobile.
        const horizontal = isHorizontal();
        const delta = horizontal ? (e.clientX - startX) : (e.clientY - startY);
        const half = (horizontal ? window.innerWidth : window.innerHeight) / 2;
        t = Math.max(-1, Math.min(1, delta / half));
        if (Math.abs(delta) > 6) moved = true;
        setGrow(t);
      }

      function onMove(e: PointerEvent) {
        if (!dragging) return;
        pendingEvent = e;
        if (rafId !== null) return;
        rafId = requestAnimationFrame(() => {
          rafId = null;
          if (pendingEvent) applyMove(pendingEvent);
        });
      }
      function onUp() {
        if (!dragging) return;
        dragging = false;
        if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
        pendingEvent = null;
        door!.classList.remove('is-grabbing');
        if (t >= COMMIT) commit('web');
        else if (t <= -COMMIT) commit('creative');
        else reset();
      }

      // Pointer drag starts on the handle, but can continue anywhere.
      handle.addEventListener('pointerdown', onDown);
      window.addEventListener('pointermove', onMove);
      window.addEventListener('pointerup', onUp);
      window.addEventListener('pointercancel', onUp);

      // Two ways in: click a panel / its button, or drag the centre handle.
      // (Drag lives on the handle only, so panel clicks never collide with it.)
      function onHalfClick(e: Event, side: 'creative' | 'web') {
        e.preventDefault();
        if (committed) return;
        commit(side);
      }
      creative.addEventListener('click', (e) => onHalfClick(e, 'creative'));
      web.addEventListener('click', (e) => onHalfClick(e, 'web'));

      // Keyboard: arrows / enter on the handle.
      handle.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); commit('creative'); }
        else if (e.key === 'ArrowRight') { e.preventDefault(); commit('web'); }
      });

      // Reset the door to its neutral state whenever it's shown — including when
      // the browser restores it from the back/forward cache (otherwise it stays
      // frozen in the committed/curtain state and shows a blank panel).
      function resetDoor() {
        committed = false;
        dragging = false;
        t = 0;
        door!.classList.remove('is-animating', 'is-grabbing');
        creative!.style.flexGrow = '1';
        web!.style.flexGrow = '1';
        creative!.classList.remove('is-target');
        web!.classList.remove('is-target');
        setLean(null);
        handle!.style.transform = 'translate(-50%, -50%)';
        handle!.style.opacity = '';
        curtain!.classList.remove('show', 'to-web', 'to-creative');
      }
      window.addEventListener('pageshow', resetDoor);
    })();
  </script>

</Layout>
