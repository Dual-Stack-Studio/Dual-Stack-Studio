    <!-- Hero network background canvas -->
    <canvas id="hero-network-canvas" style="position: absolute; inset: 0; z-index: 0; opacity: 0.4;"></canvas>

  </section>

  <style>
    @keyframes pulseDot {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
      50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
    }

    @keyframes scrollLine {
      0% { transform: scaleY(0); transform-origin: top; opacity: 1; }
      50% { transform: scaleY(1); transform-origin: top; opacity: 1; }
      51% { transform-origin: bottom; }
      100% { transform: scaleY(0); transform-origin: bottom; opacity: 0.3; }
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotateX(0deg) rotateY(0deg); }
      33% { transform: translateY(-20px) rotateX(8deg) rotateY(-8deg); }
      66% { transform: translateY(10px) rotateX(-6deg) rotateY(6deg); }
    }

    .floating-3d {
      animation: float 8s ease-in-out infinite;
    }

    .floating-3d:nth-child(2) {
      animation-delay: -2s;
    }

    .floating-3d:nth-child(3) {
      animation-delay: -4s;
    }

    #site-header.scrolled {
      background: rgba(10, 10, 10, 0.75);
      backdrop-filter: blur(12px);
      box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06);
      padding: 1rem 3rem;
    }
  </style>

  <script>
    const heroContainer = document.getElementById('hero-container');
    const floatingElements = document.querySelectorAll('.floating-3d');
    const header = document.getElementById('site-header');

    // Mouse parallax effect
    document.addEventListener('mousemove', (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 40;
      const y = (e.clientY / window.innerHeight - 0.5) * 40;

      floatingElements.forEach((el, index) => {
        const speed = 1 + (index * 0.3);
        el.style.transform = `translateX(${x * speed}px) translateY(${y * speed}px)`;
      });
    });

    document.addEventListener('mouseleave', () => {
      floatingElements.forEach((el) => {
        el.style.transform = 'translateX(0) translateY(0)';
      });
    });

    // Header picks up a subtle dark glass backdrop once scrolled past the hero (whole site is dark now)
    const darkZoneEnd = document.getElementById('hero-container').closest('section');
    const headerObserver = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
          header.classList.add('scrolled');
        } else {
          header.classList.remove('scrolled');
        }
      },
      { threshold: 0 }
    );
    headerObserver.observe(darkZoneEnd);

    // Hero network particle effect (different pattern from Services)
    const heroCanvas = document.getElementById('hero-network-canvas');
    if (heroCanvas) {
      const ctx = heroCanvas.getContext('2d');
      const heroSection = heroCanvas.closest('section');
      let heroRaf;

      const heroState = {
        particles: [],
        time: 0,
      };

      function resizeHeroCanvas() {
        heroCanvas.width = heroSection.clientWidth;
        heroCanvas.height = heroSection.clientHeight;
      }

      function initHeroParticles() {
        heroState.particles = [];
        const particleCount = 12;
        for (let i = 0; i < particleCount; i++) {
          heroState.particles.push({
            x: Math.random() * heroCanvas.width,
            y: Math.random() * heroCanvas.height,
            vx: (Math.random() - 0.5) * 0.4,
            vy: (Math.random() - 0.5) * 0.4,
            radius: Math.random() * 2 + 1.5,
          });
        }
      }

      function heroTick() {
        ctx.fillStyle = 'rgb(10, 10, 10)';
        ctx.fillRect(0, 0, heroCanvas.width, heroCanvas.height);

        heroState.time += 1;

        // Update & draw particles
        heroState.particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < 0 || p.x > heroCanvas.width) p.vx *= -1;
          if (p.y < 0 || p.y > heroCanvas.height) p.vy *= -1;

          p.x = Math.max(0, Math.min(heroCanvas.width, p.x));
          p.y = Math.max(0, Math.min(heroCanvas.height, p.y));

          ctx.fillStyle = 'rgba(34, 211, 238, 0.7)';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
          ctx.fill();
        });

        // Draw connections (only to nearby particles, sparser than Services)
        ctx.strokeStyle = 'rgba(34, 211, 238, 0.15)';
        ctx.lineWidth = 0.5;
        for (let i = 0; i < heroState.particles.length; i++) {
          for (let j = i + 1; j < heroState.particles.length; j++) {
            const p1 = heroState.particles[i];
            const p2 = heroState.particles[j];
            const dx = p2.x - p1.x;
            const dy = p2.y - p1.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 200) {
              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.stroke();
            }
          }
        }

        heroRaf = requestAnimationFrame(heroTick);
      }

      resizeHeroCanvas();
      initHeroParticles();
      heroTick();

      window.addEventListener('resize', () => {
        cancelAnimationFrame(heroRaf);
        resizeHeroCanvas();
        initHeroParticles();
        heroTick();
      });
    }
  </script>

