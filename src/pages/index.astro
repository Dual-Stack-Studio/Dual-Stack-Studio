        <a href="#services" class="nav-link" style="color: #ffffff;">Services</a>
        <a href="#team" class="nav-link" style="color: #ffffff;">Team</a>
        <a href="#testimonials" class="nav-link" style="color: #ffffff;">Testimonials</a>
