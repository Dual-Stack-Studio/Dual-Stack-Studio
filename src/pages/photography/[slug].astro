---
import PhotoLayout from '../../layouts/PhotoLayout.astro';
import { l } from '../../i18n';
import type { Lang } from '../../i18n';
import { series, seriesSlugs, getSeries, toRows } from '../../data/photography';

export function getStaticPaths() {
  return seriesSlugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug, lang = 'en' } = Astro.props as { slug: string; lang?: Lang };
const s = getSeries(slug);

const idx = series.findIndex((x) => x.slug === s.slug);
const next = series[(idx + 1) % series.length];
const hasNext = series.length > 1;

const copy = {
  en: {
    back: '← All photographs',
    eyebrow: 'Photography · Series', photos: 'photographs',
    nextLabel: 'Next series', all: 'All photographs',
    note: 'Personal work — not for hire, not for clients.',
  },
  de: {
    back: '← Alle Fotografien',
    eyebrow: 'Fotografie · Serie', photos: 'Fotografien',
    nextLabel: 'Nächste Serie', all: 'Alle Fotografien',
    note: 'Persönliche Arbeit — keine Auftragsarbeit.',
  },
};
const c = copy[lang];

const rows = toRows(s.plates);
// running number per plate, in reading order
let counter = 0;
const numbered = rows.map((row) => ({
  kind: row.kind,
  plates: row.plates.map((p) => ({ ...p, n: String(++counter).padStart(2, '0') })),
}));
const total = s.plates.length;
---

<PhotoLayout
  title={`${s.title[lang]} — ${lang === 'de' ? 'Fotografie' : 'Photography'} — Dual-Stack Studio`}
  description={s.lead[lang]}
  lang={lang}
  backHref={l(lang, '/photography')}
  backLabel={c.back}
>
  <section class="phs-hero">
    <div class="ph-inner">
      <span class="phs-eyebrow">{c.eyebrow} {s.num}</span>
      <h1>{s.title[lang]}</h1>
      <p class="phs-meta">{s.meta[lang]} · {total} {c.photos}{s.gear ? ` · ${s.gear}` : ''}</p>
      <p class="phs-lead">{s.lead[lang]}</p>
    </div>
  </section>

  <section class="phs-gallery">
    <div class="phs-wrap">
      {numbered.map((row, ri) => (
        <div class={`phs-row phs-row--${row.kind}`}>
          {row.plates.map((p) => (
            <figure class="phs-plate" style={row.kind === 'pair' ? `flex: ${(p.w / p.h).toFixed(4)} 1 0` : undefined}>
              <button
                type="button"
                class="phs-plate-btn"
                data-plate
                data-full={s.folder + p.file}
                data-title={p.title[lang]}
                data-alt={p.alt[lang]}
                aria-label={p.title[lang]}
              >
                <img
                  src={s.folder + p.file}
                  alt={p.alt[lang]}
                  width={p.w}
                  height={p.h}
                  loading={ri === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  sizes={row.kind === 'wide' ? '(min-width: 1300px) 1240px, 100vw' : '(min-width: 1300px) 610px, 50vw'}
                />
              </button>
              <figcaption><span>{p.n}</span> {p.title[lang]}</figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="phs-end">
    <div class="ph-inner">
      <p class="phs-note">{c.note}</p>
      <div class="phs-links">
        {hasNext && (
          <a href={l(lang, `/photography/${next.slug}`)} class="phs-next">
            <span>{c.nextLabel} · {next.num}</span>
            <strong>{next.title[lang]} →</strong>
          </a>
        )}
        <a href={l(lang, '/photography')} class="phs-all">{c.all}</a>
      </div>
    </div>
  </section>
</PhotoLayout>

<style is:global>
  .phs-hero { padding: 10rem 0 4rem; }
  .phs-eyebrow { display: block; font-size: 12px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: #e2865a; margin-bottom: 1.25rem; }
  .phs-hero h1 { font-family: 'Fraunces', Georgia, serif; font-size: clamp(44px, 8vw, 92px); font-weight: 500; letter-spacing: -2.5px; line-height: 1; color: #fff; margin: 0 0 1.25rem; }
  .phs-meta { font-size: 13px; letter-spacing: 0.7px; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); margin-bottom: 1.5rem; }
  .phs-lead { max-width: 620px; font-size: 18px; line-height: 1.7; color: rgba(233, 226, 214, 0.78); }

  .phs-gallery { padding: 1rem 0 5rem; }
  .phs-wrap { max-width: 1240px; margin: 0 auto; padding: 0 1.75rem; display: flex; flex-direction: column; gap: 2.75rem; }
  .phs-row { display: flex; gap: 1.75rem; align-items: flex-start; }
  .phs-row--wide .phs-plate { flex: 1 1 100%; }
  .phs-row--single { justify-content: center; }
  .phs-row--single .phs-plate { flex: 0 1 50%; }
  .phs-plate { min-width: 0; margin: 0; }
  .phs-plate-btn { display: block; width: 100%; padding: 0; border: 0; background: #1c1814; cursor: zoom-in; overflow: hidden; }
  .phs-plate-btn img { display: block; width: 100%; height: auto; transition: transform 0.9s ease, opacity 0.4s; }
  .phs-plate-btn:hover img { transform: scale(1.02); }
  .phs-plate figcaption { margin-top: 0.85rem; font-size: 13px; letter-spacing: 0.3px; color: rgba(233, 226, 214, 0.6); }
  .phs-plate figcaption span { display: inline-block; margin-right: 0.6rem; font-family: 'Fraunces', Georgia, serif; color: #e2865a; letter-spacing: 1.5px; }

  .phs-end { padding: 3rem 0 6rem; border-top: 1px solid rgba(255, 255, 255, 0.08); }
  .phs-note { font-size: 14px; color: rgba(233, 226, 214, 0.5); margin-bottom: 2.5rem; }
  .phs-links { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem; }
  .phs-next { display: block; }
  .phs-next span { display: block; font-size: 12px; letter-spacing: 1.4px; text-transform: uppercase; color: rgba(255, 255, 255, 0.5); margin-bottom: 0.5rem; }
  .phs-next strong { font-family: 'Fraunces', Georgia, serif; font-size: clamp(28px, 4vw, 44px); font-weight: 500; letter-spacing: -1px; color: #fff; transition: color 0.3s; }
  .phs-next:hover strong { color: #e2865a; }
  .phs-all { font-size: 14px; font-weight: 600; color: #e2865a; }
  .phs-all:hover { color: #f0a47a; }

  @media (max-width: 700px) {
    .phs-hero { padding: 8rem 0 2.5rem; }
    .phs-wrap { padding: 0 1rem; gap: 2.25rem; }
    .phs-row--pair { flex-direction: column; gap: 2.25rem; }
    .phs-row--pair .phs-plate { flex: none !important; width: 100%; }
    .phs-row--single .phs-plate { flex: 0 1 100%; }
  }
</style>
