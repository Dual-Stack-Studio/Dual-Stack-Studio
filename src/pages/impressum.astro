---
import LegalLayout from '../layouts/LegalLayout.astro';
import type { Lang } from '../i18n';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const de = lang === 'de';
const lastUpdated = de ? '21. September 2026' : 'September 21, 2026';
const RIS = 'https://www.ris.bka.gv.at/GeltendeFassung.wxe?Abfrage=Bundesnormen&Gesetzesnummer=10007517';
---

<LegalLayout
  lang={lang}
  title="Impressum — Dual-Stack Studio"
  description={de ? 'Rechtliche Hinweise und Pflichtangaben für Dual-Stack Studio (Impressum, § 5 ECG, § 63 GewO, § 25 MedienG).' : 'Legal notice and mandatory disclosures for Dual-Stack Studio (Impressum, § 5 ECG, § 63 GewO, § 25 MedienG).'}
>
  <span class="legal-eyebrow">{de ? 'Rechtliches' : 'Legal'}</span>
  <h1>Impressum</h1>
  <p class="legal-updated">{de ? 'Zuletzt aktualisiert' : 'Last updated'}: {lastUpdated}</p>

  {!de && (
    <>
      <p>
        Legal notice and disclosures in accordance with § 5 of the Austrian E-Commerce Act (ECG),
        § 63 of the Trade Regulation Act (GewO) and § 25 of the Media Act (MedienG).
      </p>

      <h2>Service provider</h2>
      <p>
        Sebastian Rodriguez<br />
        Sole proprietor (Einzelunternehmer), trading as “Dual-Stack Studio”<br />
        Linzer Straße 7/3<br />
        3350 Haag<br />
        Austria
      </p>
      <p>
        Dual-Stack Studio is a working name, not a separately registered legal entity. The business is
        not entered in the commercial register (Firmenbuch).
      </p>

      <h2>Contact</h2>
      <p>
        Email: <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
      </p>

      <h2>Trade licences (Gewerbe)</h2>
      <p>All three are free trades (freie Gewerbe), registered in the Trade Information System Austria (GISA):</p>
      <ul>
        <li>
          Dienstleistungen in der automatischen Datenverarbeitung und Informationstechnik
          (IT services) — GISA number 40150468
        </li>
        <li>Werbeagentur (advertising agency) — GISA number 40150451</li>
        <li>Berufsfotograf (professional photographer) — GISA number 40150383</li>
      </ul>
      <p>
        Business location (Standort): Linzer Straße 7, Tür 3, 3350 Haag, Austria. Trade licences
        valid since September 18, 2026. Registrations can be verified free of charge at
        <a href="https://www.gisa.gv.at/abfrage" target="_blank" rel="noopener">gisa.gv.at/abfrage</a>.
      </p>

      <h2>Supervisory authority</h2>
      <p>
        Bezirkshauptmannschaft Amstetten (Trade Authority)<br />
        Preinsbacher Straße 11, 3300 Amstetten, Austria
      </p>

      <h2>Chamber membership</h2>
      <p>
        Wirtschaftskammer Niederösterreich (Lower Austrian Chamber of Commerce) —
        <a href="https://www.wko.at/noe" target="_blank" rel="noopener">wko.at/noe</a>
      </p>

      <h2>Applicable professional regulations</h2>
      <p>
        Gewerbeordnung 1994 (GewO), available in the Austrian legal information system:
        <a href={RIS} target="_blank" rel="noopener">ris.bka.gv.at</a>.
      </p>

      <h2>Disclosure under § 25 Media Act</h2>
      <p>
        Media owner and publisher: Sebastian Rodriguez, 3350 Haag, Austria.<br />
        Business purpose: IT services and software development, advertising and marketing services,
        and professional photography.<br />
        Editorial line: presentation of the services, projects and photographic work of Dual-Stack
        Studio, together with a personal work and travel journal.
      </p>

      <p class="legal-disclaimer">
        This notice follows the mandatory disclosure rules for Austrian business websites but hasn't
        been reviewed by a lawyer. If your situation changes (for example a VAT ID is assigned, or the
        business address changes), this page should be updated.
      </p>
    </>
  )}

  {de && (
    <>
      <p>
        Rechtliche Hinweise und Pflichtangaben gemäß § 5 E-Commerce-Gesetz (ECG), § 63 Gewerbeordnung (GewO)
        und § 25 Mediengesetz (MedienG).
      </p>

      <h2>Diensteanbieter</h2>
      <p>
        Sebastian Rodriguez<br />
        Einzelunternehmer, tätig unter der Bezeichnung „Dual-Stack Studio“<br />
        Linzer Straße 7/3<br />
        3350 Haag<br />
        Österreich
      </p>
      <p>
        Dual-Stack Studio ist eine Arbeitsbezeichnung und keine eigenständig registrierte juristische Person.
        Das Unternehmen ist nicht im Firmenbuch eingetragen.
      </p>

      <h2>Kontakt</h2>
      <p>
        E-Mail: <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
      </p>

      <h2>Gewerbeberechtigungen</h2>
      <p>Alle drei sind freie Gewerbe, eingetragen im Gewerbeinformationssystem Austria (GISA):</p>
      <ul>
        <li>
          Dienstleistungen in der automatischen Datenverarbeitung und Informationstechnik
          (IT-Dienstleistungen) — GISA-Zahl 40150468
        </li>
        <li>Werbeagentur — GISA-Zahl 40150451</li>
        <li>Berufsfotograf — GISA-Zahl 40150383</li>
      </ul>
      <p>
        Standort: Linzer Straße 7, Tür 3, 3350 Haag, Österreich. Die Gewerbeberechtigungen bestehen seit
        18. September 2026. Die Eintragungen können kostenlos unter
        <a href="https://www.gisa.gv.at/abfrage" target="_blank" rel="noopener">gisa.gv.at/abfrage</a> überprüft werden.
      </p>

      <h2>Aufsichtsbehörde</h2>
      <p>
        Bezirkshauptmannschaft Amstetten (Gewerbebehörde)<br />
        Preinsbacher Straße 11, 3300 Amstetten, Österreich
      </p>

      <h2>Kammerzugehörigkeit</h2>
      <p>
        Wirtschaftskammer Niederösterreich —
        <a href="https://www.wko.at/noe" target="_blank" rel="noopener">wko.at/noe</a>
      </p>

      <h2>Anwendbare berufsrechtliche Vorschriften</h2>
      <p>
        Gewerbeordnung 1994 (GewO), abrufbar im Rechtsinformationssystem des Bundes:
        <a href={RIS} target="_blank" rel="noopener">ris.bka.gv.at</a>.
      </p>

      <h2>Offenlegung gemäß § 25 Mediengesetz</h2>
      <p>
        Medieninhaber und Herausgeber: Sebastian Rodriguez, 3350 Haag, Österreich.<br />
        Unternehmensgegenstand: IT-Dienstleistungen und Softwareentwicklung, Werbe- und
        Marketingdienstleistungen sowie Berufsfotografie.<br />
        Grundlegende Richtung: Darstellung der Leistungen, Projekte und fotografischen Arbeiten von
        Dual-Stack Studio sowie ein persönliches Arbeits- und Reisejournal.
      </p>

      <p class="legal-disclaimer">
        Diese Angaben folgen den gesetzlichen Offenlegungspflichten für österreichische Unternehmens-Websites,
        wurden aber nicht von einem Anwalt geprüft. Ändern sich Ihre Umstände (etwa durch die Vergabe einer
        UID-Nummer oder eine neue Geschäftsadresse), sollte diese Seite aktualisiert werden.
      </p>
    </>
  )}
</LegalLayout>
