---
import Layout from '../../layouts/Layout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { l } from '../../i18n';
import type { Lang } from '../../i18n';
import ContactLinks from '../../components/ContactLinks.astro';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const de = lang === 'de';
const es = lang === 'es';

// [file, width, height, English alt, German alt, Spanish alt]
type Raw = [string, number, number, string, string, string];
const outsideRaw: Raw[] = [
  ['house-banner.jpg', 1080, 1350, 'The house from the street, with the Mister Jin banner', 'Das Haus von der Straße aus, mit dem Mister-Jin-Banner', 'La casa desde la calle, con el cartel de Mister Jin'],
  ['terrace-wide.jpg', 1350, 900, 'The terrace in the sun, with umbrellas and tables', 'Die Terrasse in der Sonne, mit Schirmen und Tischen', 'La terraza al sol, con sombrillas y mesas'],
  ['lanterns-facade.jpg', 1080, 1350, 'Lanterns on the facade beside the arched windows', 'Laternen an der Fassade neben den Bogenfenstern', 'Faroles en la fachada junto a las ventanas en arco'],
  ['lantern-sky.jpg', 1350, 900, 'A lantern against the sky, with the town behind it', 'Eine Laterne vor blauem Himmel, dahinter der Ort', 'Un farol contra el cielo, con el pueblo detrás'],
  ['terrace-umbrella.jpg', 1080, 1350, 'The terrace railing, a lantern and a folded umbrella', 'Das Terrassengeländer, eine Laterne und ein geschlossener Schirm', 'La baranda de la terraza, un farol y una sombrilla cerrada'],
  ['lantern-street.jpg', 1080, 1350, 'A lantern at the terrace, looking down the street', 'Eine Laterne an der Terrasse mit Blick die Straße hinunter', 'Un farol en la terraza, mirando hacia la calle'],
];
const insideRaw: Raw[] = [
  ['buffet-view.jpg', 1350, 900, 'The buffet along the green wall', 'Das Buffet an der grünen Wand', 'El buffet junto a la pared verde'],
  ['buffet-overview.jpg', 1350, 900, 'The whole buffet, with calligraphy on the wall', 'Das ganze Buffet, mit Kalligrafie an der Wand', 'El buffet completo, con caligrafía en la pared'],
  ['buffet-sushi-fruit.jpg', 1350, 900, 'The corner with sushi, fruit and sauces', 'Die Ecke mit Sushi, Obst und Saucen', 'El rincón con sushi, fruta y salsas'],
  ['buffet-sushi-salad.jpg', 1350, 900, 'Sushi and salads under the glass cover', 'Sushi und Salate unter der Glashaube', 'Sushi y ensaladas bajo la campana de vidrio'],
  ['buffet-starters.jpg', 1350, 900, 'Starters and hot dishes on the buffet', 'Vorspeisen und warme Gerichte am Buffet', 'Entradas y platos calientes en el buffet'],
  ['buffet-prawn-crackers.jpg', 1350, 900, 'Prawn crackers and fried starters', 'Krabbenchips und frittierte Vorspeisen', 'Chips de camarón y entradas fritas'],
  ['buffet-noodles-rice.jpg', 1350, 900, 'Noodles, rice and vegetables', 'Nudeln, Reis und Gemüse', 'Fideos, arroz y verduras'],
  ['buffet-beef-prawns.jpg', 1350, 900, 'Beef and prawn dishes, close up', 'Rind- und Garnelengerichte aus der Nähe', 'Platos de carne y camarones, de cerca'],
  ['dining-room.jpg', 1350, 900, 'The dining room with a mountain painting', 'Der Gastraum mit einem Berggemälde', 'El salón con una pintura de montañas'],
];

const toItems = (raw: Raw[]) =>
  raw.map(([file, w, h, en, deAlt, esAlt]) => ({ src: `/images/work/mister-jin/gallery/${file}`, w, h, alt: de ? deAlt : es ? esAlt : en }));
const outside = toItems(outsideRaw);
const inside = toItems(insideRaw);
const hero = inside[0];

const copy = {
  en: {
    title: 'Asia Restaurant Mister Jin — Dual-Stack Studio',
    description: 'Photography for the Google profile of Asia Restaurant Mister Jin: the house, the terrace and the lunch buffet.',
    back: '← Back to work',
    eyebrow: 'Photography · Google profile', h1: 'Asia Restaurant Mister Jin',
    intro: 'New photos of the house, the terrace and the lunch buffet, taken for the restaurant\'s Google profile. That is where most people decide where to eat: they search, look through the photos and choose the place that looks best.',
    whyEyebrow: 'The idea', whyTitle: 'Photos that bring people in',
    why: [
      ['Seen on the map', 'When someone searches for a restaurant nearby, Google shows the profile and its photos first. According to Google, businesses with photos get more requests for directions and more clicks to their website.'],
      ['The buffet as it is', 'The dishes, the sushi and the salads, photographed in daylight, so people know what to expect before they arrive.'],
      ['Easy to recognise', 'The house, the lanterns and the terrace from the street, so first-time guests recognise the place as soon as they get there.'],
    ],
    outEyebrow: 'Outside', outTitle: 'The house and the terrace',
    outLead: 'The front with its banner, the lanterns and the terrace in the sun: what people see from the street.',
    inEyebrow: 'Inside', inTitle: 'The buffet and the dining room',
    inLead: 'The lunch buffet from one end to the other (starters, sushi, hot dishes and fruit) and the dining room.',
    ctaTitle: 'Does your Google profile show your place at its best?',
    ctaText: 'We photograph restaurants, shops and small businesses for Google, Instagram and their website.',
    ctaBtn: 'Say hello',
    footTagline: 'Stories for family businesses and small places doing real work — content, storytelling, and the web presence behind it.',
    navTitle: 'Navigate', navWork: 'Work', navServices: 'Services', navAbout: 'About', navWeb: 'Web & Full-Stack ↗',
    legalTitle: 'Legal', privacy: 'Privacy Policy', terms: 'Terms of Service', contactTitle: 'Get in touch',
    rights: '© 2026 Dual-Stack Studio. Independently operated.', builtWith: 'Built with Astro, deployed on Vercel.',
    close: 'Close', prev: 'Previous photo', next: 'Next photo',
  },
  de: {
    title: 'Asia Restaurant Mister Jin — Dual-Stack Studio',
    description: 'Fotografie für das Google-Profil des Asia Restaurant Mister Jin: das Haus, die Terrasse und das Mittagsbuffet.',
    back: '← Zurück zu den Arbeiten',
    eyebrow: 'Fotografie · Google-Profil', h1: 'Asia Restaurant Mister Jin',
    intro: 'Neue Fotos vom Haus, der Terrasse und dem Mittagsbuffet, aufgenommen für das Google-Profil des Restaurants. Dort entscheiden die meisten, wo sie essen: Sie suchen, sehen sich die Fotos an und wählen das Lokal, das am besten aussieht.',
    whyEyebrow: 'Die Idee', whyTitle: 'Fotos, die Gäste ins Lokal bringen',
    why: [
      ['Auf der Karte gesehen', 'Wer in der Nähe ein Restaurant sucht, sieht bei Google zuerst das Profil mit seinen Fotos. Laut Google erhalten Unternehmen mit Fotos mehr Routenanfragen und mehr Klicks auf ihre Website.'],
      ['Das Buffet, wie es ist', 'Die Gerichte, das Sushi und die Salate bei Tageslicht fotografiert, damit man schon vorher weiß, was einen erwartet.'],
      ['Leicht wiederzuerkennen', 'Das Haus, die Laternen und die Terrasse von der Straße aus, damit neue Gäste das Lokal bei der Ankunft gleich erkennen.'],
    ],
    outEyebrow: 'Außen', outTitle: 'Das Haus und die Terrasse',
    outLead: 'Die Fassade mit dem Banner, die Laternen und die Terrasse in der Sonne: das, was man von der Straße aus sieht.',
    inEyebrow: 'Innen', inTitle: 'Das Buffet und der Gastraum',
    inLead: 'Das Mittagsbuffet von einem Ende zum anderen (Vorspeisen, Sushi, warme Gerichte und Obst) und der Gastraum.',
    ctaTitle: 'Zeigt dein Google-Profil dein Lokal von seiner besten Seite?',
    ctaText: 'Wir fotografieren Restaurants, Geschäfte und kleine Betriebe für Google, Instagram und ihre Website.',
    ctaBtn: 'Melde dich',
    footTagline: 'Geschichten für Familienbetriebe und kleine Orte, die echte Arbeit leisten — Content, Storytelling und der Webauftritt dahinter.',
    navTitle: 'Navigation', navWork: 'Arbeiten', navServices: 'Leistungen', navAbout: 'Über mich', navWeb: 'Web & Full-Stack ↗',
    legalTitle: 'Rechtliches', privacy: 'Datenschutzerklärung', terms: 'Nutzungsbedingungen', contactTitle: 'Kontakt',
    rights: '© 2026 Dual-Stack Studio. Unabhängig betrieben.', builtWith: 'Erstellt mit Astro, bereitgestellt auf Vercel.',
    close: 'Schließen', prev: 'Vorheriges Foto', next: 'Nächstes Foto',
  },
  es: {
    title: 'Asia Restaurant Mister Jin — Dual-Stack Studio',
    description: 'Fotografía para el perfil de Google del Asia Restaurant Mister Jin: la casa, la terraza y el buffet del mediodía.',
    back: '← Volver al trabajo',
    eyebrow: 'Fotografía · Perfil de Google', h1: 'Asia Restaurant Mister Jin',
    intro: 'Fotos nuevas de la casa, la terraza y el buffet del mediodía, hechas para el perfil de Google del restaurante. Ahí es donde la mayoría decide dónde comer: busca, mira las fotos y elige el lugar que mejor se ve.',
    whyEyebrow: 'La idea', whyTitle: 'Fotos que traen gente al local',
    why: [
      ['Visible en el mapa', 'Cuando alguien busca un restaurante cerca, Google muestra primero el perfil con sus fotos. Según Google, los negocios con fotos reciben más solicitudes de indicaciones y más clics a su sitio web.'],
      ['El buffet tal como es', 'Los platos, el sushi y las ensaladas, fotografiados con luz de día, para que la gente sepa qué esperar antes de llegar.'],
      ['Fácil de reconocer', 'La casa, los faroles y la terraza desde la calle, para que quien viene por primera vez reconozca el lugar apenas llega.'],
    ],
    outEyebrow: 'Exterior', outTitle: 'La casa y la terraza',
    outLead: 'El frente con su cartel, los faroles y la terraza al sol: lo que se ve desde la calle.',
    inEyebrow: 'Interior', inTitle: 'El buffet y el salón',
    inLead: 'El buffet del mediodía de punta a punta (entradas, sushi, platos calientes y fruta) y el salón.',
    ctaTitle: '¿Tu perfil de Google muestra tu negocio en su mejor versión?',
    ctaText: 'Fotografiamos restaurantes, tiendas y pequeños negocios para Google, Instagram y su sitio web.',
    ctaBtn: 'Escríbenos',
    footTagline: 'Historias para negocios familiares y lugares pequeños que hacen un trabajo real — contenido, storytelling y la presencia web detrás.',
    navTitle: 'Navegación', navWork: 'Trabajo', navServices: 'Servicios', navAbout: 'Sobre mí', navWeb: 'Web y full-stack ↗',
    legalTitle: 'Legal', privacy: 'Política de Privacidad', terms: 'Términos de Servicio', contactTitle: 'Contacto',
    rights: '© 2026 Dual-Stack Studio. Operado de forma independiente.', builtWith: 'Construido con Astro, desplegado en Vercel.',
    close: 'Cerrar', prev: 'Foto anterior', next: 'Foto siguiente',
  },
};
const c = copy[lang];
---

<Layout title={c.title} description={c.description} lang={lang} langs={['en', 'de', 'es']}>

  <header class="mj-header">
    <a href={l(lang, '/')} class="mj-brand">
      <img src="/logo.svg" alt="Dual-Stack Studio" width="40" height="40" style="border-radius: 25%;" />
      <span>Dual-Stack Studio</span>
    </a>
    <span class="mj-header-right">
      <LangSwitch lang={lang} langs={['en', 'de', 'es']} />
      <a href={l(lang, '/#work')} class="mj-back">{c.back}</a>
    </span>
  </header>

  <section class="mj-hero">
    <img class="mj-hero-img" src={hero.src} alt={hero.alt} width={hero.w} height={hero.h} />
    <div class="mj-hero-scrim"></div>
    <div class="mj-hero-content">
      <span class="mj-eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p>{c.intro}</p>
    </div>
  </section>

  <!-- why the photos were made: the Google profile -->
  <section class="mj-section mj-section--alt">
    <div class="mj-inner">
      <span class="mj-eyebrow mj-eyebrow--accent">{c.whyEyebrow}</span>
      <h2 class="mj-section-title">{c.whyTitle}</h2>
      <div class="mj-why">
        {c.why.map(([t, p], i) => (
          <div class="mj-why-item">
            <span class="mj-why-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t}</h3>
            <p>{p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mj-section">
    <div class="mj-inner">
      <span class="mj-eyebrow mj-eyebrow--accent">{c.outEyebrow}</span>
      <h2 class="mj-section-title">{c.outTitle}</h2>
      <p class="mj-section-lead">{c.outLead}</p>
      <div class="mj-masonry">
        {outside.map((img) => (
          <div class="mj-item">
            <img src={img.src} alt={img.alt} width={img.w} height={img.h} loading="lazy" decoding="async" class="mj-lightbox-trigger" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mj-section mj-section--alt">
    <div class="mj-inner">
      <span class="mj-eyebrow mj-eyebrow--accent">{c.inEyebrow}</span>
      <h2 class="mj-section-title">{c.inTitle}</h2>
      <p class="mj-section-lead">{c.inLead}</p>
      <div class="mj-masonry">
        {inside.map((img) => (
          <div class="mj-item">
            <img src={img.src} alt={img.alt} width={img.w} height={img.h} loading="lazy" decoding="async" class="mj-lightbox-trigger" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mj-cta">
    <div class="mj-inner mj-cta-inner">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaText}</p>
      <a href={l(lang, '/#contact')} class="mj-cta-btn">{c.ctaBtn}</a>
    </div>
  </section>

  <footer class="mj-footer">
    <div class="mj-inner">
      <div class="mj-footer-grid">
        <div class="mj-footer-brand">
          <div class="mj-footer-logo">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="48" height="48" style="border-radius: 25%;" />
            Dual-Stack Studio
          </div>
          <p>{c.footTagline}</p>
        </div>

        <div class="mj-footer-col">
          <h4>{c.navTitle}</h4>
          <a href={l(lang, '/#work')}>{c.navWork}</a>
          <a href={l(lang, '/#services')}>{c.navServices}</a>
          <a href={l(lang, '/about')}>{c.navAbout}</a>
          <a href={l(lang, '/web')}>{c.navWeb}</a>
        </div>

        <div class="mj-footer-col">
          <h4>{c.legalTitle}</h4>
          <a href={l(lang, '/privacy-policy')}>{c.privacy}</a>
          <a href={l(lang, '/terms-of-service')}>{c.terms}</a>
          <a href={l(lang, '/impressum')}>Impressum</a>
        </div>

        <div class="mj-footer-col">
          <h4>{c.contactTitle}</h4>
          <ContactLinks theme="forest" />
        </div>
      </div>
      <div class="mj-footer-bottom">
        <p>{c.rights}</p>
        <p>{c.builtWith}</p>
      </div>
    </div>
  </footer>

  <div id="mj-lightbox" class="mj-lightbox" hidden>
    <button type="button" class="mj-lightbox-close" id="mj-lightbox-close" aria-label={c.close}><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M2 2l12 12M14 2 2 14"/></svg></button>
    <button type="button" class="mj-lightbox-nav mj-lightbox-prev" id="mj-lightbox-prev" aria-label={c.prev}><svg width="11" height="18" viewBox="0 0 11 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2 2 9l7 7"/></svg></button>
    <button type="button" class="mj-lightbox-nav mj-lightbox-next" id="mj-lightbox-next" aria-label={c.next}><svg width="11" height="18" viewBox="0 0 11 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 2l7 7-7 7"/></svg></button>
    <img src="" alt="" class="mj-lightbox-img" id="mj-lightbox-img" />
  </div>

  <style>
    :root {
      --night: #1a1a1a;
      --night-2: #202020;
      --terracotta: #c1663e;
      --terracotta-deep: #e2865a;
      --ink: #f6f1e8;
      --muted: #b5aca2;
    }

    .mj-inner { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }

    .mj-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      margin-bottom: 0.75rem;
    }
    .mj-eyebrow--accent { color: var(--terracotta-deep); }

    /* ---------- HEADER ---------- */
    .mj-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 0.7rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      background: rgba(26, 26, 26,0.55);
      backdrop-filter: blur(8px);
    }
    .mj-brand { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 16px; font-weight: 600; color: #fff; }
    .mj-header-right { display: inline-flex; align-items: center; gap: 1.5rem; color: rgba(255,255,255,0.9); }
    .mj-back { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.9); }
    .mj-back:hover { color: var(--terracotta); }

    /* ---------- HERO ---------- */
    .mj-hero {
      position: relative;
      min-height: 72vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: var(--night);
    }
    .mj-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .mj-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(26, 26, 26,0.35) 0%, rgba(26, 26, 26,0.4) 40%, rgba(26, 26, 26,0.92) 100%); }
    .mj-hero-content { position: relative; z-index: 5; max-width: 720px; padding: 6rem 2.5rem 4rem; }
    .mj-hero-content h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(36px, 6vw, 60px);
      font-weight: 600;
      letter-spacing: -1.5px;
      color: #fff;
      margin: 0 0 1rem;
      line-height: 1.08;
    }
    .mj-hero-content p { font-size: 16px; line-height: 1.7; color: rgba(255,255,255,0.85); margin: 0; }

    /* ---------- SECTIONS ---------- */
    .mj-section { padding: 5.5rem 0; background: var(--night); }
    .mj-section--alt { background: var(--night-2); }

    .mj-section-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(26px, 3.5vw, 36px);
      font-weight: 600;
      letter-spacing: -1px;
      color: var(--ink);
      margin: 0 0 0.75rem;
    }
    .mj-section-lead { font-size: 16px; color: var(--muted); max-width: 560px; margin: 0 0 2.5rem; line-height: 1.65; }

    /* the idea: three short points */
    .mj-why { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 2.25rem; }
    .mj-why-item {
      padding: 1.75rem 1.6rem;
      border-radius: 14px;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(226,134,90,0.22);
    }
    .mj-why-num { display: block; font-size: 13px; font-weight: 700; letter-spacing: 1px; color: var(--terracotta-deep); margin-bottom: 0.9rem; }
    .mj-why-item h3 { font-family: 'Fraunces', serif; font-size: 21px; font-weight: 600; color: var(--ink); margin: 0 0 0.6rem; }
    .mj-why-item p { font-size: 15px; line-height: 1.65; color: var(--muted); margin: 0; }

    .mj-masonry {
      column-count: 3;
      column-gap: 1.25rem;
    }
    .mj-item {
      break-inside: avoid;
      margin-bottom: 1.25rem;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 12px 30px -18px rgba(0,0,0,0.56);
    }
    .mj-item img {
      display: block;
      width: 100%;
      height: auto;
      cursor: pointer;
      transition: transform 0.5s ease;
    }
    .mj-item:hover img { transform: scale(1.03); }

    /* ---------- CTA ---------- */
    .mj-cta { background: #262626; padding: 5.5rem 0; text-align: center; }
    .mj-cta-inner { max-width: 560px; }
    .mj-cta h2 { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 34px); font-weight: 600; color: #fff; margin: 0 0 0.9rem; }
    .mj-cta p { font-size: 15px; color: rgba(255,255,255,0.75); margin: 0 0 2rem; line-height: 1.6; }
    .mj-cta-btn {
      display: inline-block;
      background: var(--terracotta);
      color: #fff;
      padding: 14px 32px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .mj-cta-btn:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    /* ---------- LIGHTBOX ---------- */
    .mj-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(5,5,5,0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
    }
    .mj-lightbox[hidden] { display: none; }
    .mj-lightbox-img { max-width: 100%; max-height: 100%; border-radius: 6px; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6); }
    .mj-lightbox-close {
      position: absolute;
      top: 24px;
      right: 28px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.08);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mj-lightbox-close:hover, .mj-lightbox-nav:hover { background: rgba(193,102,62,0.4); border-color: var(--terracotta); }
    .mj-lightbox-nav {
      position: absolute;
      top: 50%; transform: translateY(-50%);
      width: 44px; height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.08);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .mj-lightbox-prev { left: 18px; }
    .mj-lightbox-next { right: 18px; }
    @media (max-width: 700px) {
      .mj-lightbox-nav { top: auto; bottom: 16px; transform: none; }
      .mj-lightbox-prev { left: calc(50% - 58px); }
      .mj-lightbox-next { right: calc(50% - 58px); }
    }

    /* ---------- FOOTER ---------- */
    .mj-footer { background: var(--night); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; }
    .mj-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .mj-footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .mj-footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0; max-width: 300px; }
    .mj-footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .mj-footer-col a { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .mj-footer-col a:hover { color: var(--terracotta); }
    .mj-footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .mj-header { padding: 0.6rem 1.5rem; }
      .mj-why { grid-template-columns: 1fr; gap: 1rem; }
      .mj-masonry { column-count: 2; }
      .mj-footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .mj-hero-content { padding: 5rem 1.5rem 3rem; }
      .mj-masonry { column-count: 1; }
      .mj-footer-grid { grid-template-columns: 1fr; }
    }

    /* phones: wordmark on one line, back link as a plain arrow */
    @media (max-width: 560px) {
      .mj-header { padding: 0.6rem 1.1rem; }
      .mj-brand { font-size: 14px; gap: 8px; white-space: nowrap; }
      .mj-brand img { width: 34px; height: 34px; }
      .mj-header-right { gap: 0.9rem; }
      .mj-back { font-size: 0; }
      .mj-back::before { content: '←'; font-size: 22px; font-weight: 700; }
    }
  </style>

  <script>
    (function () {
      const lightbox = document.getElementById('mj-lightbox');
      const lightboxImg = document.getElementById('mj-lightbox-img') as HTMLImageElement | null;
      const closeBtn = document.getElementById('mj-lightbox-close');
      const prevBtn = document.getElementById('mj-lightbox-prev');
      const nextBtn = document.getElementById('mj-lightbox-next');
      if (!lightbox || !lightboxImg) return;

      const triggers = Array.from(document.querySelectorAll<HTMLImageElement>('.mj-lightbox-trigger'));
      let index = 0;

      function show(i: number) {
        if (!triggers.length) return;
        index = (i + triggers.length) % triggers.length;
        const img = triggers[index];
        lightboxImg!.src = img.currentSrc || img.src;
        lightboxImg!.alt = img.alt;
      }
      function open(i: number) {
        show(i);
        lightbox!.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lightbox!.hidden = true;
        lightboxImg!.src = '';
        document.body.style.overflow = '';
      }

      triggers.forEach((img, i) => img.addEventListener('click', () => open(i)));

      closeBtn?.addEventListener('click', close);
      prevBtn?.addEventListener('click', () => show(index - 1));
      nextBtn?.addEventListener('click', () => show(index + 1));
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => {
        if (lightbox!.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(index - 1);
        if (e.key === 'ArrowRight') show(index + 1);
      });
    })();
  </script>

</Layout>
