  <script>
    function initNetworkCluster(canvasId, lineColor) {
      const line = lineColor || '10, 10, 10';
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let particles = [];
      let raf;
      const mouse = { x: -9999, y: -9999 };

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      }

      function initParticles() {
        const count = Math.round((canvas.width * canvas.height) / 55000);
        particles = Array.from({ length: Math.max(14, Math.min(count, 30)) }, () => ({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.25,
          vy: (Math.random() - 0.5) * 0.25,
          r: Math.random() * 1.6 + 1,
        }));
      }

      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });

      canvas.addEventListener('mouseleave', () => {
        mouse.x = -9999;
        mouse.y = -9999;
      });

      function tick() {
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;

          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100) {
            p.x += (dx / dist) * 0.9;
            p.y += (dy / dist) * 0.9;
          }
        });

        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < 190) {
              ctx.strokeStyle = `rgba(${line}, ${(1 - dist / 190) * 0.35})`;
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }

        particles.forEach((p) => {
          const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
          glow.addColorStop(0, 'rgba(204, 255, 51, 0.5)');
          glow.addColorStop(1, 'rgba(204, 255, 51, 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#ccff33';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        });

        raf = requestAnimationFrame(tick);
      }

      resizeCanvas();
      initParticles();
      tick();

      window.addEventListener('resize', () => {
        cancelAnimationFrame(raf);
        resizeCanvas();
        initParticles();
        tick();
      });
    }

    initNetworkCluster('pd-network', '10, 10, 10');
    initNetworkCluster('pd-footer-network', '255, 255, 255');

    // Hero video: plays on hover, pauses and rewinds to the start on leave.
    document.querySelectorAll('.pd-hover-video').forEach((video) => {
      const wrap = video.closest('.pd-media');
      if (!wrap) return;
      wrap.addEventListener('mouseenter', () => video.play());
      wrap.addEventListener('mouseleave', () => {
        video.pause();
        video.currentTime = 0;
      });
    });

    // Lightbox: click any gallery/hero image to open it enlarged.
    (function () {
      const lightbox = document.getElementById('pd-lightbox');
      const lightboxImg = document.getElementById('pd-lightbox-img');
      const closeBtn = document.getElementById('pd-lightbox-close');
      if (!lightbox || !lightboxImg) return;

      function open(src, alt) {
        lightboxImg.src = src;
        lightboxImg.alt = alt || '';
        lightbox.hidden = false;
      }

      function close() {
        lightbox.hidden = true;
        lightboxImg.src = '';
      }

      document.querySelectorAll('.pd-lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
      });

      closeBtn?.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.hidden) close();
      });
    })();
  </script>
