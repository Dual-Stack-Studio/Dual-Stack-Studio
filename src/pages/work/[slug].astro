    }

    .pd-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      background: #c1663e;
      color: #fff;
      padding: 14px 24px;
      border-radius: 100px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      box-shadow: 0 12px 28px rgba(193, 102, 62, 0.3);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .pd-cta:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 36px rgba(193, 102, 62, 0.45);
    }

    .pd-cta i {
      font-style: normal;
    }

    .pd-cta-disabled {
      background: rgba(0, 0, 0, 0.06);
      color: #666;
      box-shadow: none;
      cursor: not-allowed;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
      gap: 2.5rem;
      padding-bottom: 3rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .footer-brand p {
      font-size: 14px;
      color: #999;
      line-height: 1.7;
      margin: 0;
