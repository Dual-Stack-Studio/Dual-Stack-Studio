---
import Layout from '../../layouts/WebLayout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { l } from '../../i18n';
import type { Lang } from '../../i18n';
import { projectSlugs, getProject, getOtherProjects } from '../../data/projects';

// English pages live at /work/<slug>; the German wrapper in src/pages/de/work/ reuses this
// component with lang="de" and supplies its own static paths.
export function getStaticPaths() {
  return projectSlugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug, lang = 'en' } = Astro.props as { slug: string; lang?: Lang };
const project = getProject(slug, lang);
const otherProjects = getOtherProjects(slug, lang);

const copy = {
  en: {
    backFull: '← Back to projects', proposal: 'Get proposal', hoverHint: '▶ Hover to play',
    prevImage: 'Previous image', nextImage: 'Next image', preview: 'preview',
    about: 'About the project', features: 'Key features', stack: 'Tech stack', status: 'Status',
    growth: 'Growth & Investment', visit: 'Visit live site', unavailable: 'Not publicly available',
    exploreEyebrow: 'Keep exploring', exploreTitle: 'More projects', prevProject: 'Previous project', nextProject: 'Next project',
    close: 'Close',
    footTagline: 'Independent full-stack studio. React, React Native and Node.js products, designed and shipped end to end.',
    navTitle: 'Navigate', navProjects: 'Projects', navServices: 'Services', navTeam: 'Team', navTestimonials: 'Testimonials',
    legalTitle: 'Legal', privacy: 'Privacy Policy', terms: 'Terms of Service',
    contactTitle: 'Get in touch', reply: 'Usually replies within 1–2 business days.',
    rights: '© 2026 Dual-Stack Studio. Independently operated.', builtWith: 'Built with Astro, deployed on Vercel. Site under active development.',
  },
  de: {
    backFull: '← Zurück zu den Projekten', proposal: 'Angebot anfragen', hoverHint: '▶ Zum Abspielen darüberfahren',
    prevImage: 'Vorheriges Bild', nextImage: 'Nächstes Bild', preview: 'Vorschau',
    about: 'Über das Projekt', features: 'Kernfunktionen', stack: 'Tech-Stack', status: 'Status',
    growth: 'Wachstum & Investition', visit: 'Live-Seite besuchen', unavailable: 'Nicht öffentlich verfügbar',
    exploreEyebrow: 'Weiter entdecken', exploreTitle: 'Weitere Projekte', prevProject: 'Vorheriges Projekt', nextProject: 'Nächstes Projekt',
    close: 'Schließen',
    footTagline: 'Unabhängiges Full-Stack-Studio. Produkte mit React, React Native und Node.js — von der Gestaltung bis zum Livegang aus einer Hand.',
    navTitle: 'Navigation', navProjects: 'Projekte', navServices: 'Leistungen', navTeam: 'Team', navTestimonials: 'Referenzen',
    legalTitle: 'Rechtliches', privacy: 'Datenschutzerklärung', terms: 'Nutzungsbedingungen',
    contactTitle: 'Kontakt', reply: 'Antwortet in der Regel innerhalb von 1–2 Werktagen.',
    rights: '© 2026 Dual-Stack Studio. Unabhängig betrieben.', builtWith: 'Erstellt mit Astro, bereitgestellt auf Vercel. Website in aktiver Weiterentwicklung.',
  },
};
const c = copy[lang];
---

<Layout title={`${project.title} — Dual-Stack Studio`} description={project.tagline} lang={lang}>
  <header id="pd-header" style="position: sticky; top: 0; padding: 1.5rem 3rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; z-index: 100; background: rgba(92, 92, 92, 0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
    <a href={l(lang, '/web')} class="pd-header-logo" style="font-size: 20px; font-weight: 800; letter-spacing: -0.5px; display: flex; align-items: center; gap: 10px; text-decoration: none; color: #ffffff; flex-shrink: 0;">
      <img src="/logo.svg" alt="Dual-Stack Studio" width="30" height="30" style="border-radius: 7px; flex-shrink: 0;" />
      <span class="pd-header-logo-text">Dual-Stack</span>
    </a>
    <a href={l(lang, '/web#work')} class="pd-back-link" style="font-size: 14px; font-weight: 600; color: #ccc; text-decoration: none; white-space: nowrap;">
      <span class="pd-back-full">{c.backFull}</span>
      <span class="pd-back-short">←</span>
    </a>
    <span class="pd-header-right">
      <LangSwitch lang={lang} />
      <a href={l(lang, '/web#contact')} class="pd-header-cta" style="background: #c1663e; color: #fff; padding: 12px 26px; border-radius: 100px; text-decoration: none; font-size: 14px; font-weight: 600; box-shadow: 0 8px 20px rgba(193, 102, 62, 0.3); white-space: nowrap; flex-shrink: 0;">
        {c.proposal}
      </a>
    </span>
  </header>

  <div class="pd-page-bg">
  <main class="pd-main-bg" style="position: relative; min-height: 100vh; padding: 5rem 2rem 7rem; overflow: hidden;">
    <canvas id="pd-network" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;"></canvas>

    <div style="max-width: 1000px; margin: 0 auto; position: relative; z-index: 1;">

      <span class="pd-client">{project.client}</span>
      <h1 class="pd-title">{project.title}</h1>
      <p class="pd-tagline">{project.tagline}</p>

      <div class="pd-media">
        {project.video ? (
          <div class="pd-media-video">
            <video
              class={`pd-hover-video${project.portraitVideo ? ' pd-hover-video-portrait' : ''}`}
              src={project.video}
              poster={project.image}
              muted
              loop
              playsinline
              preload="metadata"
            />
            <span class="pd-media-play-hint">{c.hoverHint}</span>
          </div>
        ) : project.image ? (
          <img src={project.image} alt={project.title} class="pd-lightbox-trigger" />
        ) : (
          <div class="pd-media-placeholder">
            <span>{project.title}</span>
          </div>
        )}
      </div>

      <div class="pd-gallery-wrap">
        <button type="button" class="pd-gallery-nav pd-gallery-prev" aria-label={c.prevImage}>‹</button>
        <div class="pd-gallery" id="pd-gallery">
          {(project.gallery ?? Array(6).fill(project.image)).map((src, i) => (
            <div class="pd-gallery-item">
              {src ? (
                <img src={src} alt={`${project.title} ${c.preview} ${i + 1}`} class="pd-lightbox-trigger" />
              ) : (
                <div class="pd-shot-placeholder"><span>{project.title}</span></div>
              )}
            </div>
          ))}
        </div>
        <button type="button" class="pd-gallery-nav pd-gallery-next" aria-label={c.nextImage}>›</button>
      </div>

      <div class="pd-grid">
        <div class="pd-main">
          <h2>{c.about}</h2>
          <p class="pd-desc">{project.description}</p>

          <h2>{c.features}</h2>
          <ul class="pd-features">
            {project.features.map((f) => <li>{f}</li>)}
          </ul>
        </div>

        <aside class="pd-sidebar">
          <div class="pd-sidebar-block">
            <h3>{c.stack}</h3>
            <div class="pd-stack">
              {project.stack.map((s) => <span>{s}</span>)}
            </div>
          </div>

          <div class="pd-sidebar-block">
            <h3>{c.status}</h3>
            <p>{project.status}</p>
          </div>

          {project.growthPitch && (
            <div class="pd-sidebar-block pd-growth-block">
              <h3>{c.growth}</h3>
              <p>{project.growthPitch}</p>
            </div>
          )}

          {project.url ? (
            <a href={project.url} target="_blank" rel="noopener" class="pd-cta">{c.visit} <i>↗</i></a>
          ) : (
            <span class="pd-cta pd-cta-disabled">{c.unavailable}</span>
          )}
        </aside>
      </div>

      <div class="pd-more">
        <div class="pd-more-head">
          <span class="pd-client">{c.exploreEyebrow}</span>
          <h2 class="pd-more-title">{c.exploreTitle}</h2>
        </div>
        <div class="pd-more-carousel-wrap">
          <button type="button" class="pd-gallery-nav pd-more-prev" aria-label={c.prevProject}>‹</button>
          <div class="pd-more-grid" id="pd-more-grid">
            {otherProjects.map((p) => (
              <a href={l(lang, `/work/${p.slug}`)} class="pd-more-card">
                <div class="pd-more-card-media">
                  {p.image ? (
                    <img src={p.image} alt={p.title} />
                  ) : (
                    <div class="pd-shot-placeholder"><span>{p.title}</span></div>
                  )}
                </div>
                <span class="pd-more-card-client">{p.client}</span>
                <h3 class="pd-more-card-title">{p.title}</h3>
                <p class="pd-more-card-tagline">{p.tagline}</p>
              </a>
            ))}
          </div>
          <button type="button" class="pd-gallery-nav pd-more-next" aria-label={c.nextProject}>›</button>
        </div>
      </div>

    </div>
  </main>

  <div id="pd-lightbox" class="pd-lightbox" hidden>
    <button type="button" class="pd-lightbox-close" id="pd-lightbox-close" aria-label={c.close}>×</button>
    <img src="" alt="" class="pd-lightbox-img" id="pd-lightbox-img" />
  </div>

  <footer style="position: relative; padding: 5rem 2rem 2.5rem; border-top: 1px solid rgba(255, 255, 255, 0.05); overflow: hidden;">
    <canvas id="pd-footer-network" style="position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; opacity: 0.6;"></canvas>
    <div style="max-width: 1200px; margin: 0 auto; position: relative; z-index: 1;">

      <div class="footer-grid">

        <div class="footer-brand">
          <div style="font-size: 20px; font-weight: 800; color: #ffffff; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px;">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="28" height="28" style="border-radius: 7px;" />
            Dual-Stack Studio
          </div>
          <p>{c.footTagline}</p>
        </div>

        <div class="footer-col">
          <h4>{c.navTitle}</h4>
          <a href={l(lang, '/web#work')}>{c.navProjects}</a>
          <a href={l(lang, '/web#services')}>{c.navServices}</a>
          <a href={l(lang, '/web#team')}>{c.navTeam}</a>
          <a href={l(lang, '/web#testimonials')}>{c.navTestimonials}</a>
        </div>

        <div class="footer-col">
          <h4>{c.legalTitle}</h4>
          <a href={l(lang, '/privacy-policy')}>{c.privacy}</a>
          <a href={l(lang, '/terms-of-service')}>{c.terms}</a>
          <a href={l(lang, '/impressum')}>Impressum</a>
        </div>

        <div class="footer-col">
          <h4>{c.contactTitle}</h4>
          <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
          <span class="footer-note">{c.reply}</span>
        </div>

      </div>

      <div class="footer-bottom">
        <p>{c.rights}</p>
        <p>{c.builtWith}</p>
      </div>

    </div>
  </footer>
  </div>

  <style>
    .pd-back-short {
      display: none;
    }

    .pd-header-right {
      display: inline-flex;
      align-items: center;
      gap: 1.25rem;
      color: #ccc;
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      #pd-header {
        padding: 1rem 1.25rem !important;
        gap: 0.75rem !important;
      }

      .pd-header-logo-text {
        display: none;
      }

      .pd-back-full {
        display: none;
      }

      .pd-back-short {
        display: inline;
        font-size: 18px;
        font-weight: 700;
      }

      .pd-header-right {
        gap: 0.75rem;
      }

      .pd-header-cta {
        padding: 10px 18px !important;
        font-size: 13px !important;
      }
    }

    @media (max-width: 360px) {
      #pd-header {
        padding: 1rem !important;
      }

      .pd-header-cta {
        padding: 10px 14px !important;
        font-size: 12px !important;
      }
    }

    .pd-page-bg {
      background-color: #eeeeee;
    }

    /* Main keeps its own light backdrop and only fades to dark in a fixed-height
       band right above its own bottom edge, so the fade always sits just before
       the footer regardless of how much content main has (short or long page).
       The fade is a full-width linear band (not a radial dome) so it reaches
       #0a0a0a evenly edge-to-edge, matching the footer's flat color with no seam. */
    .pd-main-bg {
      background-repeat: no-repeat;
      background-position: center top, center top, center bottom;
      background-size: auto, auto, 100% 420px;
      background-image:
        radial-gradient(circle at 85% 12%, rgba(193, 102, 62, 0.12) 0%, transparent 40%),
        radial-gradient(circle at 8% 10%, rgba(193, 102, 62, 0.06) 0%, transparent 32%),
        linear-gradient(180deg, transparent 0%, #0a0a0a 100%);
    }

    footer {
      background-color: #0a0a0a;
    }

    .pd-client {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #2f4436;
      margin-bottom: 0.75rem;
    }

    .pd-title {
      font-size: clamp(32px, 4vw, 46px);
      font-weight: 800;
      letter-spacing: -1.5px;
      color: #0a0a0a;
      margin: 0 0 0.75rem 0;
    }

    .pd-tagline {
      font-size: 16px;
      color: #555;
      font-style: italic;
      margin: 0 0 1rem 0;
    }

    .pd-desc {
      font-size: 16px;
      line-height: 1.75;
      color: #444;
      margin: 0;
    }

    .pd-media {
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 30px 80px -25px rgba(193, 102, 62, 0.25), 0 20px 50px -20px rgba(0, 0, 0, 0.15);
      border: 1px solid rgba(0, 0, 0, 0.08);
      margin-bottom: 2.5rem;
      transition: box-shadow 0.4s ease, transform 0.4s ease;
    }

    .pd-media:hover {
      transform: translateY(-4px);
      box-shadow: 0 40px 100px -20px rgba(193, 102, 62, 0.4), 0 25px 60px -20px rgba(0, 0, 0, 0.2);
    }

    .pd-media img {
      width: 100%;
      display: block;
    }

    .pd-media-video {
      position: relative;
    }

    .pd-hover-video {
      width: 100%;
      aspect-ratio: 16 / 9;
      object-fit: cover;
      display: block;
      background: #0a0a0a;
    }

    /* Mobile-app demo recordings are portrait (phone-shaped) — cropping them
       with object-fit: cover into a 16:9 box zooms in so far the UI becomes
       unreadable. Showing the full frame letterboxed reads as intentional
       (a phone screen framed in black) instead of broken. */
    .pd-hover-video-portrait {
      object-fit: contain;
    }

    .pd-media-play-hint {
      position: absolute;
      right: 16px;
      bottom: 16px;
      z-index: 2;
      padding: 0.5rem 0.9rem;
      border-radius: 100px;
      background: rgba(10, 10, 10, 0.65);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(193, 102, 62, 0.6);
      box-shadow: 0 0 16px rgba(193, 102, 62, 0.35), inset 0 0 8px rgba(193, 102, 62, 0.12);
      color: #eee;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.3px;
      opacity: 1;
      transition: opacity 0.3s ease;
      pointer-events: none;
    }

    .pd-media:hover .pd-media-play-hint {
      opacity: 0;
    }

    .pd-media-placeholder {
      aspect-ratio: 16 / 9;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2a2a2a 0%, #0a0a0a 140%);
    }

    .pd-media-placeholder span {
      font-size: 32px;
      font-weight: 800;
      color: #e2865a;
    }

    .pd-lightbox-trigger {
      cursor: zoom-in;
    }

    .pd-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(10, 10, 10, 0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
      animation: pdLightboxFade 0.2s ease;
    }

    .pd-lightbox[hidden] {
      display: none;
    }

    @keyframes pdLightboxFade {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    .pd-lightbox-img {
      max-width: 100%;
      max-height: 100%;
      border-radius: 10px;
      box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.6);
    }

    .pd-lightbox-close {
      position: absolute;
      top: 24px;
      right: 28px;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      font-size: 24px;
      line-height: 1;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .pd-lightbox-close:hover {
      background: rgba(193, 102, 62, 0.15);
      border-color: rgba(193, 102, 62, 0.4);
    }

    /* Bold horizontal-scrolling gallery strip — a filmstrip of extra shots,
       temporary placeholders until real screenshots are provided. */
    .pd-gallery-wrap {
      position: relative;
      margin: 0 0 3.5rem 0;
    }

    .pd-gallery {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      padding-bottom: 0.5rem;
      /* proximity, not mandatory — "mandatory" fights a JS-driven smooth
         scrollBy and can cancel/snap it right back to the start. */
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .pd-gallery::-webkit-scrollbar {
      display: none;
    }

    .pd-gallery-nav {
      position: absolute;
      top: calc(50% - 0.25rem);
      transform: translateY(-50%);
      z-index: 2;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid rgba(0, 0, 0, 0.08);
      background: rgba(255, 255, 255, 0.92);
      color: #0a0a0a;
      font-size: 22px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 10px 25px -10px rgba(0, 0, 0, 0.3);
      transition: background 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    }

    .pd-gallery-nav:hover {
      background: #c1663e;
      transform: translateY(-50%) scale(1.08);
    }

    .pd-gallery-nav:disabled {
      opacity: 0;
      pointer-events: none;
    }

    .pd-gallery-prev,
    .pd-more-prev {
      left: -14px;
    }

    .pd-gallery-next,
    .pd-more-next {
      right: -14px;
    }

    @media (max-width: 640px) {
      .pd-gallery-nav {
        width: 34px;
        height: 34px;
        font-size: 18px;
      }

      .pd-gallery-prev,
      .pd-more-prev {
        left: 4px;
      }

      .pd-gallery-next,
      .pd-more-next {
        right: 4px;
      }
    }

    .pd-gallery-item {
      flex: 0 0 auto;
      width: 300px;
      aspect-ratio: 16 / 10;
      border-radius: 14px;
      overflow: hidden;
      border: 1px solid rgba(0, 0, 0, 0.08);
      box-shadow: 0 16px 40px -20px rgba(0, 0, 0, 0.25);
      scroll-snap-align: start;
      transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    }

    .pd-gallery-item:hover {
      transform: translateY(-4px);
      border-color: rgba(193, 102, 62, 0.5);
      box-shadow: 0 20px 50px -18px rgba(193, 102, 62, 0.35);
    }

    .pd-gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .pd-shot-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, #2a2a2a 0%, #0a0a0a 140%);
    }

    .pd-shot-placeholder span {
      font-size: 20px;
      font-weight: 800;
      color: #e2865a;
    }

    .pd-grid {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 3.5rem;
    }

    .pd-main h2 {
      font-size: 22px;
      font-weight: 800;
      color: #0a0a0a;
      margin: 0 0 1rem 0;
    }

    .pd-main h2:not(:first-child) {
      margin-top: 2.5rem;
    }

    .pd-features {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.75rem;
    }

    .pd-features li {
      position: relative;
      padding-left: 1.6rem;
      font-size: 15px;
      line-height: 1.6;
      color: #333;
    }

    .pd-features li::before {
      content: '✓';
      position: absolute;
      left: 0;
      color: #e2865a;
      font-weight: 700;
    }

    .pd-sidebar-block {
      background: rgba(0, 0, 0, 0.03);
      border: 1px solid rgba(0, 0, 0, 0.08);
      border-radius: 14px;
      padding: 1.5rem;
      margin-bottom: 1.25rem;
      backdrop-filter: blur(8px);
      transition: border-color 0.3s ease, background 0.3s ease;
    }

    .pd-sidebar-block:hover {
      border-color: rgba(193, 102, 62, 0.5);
      background: rgba(0, 0, 0, 0.05);
    }

    .pd-sidebar-block h3 {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      color: #666;
      margin: 0 0 1rem 0;
    }

    .pd-sidebar-block p {
      font-size: 14px;
      color: #333;
      margin: 0;
      line-height: 1.6;
    }

    .pd-growth-block {
      background: linear-gradient(135deg, rgba(193, 102, 62, 0.1) 0%, rgba(193, 102, 62, 0.03) 100%);
      border: 1px solid rgba(193, 102, 62, 0.4);
    }

    .pd-growth-block:hover {
      border-color: rgba(193, 102, 62, 0.7);
      background: linear-gradient(135deg, rgba(193, 102, 62, 0.16) 0%, rgba(193, 102, 62, 0.05) 100%);
    }

    .pd-growth-block h3 {
      color: #8a4325;
    }

    .pd-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .pd-stack span {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3px;
      text-transform: uppercase;
      padding: 0.4rem 0.75rem;
      border-radius: 6px;
      background: rgba(193, 102, 62, 0.16);
      color: #8a4325;
      border: 1px solid rgba(193, 102, 62, 0.45);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease;
    }

    .pd-stack span:hover {
      transform: scale(1.08);
      background: rgba(193, 102, 62, 0.28);
    }

    /* .pd-more sits inside pd-main-bg's fade-to-#0a0a0a band at the bottom of
       the page, so it needs light text like the footer below it — not the
       dark palette the rest of the page uses on its light background. */
    /* No boxed background here — this blends straight into pd-main-bg's own
       fade-to-dark band, which is now sized (600px, see .pd-main-bg) to
       reliably cover this whole section regardless of how much content
       sits above it, so light text (here and on the cards below) always
       lands on dark. An earlier version put card text as a scrim directly
       on each thumbnail instead — dropped because several of these images
       are logo/branding shots that already carry their own text, and the
       two collided. */
    .pd-more {
      margin-top: 6rem;
    }

    .pd-more-head {
      margin-bottom: 2.5rem;
    }

    .pd-more-head .pd-client {
      color: #2f4436;
    }

    .pd-more-title {
      font-size: clamp(28px, 4vw, 40px);
      font-weight: 800;
      letter-spacing: -1.5px;
      color: #0a0a0a;
      margin: 0.5rem 0 0 0;
    }

    .pd-more-carousel-wrap {
      position: relative;
    }

    .pd-more-grid {
      display: flex;
      gap: 1.5rem;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }

    .pd-more-grid::-webkit-scrollbar {
      display: none;
    }

    .pd-more-card {
      display: block;
      flex: 0 0 auto;
      width: 300px;
      text-decoration: none;
      color: inherit;
      scroll-snap-align: start;
    }

    .pd-more-card-media {
      border-radius: 14px;
      overflow: hidden;
      aspect-ratio: 4 / 3;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 50px -25px rgba(0, 0, 0, 0.5);
      margin-bottom: 1rem;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
    }

    .pd-more-card:hover .pd-more-card-media {
      transform: translateY(-6px);
      box-shadow: 0 30px 60px -20px rgba(193, 102, 62, 0.4);
    }

    .pd-more-card-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .pd-more-card-client {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      color: #ccc;
      margin-bottom: 0.3rem;
      transition: color 0.3s ease;
    }

    .pd-more-card:hover .pd-more-card-client {
      color: #e2865a;
    }

    .pd-more-card-title {
      font-size: 19px;
      font-weight: 800;
      color: #ffffff;
      margin: 0 0 0.3rem 0;
      transition: color 0.3s ease;
    }

    .pd-more-card:hover .pd-more-card-title {
      color: #e2865a;
    }

    .pd-more-card-tagline {
      font-size: 12.5px;
      color: #ddd;
      margin: 0;
      line-height: 1.4;
    }

    @media (max-width: 800px) {
      .pd-more-card {
        width: 240px;
      }

      .pd-grid {
        grid-template-columns: 1fr;
      }

      .pd-gallery-item {
        width: 240px;
      }

      .pd-main-bg {
        padding: 4rem 1.25rem 5rem !important;
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 480px) {
      .pd-gallery-item {
        width: 200px;
      }

      .pd-more-card-title {
        font-size: 18px;
