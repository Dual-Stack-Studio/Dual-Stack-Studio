    .footer-bottom p {
      margin: 0;
      font-size: 12.5px;
      color: #666;
    }

    @media (max-width: 500px) {
      .footer-grid {
        grid-template-columns: 1fr;
      }

      .footer-bottom {
        flex-direction: column;
      }
    }

  </style>

  <script>
    function initNetworkCluster(canvasId, lineColor, opts) {
      const line = lineColor || '10, 10, 10';
      const { alpha = 0.35, width = 1, dist: maxDist = 190 } = opts || {};
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let particles = [];
      let raf;
      const mouse = { x: -9999, y: -9999 };

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width;
        canvas.height = rect.height;
      }

      function initParticles() {
        const count = Math.round((canvas.width * canvas.height) / 55000);
        particles = Array.from({ length: Math.max(14, Math.min(count, 30)) }, () => ({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.25,
          vy: (Math.random() - 0.5) * 0.25,
          r: Math.random() * 1.6 + 1,
        }));
      }

      function updateMouse(e) {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      }

      function resetMouse() {
        mouse.x = -9999;
        mouse.y = -9999;
      }

      // Pointer Events cover mouse, touch and pen in one API. Plain
      // mousemove/mouseleave never fire on touch, so the network only
      // reacted to a cursor and looked "reset" (stuck at -9999) on mobile.
      canvas.addEventListener('pointerdown', updateMouse);
      canvas.addEventListener('pointermove', updateMouse);
      canvas.addEventListener('pointerleave', resetMouse);
      canvas.addEventListener('pointercancel', resetMouse);

      function tick() {
        const w = canvas.width;
        const h = canvas.height;
        ctx.clearRect(0, 0, w, h);

        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;

          const dx = p.x - mouse.x;
          const dy = p.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 100) {
            p.x += (dx / dist) * 0.9;
            p.y += (dy / dist) * 0.9;
          }
        });

        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const dx = particles[i].x - particles[j].x;
            const dy = particles[i].y - particles[j].y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < maxDist) {
              ctx.strokeStyle = `rgba(${line}, ${(1 - dist / maxDist) * alpha})`;
              ctx.lineWidth = width;
              ctx.beginPath();
              ctx.moveTo(particles[i].x, particles[i].y);
              ctx.lineTo(particles[j].x, particles[j].y);
              ctx.stroke();
            }
          }
        }

        particles.forEach((p) => {
          const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.r * 4);
          glow.addColorStop(0, 'rgba(226, 134, 90, 0.5)');
          glow.addColorStop(1, 'rgba(226, 134, 90, 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r * 4, 0, Math.PI * 2);
          ctx.fill();

          ctx.fillStyle = '#e2865a';
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        });

        raf = requestAnimationFrame(tick);
      }

      resizeCanvas();
      initParticles();
      tick();

      // Mobile browsers fire `resize` when the URL bar collapses/expands on
      // scroll — a height-only change with no user-initiated layout change.
      // Re-randomizing particles on every one of those made the network look
      // like it kept resetting itself while someone was just scrolling past.
      let lastWidth = window.innerWidth;
      window.addEventListener('resize', () => {
        if (window.innerWidth === lastWidth) return;
        lastWidth = window.innerWidth;
        cancelAnimationFrame(raf);
        resizeCanvas();
        initParticles();
        tick();
      });
    }

    initNetworkCluster('pd-network', '193, 102, 62', { alpha: 0.5, width: 1.5, dist: 320 });
    initNetworkCluster('pd-footer-network', '226, 134, 90', { alpha: 0.6, width: 1.5, dist: 320 });

    // Hero video: plays on hover, pauses (but keeps its position) on leave —
    // re-hovering resumes instead of restarting from the beginning.
    document.querySelectorAll('.pd-hover-video').forEach((video) => {
      const wrap = video.closest('.pd-media');
      if (!wrap) return;
      wrap.addEventListener('mouseenter', () => video.play());
      wrap.addEventListener('mouseleave', () => video.pause());
    });

    // Shared carousel wiring: prev/next buttons scroll a track by one item +
    // gap, disabling at either end. Uses a manual rAF-driven scroll instead
    // of scrollTo(behavior:'smooth') because native smooth-scroll can get
    // cancelled or fought by CSS scroll-snap depending on the browser,
    // which made buttons look inert — driving scrollLeft by hand sidesteps
    // that entirely.
    function initCarousel(trackId, itemSelector, prevSelector, nextSelector) {
      const track = document.getElementById(trackId);
      const wrap = track?.parentElement;
      if (!track || !wrap) return;
      const prevBtn = wrap.querySelector(prevSelector);
      const nextBtn = wrap.querySelector(nextSelector);
      const firstItem = track.querySelector(itemSelector);
      if (!prevBtn || !nextBtn || !firstItem) return;

      function step() {
        const raw = getComputedStyle(track).columnGap || getComputedStyle(track).gap || '16';
        const gap = parseFloat(raw);
        return firstItem.getBoundingClientRect().width + (Number.isFinite(gap) ? gap : 16);
      }

      function maxScroll() {
        return track.scrollWidth - track.clientWidth;
      }

      function updateButtons() {
        prevBtn.disabled = track.scrollLeft <= 2;
        nextBtn.disabled = track.scrollLeft >= maxScroll() - 2;
      }

      let scrollAnim = null;
      function animateTo(target) {
        if (scrollAnim) cancelAnimationFrame(scrollAnim);
        const start = track.scrollLeft;
        const change = target - start;
        const duration = 350;
        const startTime = performance.now();
        function tick(now) {
          const t = Math.min(1, (now - startTime) / duration);
          const eased = 1 - Math.pow(1 - t, 3);
          track.scrollLeft = start + change * eased;
          scrollAnim = t < 1 ? requestAnimationFrame(tick) : null;
        }
        scrollAnim = requestAnimationFrame(tick);
      }

      function scrollToward(direction) {
        const target = Math.max(0, Math.min(maxScroll(), track.scrollLeft + direction * step()));
        animateTo(target);
      }

      prevBtn.addEventListener('click', () => scrollToward(-1));
      nextBtn.addEventListener('click', () => scrollToward(1));
      track.addEventListener('scroll', updateButtons, { passive: true });
      window.addEventListener('resize', updateButtons);
      updateButtons();
    }

    initCarousel('pd-gallery', '.pd-gallery-item', '.pd-gallery-prev', '.pd-gallery-next');
    initCarousel('pd-more-grid', '.pd-more-card', '.pd-more-prev', '.pd-more-next');

    // Lightbox: click any gallery/hero image to open it enlarged.
    (function () {
      const lightbox = document.getElementById('pd-lightbox');
      const lightboxImg = document.getElementById('pd-lightbox-img');
      const closeBtn = document.getElementById('pd-lightbox-close');
      if (!lightbox || !lightboxImg) return;

      function open(src, alt) {
        lightboxImg.src = src;
        lightboxImg.alt = alt || '';
        lightbox.hidden = false;
      }

      function close() {
        lightbox.hidden = true;
        lightboxImg.src = '';
      }

      document.querySelectorAll('.pd-lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => open(img.currentSrc || img.src, img.alt));
      });

      closeBtn?.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => {
        if (e.target === lightbox) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lightbox.hidden) close();
      });
    })();
  </script>
</Layout>
