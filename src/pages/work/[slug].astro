      word-break: break-word;
    }

    .footer-col a:hover {
      color: #e2865a;
    }

    .footer-note {
      display: block;
      font-size: 12px;
      color: #666;
      margin-top: 0.5rem;
    }

    .footer-bottom {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
