---
import Layout from '../layouts/Layout.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';
import austriaData from '../data/journal-austria.json';
import vietnamThailandData from '../data/journal-vietnam-thailand.json';
import australiaData from '../data/journal-australia.json';

const { lang = 'en' } = Astro.props as { lang?: Lang };

const austriaCover = '/images/journal/austria/austria-01.jpg';
const austriaCount = austriaData.photos.length;
const vtCover = '/images/journal/vietnam-thailand/vt-24.jpg';
const vtCount = vietnamThailandData.photos.length;
const auCover = '/images/journal/australia/au-28.jpg';
const auCount = australiaData.photos.length;

const copy = {
  en: {
    title: 'Journal — Dual-Stack Studio',
    description: 'Part travelogue, part about-us: the story of who we are, told one place at a time. Starting with Australia.',
    back: '← Back home',
    eyebrow: 'The Journal',
    h1: 'Who we are, one place at a time.',
    lead: 'Dual-Stack Studio is a small content and storytelling studio. We help farms, guesthouses and local businesses in the Alps be seen — through photography, film, and the web presence behind it.',
    body: `This is the part where most studios write a tidy "about us." We'd rather show you how we see. So instead, we're telling our own story the way we'd tell yours — a place at a time, in the order it happened. Each part below is a chapter. We're starting from the beginning and working forward.`,
    chaptersEyebrow: 'The chapters', chaptersTitle: 'Where the story goes',
    part: 'Part', cover: 'cover', readPart: 'Read this part', photos: 'photos',
    soonTitle: 'Coming soon',
    soonText: 'The next chapter is being written and edited. New parts land here as we finish them.',
    ctaTitle: 'Want your place told this way?',
    ctaText: "The eye we bring to our own story is the one we bring to yours. Let's talk about what you're building.",
    ctaBtn: 'Get in touch',
    footTagline: 'We tell the story of small places doing real work — content, storytelling, and the web presence behind it.',
    navTitle: 'Navigate', navWork: 'Work', navServices: 'Services', navTeam: 'Team', navJournal: 'Journal',
    legalTitle: 'Legal', privacy: 'Privacy Policy', terms: 'Terms of Service',
    contactTitle: 'Get in touch',
    rights: '© 2026 Dual-Stack Studio. Independently operated.', builtWith: 'Built with Astro, deployed on Vercel.',
    parts: [
      { title: 'Australia', meta: 'March – August 2025 · Brisbane & beyond', blurb: 'Months on the other side of the world — a city on the river, rainforest at the edge of it, and the work in between.' },
      { title: 'Vietnam & Thailand', meta: 'October 2025 · Southeast Asia', blurb: 'Three weeks across Vietnam and Thailand — karst rivers and quiet water, then the noise and neon of the streets.' },
      { title: 'Austria', meta: 'March – September 2026 · Upper Austria', blurb: 'A season in the Austrian countryside, front to back — from the first frost of March to the long light of late summer.' },
    ],
  },
  de: {
    title: 'Journal — Dual-Stack Studio',
    description: 'Halb Reisetagebuch, halb Über-uns: die Geschichte, wer wir sind, Ort für Ort erzählt. Wir beginnen mit Australien.',
    back: '← Zur Startseite',
    eyebrow: 'Das Journal',
    h1: 'Wer wir sind, Ort für Ort.',
    lead: 'Dual-Stack Studio ist ein kleines Content- und Storytelling-Studio. Wir helfen Bauernhöfen, Gästehäusern und lokalen Betrieben in den Alpen, gesehen zu werden — mit Fotografie, Film und dem Webauftritt dahinter.',
    body: 'Das ist der Teil, in dem die meisten Studios ein ordentliches „Über uns” schreiben. Wir zeigen dir lieber, wie wir sehen. Deshalb erzählen wir unsere eigene Geschichte so, wie wir deine erzählen würden — Ort für Ort, in der Reihenfolge, in der es passiert ist. Jeder Teil unten ist ein Kapitel. Wir beginnen am Anfang und arbeiten uns vorwärts.',
    chaptersEyebrow: 'Die Kapitel', chaptersTitle: 'Wohin die Geschichte führt',
    part: 'Teil', cover: 'Titelbild', readPart: 'Diesen Teil lesen', photos: 'Fotos',
    soonTitle: 'Demnächst',
    soonText: 'Das nächste Kapitel wird gerade geschrieben und bearbeitet. Neue Teile erscheinen hier, sobald sie fertig sind.',
    ctaTitle: 'Möchtest du deinen Ort auf diese Art erzählt haben?',
    ctaText: 'Den Blick, den wir auf unsere eigene Geschichte richten, richten wir auch auf deine. Sprechen wir darüber, was du aufbaust.',
    ctaBtn: 'Kontakt aufnehmen',
    footTagline: 'Wir erzählen die Geschichten kleiner Orte, die echte Arbeit leisten — Content, Storytelling und der Webauftritt dahinter.',
    navTitle: 'Navigation', navWork: 'Arbeiten', navServices: 'Leistungen', navTeam: 'Team', navJournal: 'Journal',
    legalTitle: 'Rechtliches', privacy: 'Datenschutzerklärung', terms: 'Nutzungsbedingungen',
    contactTitle: 'Kontakt',
    rights: '© 2026 Dual-Stack Studio. Unabhängig betrieben.', builtWith: 'Erstellt mit Astro, bereitgestellt auf Vercel.',
    parts: [
      { title: 'Australien', meta: 'März – August 2025 · Brisbane und Umgebung', blurb: 'Monate am anderen Ende der Welt — eine Stadt am Fluss, Regenwald an ihrem Rand und die Arbeit dazwischen.' },
      { title: 'Vietnam & Thailand', meta: 'Oktober 2025 · Südostasien', blurb: 'Drei Wochen quer durch Vietnam und Thailand — Karstflüsse und stilles Wasser, dann der Lärm und das Neon der Straßen.' },
      { title: 'Österreich', meta: 'März – September 2026 · Oberösterreich', blurb: 'Eine Saison auf dem österreichischen Land, von vorne bis hinten — vom ersten Frost im März bis zum langen Licht des Spätsommers.' },
    ],
  },
};
const c = copy[lang];

const parts = [
  { href: '/journal/australia', num: '01', cover: auCover, count: auCount },
  { href: '/journal/vietnam-thailand', num: '02', cover: vtCover, count: vtCount },
  { href: '/journal/austria', num: '03', cover: austriaCover, count: austriaCount },
].map((p, i) => ({ ...p, ...c.parts[i] }));
---

<Layout title={c.title} description={c.description} lang={lang}>

  <header class="jn-header">
    <a href={l(lang, '/creative')} class="jn-brand">
      <img src="/logo.svg" alt="Dual-Stack Studio" width="32" height="32" style="border-radius: 8px;" />
      <span>Dual-Stack Studio</span>
    </a>
    <span class="jn-header-right">
      <LangSwitch lang={lang} />
      <a href={l(lang, '/creative')} class="jn-back">{c.back}</a>
    </span>
  </header>

  <!-- ============ INTRO / ABOUT ============ -->
  <section class="jn-intro">
    <div class="jn-inner jn-inner--narrow">
      <span class="jn-eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="jn-intro-lead">{c.lead}</p>
      <p class="jn-intro-body">{c.body}</p>
    </div>
  </section>

  <!-- ============ PARTS ============ -->
  <section class="jn-parts">
    <div class="jn-inner">
      <div class="jn-parts-head">
        <span class="jn-eyebrow jn-eyebrow--dark">{c.chaptersEyebrow}</span>
        <h2>{c.chaptersTitle}</h2>
      </div>

      <div class="jn-parts-list">
        {parts.map((p) => (
          <a href={l(lang, p.href)} class="jn-part">
            <div class="jn-part-media">
              <img src={p.cover} alt={`${p.title} — ${c.cover}`} loading="lazy" />
              <span class="jn-part-num">{c.part} {p.num}</span>
            </div>
            <div class="jn-part-body">
              <h3>{p.title}</h3>
              <p class="jn-part-meta">{p.meta}</p>
              <p class="jn-part-blurb">{p.blurb}</p>
              <span class="jn-part-link">{c.readPart} · {p.count} {c.photos} →</span>
            </div>
          </a>
        ))}

        <!-- Placeholder for chapters still to come -->
        <div class="jn-part jn-part--soon">
          <div class="jn-part-body">
            <span class="jn-part-num jn-part-num--static">{c.part} 04</span>
            <h3>{c.soonTitle}</h3>
            <p class="jn-part-blurb">{c.soonText}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="jn-cta">
    <div class="jn-inner jn-cta-inner">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaText}</p>
      <a href={l(lang, '/creative#contact')} class="jn-cta-btn">{c.ctaBtn}</a>
    </div>
  </section>

  <footer class="jn-footer">
    <div class="jn-inner">
      <div class="jn-footer-grid">
        <div class="jn-footer-brand">
          <div class="jn-footer-logo">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="28" height="28" style="border-radius: 7px;" />
            Dual-Stack Studio
          </div>
          <p>{c.footTagline}</p>
        </div>
        <div class="jn-footer-col">
          <h4>{c.navTitle}</h4>
          <a href={l(lang, '/creative#work')}>{c.navWork}</a>
          <a href={l(lang, '/creative#services')}>{c.navServices}</a>
          <a href={l(lang, '/creative#team')}>{c.navTeam}</a>
          <a href={l(lang, '/journal')}>{c.navJournal}</a>
        </div>
        <div class="jn-footer-col">
          <h4>{c.legalTitle}</h4>
          <a href={l(lang, '/privacy-policy')}>{c.privacy}</a>
          <a href={l(lang, '/terms-of-service')}>{c.terms}</a>
          <a href={l(lang, '/impressum')}>Impressum</a>
        </div>
        <div class="jn-footer-col">
          <h4>{c.contactTitle}</h4>
          <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
        </div>
      </div>
      <div class="jn-footer-bottom">
        <p>{c.rights}</p>
        <p>{c.builtWith}</p>
      </div>
    </div>
  </footer>

  <style>
    :root {
      --cream: #f7f2e7;
      --cream-deep: #efe6d4;
      --forest: #2f4436;
      --forest-deep: #223226;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --muted: #6b6156;
    }

    .jn-inner { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
    .jn-inner--narrow { max-width: 720px; }

    .jn-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--terracotta-deep);
      margin-bottom: 1rem;
    }
    .jn-eyebrow--dark { color: var(--terracotta-deep); }

    /* ---------- HEADER ---------- */
    .jn-header {
      position: sticky;
      top: 0;
      width: 100%;
      padding: 1.25rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      background: rgba(247, 242, 231, 0.85);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(43,36,32,0.08);
    }
    .jn-brand { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: var(--ink); }
    .jn-header-right { display: inline-flex; align-items: center; gap: 1.5rem; color: var(--muted); }
    .jn-back { font-size: 14px; font-weight: 600; color: var(--muted); }
    .jn-back:hover { color: var(--terracotta); }

    /* ---------- INTRO ---------- */
    .jn-intro { background: var(--cream); padding: 6rem 0 4rem; }
    .jn-intro h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(36px, 6vw, 60px);
      font-weight: 600;
      letter-spacing: -1.5px;
      line-height: 1.05;
      color: var(--ink);
      margin: 0 0 1.5rem;
    }
    .jn-intro-lead { font-size: clamp(18px, 2.5vw, 21px); line-height: 1.6; color: var(--ink); margin: 0 0 1.25rem; }
    .jn-intro-body { font-size: 17px; line-height: 1.8; color: var(--muted); margin: 0; }

    /* ---------- PARTS ---------- */
    .jn-parts { background: var(--cream-deep); padding: 5rem 0; }
    .jn-parts-head { margin-bottom: 2.5rem; }
    .jn-parts-head h2 { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 36px); font-weight: 600; letter-spacing: -1px; color: var(--ink); margin: 0; }

    .jn-parts-list { display: grid; gap: 1.75rem; }

    .jn-part {
      display: grid;
      grid-template-columns: 42% 1fr;
      background: var(--cream);
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 18px 44px -28px rgba(43,36,32,0.4);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .jn-part:hover { transform: translateY(-3px); box-shadow: 0 26px 56px -28px rgba(43,36,32,0.5); }

    .jn-part-media { position: relative; min-height: 260px; overflow: hidden; }
    .jn-part-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .jn-part:hover .jn-part-media img { transform: scale(1.04); }
    .jn-part-num {
      position: absolute;
      top: 1rem; left: 1rem;
      background: rgba(34, 50, 38, 0.85);
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 6px 12px;
      border-radius: 100px;
      backdrop-filter: blur(4px);
    }

    .jn-part-body { padding: 2.25rem 2.25rem; display: flex; flex-direction: column; justify-content: center; }
    .jn-part-body h3 { font-family: 'Fraunces', serif; font-size: clamp(24px, 3vw, 32px); font-weight: 600; color: var(--ink); margin: 0 0 0.5rem; letter-spacing: -0.5px; }
    .jn-part-meta { font-size: 13px; font-weight: 600; letter-spacing: 0.4px; text-transform: uppercase; color: var(--terracotta-deep); margin: 0 0 1rem; }
    .jn-part-blurb { font-size: 16px; line-height: 1.7; color: var(--muted); margin: 0 0 1.5rem; }
    .jn-part-link { font-size: 14px; font-weight: 700; color: var(--forest); }
    .jn-part:hover .jn-part-link { color: var(--terracotta); }

    /* placeholder card */
    .jn-part--soon { grid-template-columns: 1fr; background: transparent; border: 1.5px dashed rgba(43,36,32,0.22); box-shadow: none; }
    .jn-part--soon:hover { transform: none; box-shadow: none; }
    .jn-part--soon .jn-part-body { padding: 2.5rem; align-items: flex-start; }
    .jn-part-num--static {
      position: static;
      display: inline-block;
      background: rgba(43,36,32,0.08);
      color: var(--muted);
      backdrop-filter: none;
      margin-bottom: 0.9rem;
    }
    .jn-part--soon h3 { color: var(--muted); }

    /* ---------- CTA ---------- */
    .jn-cta { background: var(--forest); padding: 5.5rem 0; text-align: center; }
    .jn-cta-inner { max-width: 560px; }
    .jn-cta h2 { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 34px); font-weight: 600; color: #fff; margin: 0 0 0.9rem; }
    .jn-cta p { font-size: 15px; color: rgba(255,255,255,0.75); margin: 0 0 2rem; line-height: 1.6; }
    .jn-cta-btn {
      display: inline-block;
      background: var(--terracotta);
      color: #fff;
      padding: 14px 32px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .jn-cta-btn:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    /* ---------- FOOTER ---------- */
    .jn-footer { background: var(--forest-deep); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; }
    .jn-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .jn-footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .jn-footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0; max-width: 300px; }
    .jn-footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .jn-footer-col a { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .jn-footer-col a:hover { color: var(--terracotta); }
    .jn-footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 780px) {
      .jn-header { padding: 1rem 1.5rem; }
      .jn-part { grid-template-columns: 1fr; }
      .jn-part-media { min-height: 220px; }
      .jn-footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 520px) {
      .jn-footer-grid { grid-template-columns: 1fr; }
    }
  </style>

</Layout>
