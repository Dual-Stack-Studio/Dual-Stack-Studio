---
import PhotoLayout from '../layouts/PhotoLayout.astro';
import { l } from '../i18n';
import type { Lang } from '../i18n';
import { photos, toRows } from '../data/photography';

const { lang = 'en' } = Astro.props as { lang?: Lang };

const copy = {
  en: {
    title: 'Photography — Dual-Stack Studio',
    description: 'Personal photography: the pictures taken for myself, not for clients — all in one place.',
    back: '← Back to the studio',
    eyebrow: 'Photography · Personal work',
    h1: 'Pictures for myself.',
    lead: "These aren't client photographs. They're the pictures I make on my own — kept together in one place, in order, instead of posted one by one and left to scroll away.",
    meta: 'photographs · Austria & Japan',
    bizTitle: 'Looking for photography for your business?',
    bizText: 'Client work lives on the studio side, with its own portfolio.',
    bizLink: 'See our work →',
  },
  de: {
    title: 'Fotografie — Dual-Stack Studio',
    description: 'Persönliche Fotografie: die Bilder, die ich für mich mache, nicht für Kunden — alle an einem Ort.',
    back: '← Zurück zum Studio',
    eyebrow: 'Fotografie · Persönliche Arbeiten',
    h1: 'Bilder für mich.',
    lead: 'Das sind keine Kundenfotos. Es sind die Bilder, die ich für mich mache — an einem Ort zusammengehalten, in Reihenfolge, statt einzeln gepostet und weggescrollt zu werden.',
    meta: 'Fotografien · Österreich & Japan',
    bizTitle: 'Du suchst Fotografie für dein Unternehmen?',
    bizText: 'Kundenarbeiten liegen auf der Studioseite, mit eigenem Portfolio.',
    bizLink: 'Unsere Arbeiten ansehen →',
  },
};
const c = copy[lang];

const rows = toRows(photos);
let counter = 0;
const numbered = rows.map((row) => ({
  kind: row.kind,
  plates: row.plates.map((p) => ({ ...p, n: String(++counter).padStart(2, '0') })),
}));
---

<PhotoLayout title={c.title} description={c.description} lang={lang} backHref={l(lang, '/creative')} backLabel={c.back}>
  <section class="phs-hero">
    <div class="ph-inner">
      <span class="phs-eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="phs-meta">{photos.length} {c.meta}</p>
      <p class="phs-lead">{c.lead}</p>
    </div>
  </section>

  <section class="phs-gallery">
    <div class="phs-wrap">
      {numbered.map((row, ri) => (
        <div class={`phs-row phs-row--${row.kind}`}>
          {row.plates.map((p) => (
            <figure class="phs-plate" style={row.kind === 'pair' ? `flex: ${(p.w / p.h).toFixed(4)} 1 0` : undefined}>
              <button
                type="button"
                class="phs-plate-btn"
                data-plate
                data-full={p.src}
                data-title={`${p.title[lang]} · ${p.place[lang]}`}
                data-alt={p.alt[lang]}
                aria-label={p.title[lang]}
              >
                <img
                  src={p.src}
                  alt={p.alt[lang]}
                  width={p.w}
                  height={p.h}
                  loading={ri === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  sizes={row.kind === 'wide' ? '(min-width: 1300px) 1240px, 100vw' : '(min-width: 1300px) 610px, 50vw'}
                />
              </button>
              <figcaption><span>{p.n}</span> {p.title[lang]}</figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="phs-end">
    <div class="ph-inner">
      <h3>{c.bizTitle}</h3>
      <p>{c.bizText}</p>
      <a href={l(lang, '/creative#work')}>{c.bizLink}</a>
    </div>
  </section>
</PhotoLayout>

<style is:global>
  .phs-hero { padding: 10rem 0 4rem; }
  .phs-eyebrow { display: block; font-size: 12px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase; color: #e2865a; margin-bottom: 1.25rem; }
  .phs-hero h1 { font-family: 'Fraunces', Georgia, serif; font-size: clamp(44px, 8vw, 92px); font-weight: 500; letter-spacing: -2.5px; line-height: 1; color: #fff; margin: 0 0 1.25rem; }
  .phs-meta { font-size: 13px; letter-spacing: 0.7px; text-transform: uppercase; color: rgba(255, 255, 255, 0.62); margin-bottom: 1.5rem; }
  .phs-lead { max-width: 620px; font-size: 18px; line-height: 1.7; color: rgba(255, 255, 255, 0.82); }

  .phs-gallery { padding: 1rem 0 5rem; }
  .phs-wrap { max-width: 1240px; margin: 0 auto; padding: 0 1.75rem; display: flex; flex-direction: column; gap: 10px; }
  .phs-row { display: flex; gap: 10px; align-items: flex-start; }
  .phs-row--wide .phs-plate { flex: 1 1 100%; }
  .phs-row--single { justify-content: center; }
  .phs-row--single .phs-plate { flex: 0 1 50%; }
  .phs-plate { position: relative; min-width: 0; margin: 0; overflow: hidden; background: #263a2e; }
  .phs-plate-btn { display: block; width: 100%; padding: 0; border: 0; background: transparent; cursor: zoom-in; }
  .phs-plate-btn img { display: block; width: 100%; height: auto; transition: transform 0.9s ease; }
  .phs-plate:hover .phs-plate-btn img { transform: scale(1.02); }
  /* The title sits over the photograph, so the pictures can stay close together */
  .phs-plate figcaption {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 3.2rem 1.1rem 0.95rem;
    font-family: 'Fraunces', Georgia, serif; font-size: 17px; font-style: italic; letter-spacing: 0.1px; line-height: 1.3;
    color: #fff;
    background: linear-gradient(180deg, rgba(16, 26, 19, 0) 0%, rgba(16, 26, 19, 0.78) 100%);
    pointer-events: none;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .phs-plate figcaption span { display: inline-block; margin-right: 0.7rem; font-family: 'Inter', sans-serif; font-style: normal; font-size: 11px; font-weight: 600; letter-spacing: 1.6px; color: #e2865a; }
  .phs-plate:hover figcaption, .phs-plate:focus-within figcaption { opacity: 1; transform: none; }
  @media (hover: none) { .phs-plate figcaption { opacity: 1; transform: none; font-size: 15px; padding-top: 2.4rem; } }

  .phs-end { padding: 4rem 0 6rem; border-top: 1px solid rgba(255, 255, 255, 0.14); }
  .phs-end h3 { font-family: 'Fraunces', Georgia, serif; font-size: 24px; font-weight: 500; color: #fff; margin-bottom: 0.6rem; }
  .phs-end p { font-size: 15px; color: rgba(255, 255, 255, 0.72); margin-bottom: 1rem; }
  .phs-end a { font-size: 14px; font-weight: 600; color: #f0a47a; }
  .phs-end a:hover { color: #fff; }

  @media (max-width: 700px) {
    .phs-hero { padding: 8rem 0 2.5rem; }
    .phs-wrap { padding: 0 0.6rem; gap: 8px; }
    .phs-row--pair { flex-direction: column; gap: 8px; }
    .phs-row--pair .phs-plate { flex: none !important; width: 100%; }
    .phs-row--single .phs-plate { flex: 0 1 100%; }
  }
</style>
