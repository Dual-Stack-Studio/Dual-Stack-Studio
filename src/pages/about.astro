    }

    /* phones: wordmark on one line with the bigger logo */
    @media (max-width: 560px) {
      .ab-brand { font-size: 14px; gap: 8px; white-space: nowrap; }
      .ab-brand img { width: 34px; height: 34px; }
    }
  </style>
