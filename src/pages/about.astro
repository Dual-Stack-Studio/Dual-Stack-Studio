    /* each photo drifts in from the left and settles; the steps follow one after another */
    :global(.ab-js) .ab-cas .ab-ph.ab-reveal, :global(.ab-js) .ab-cas .ab-stats.ab-reveal { transform: translate(-34px, 30px); transition-delay: calc(var(--k) * 120ms); }
