  <script is:inline>
    (function () {
      var lb = document.getElementById('ab-lb');
      var links = Array.prototype.slice.call(document.querySelectorAll('.ab-ph-open'));
      if (!lb || !links.length) return;
      var img = lb.querySelector('.ab-lb-img');
      var cap = lb.querySelector('.ab-lb-cap');
      var count = lb.querySelector('.ab-lb-count');
      var btnClose = lb.querySelector('.ab-lb-close');
      var btnPrev = lb.querySelector('.ab-lb-prev');
      var btnNext = lb.querySelector('.ab-lb-next');
      var root = document.documentElement;
      var cur = 0, token = 0, lastFocus = null, isOpen = false, startX = null;

      function preload(i) {
        var n = new Image();
        n.src = links[(i + links.length) % links.length].getAttribute('data-full');
      }
      function show(i) {
        cur = (i + links.length) % links.length;
        var a = links[cur];
        var thumb = a.querySelector('img');
        var full = a.getAttribute('data-full');
        var t = ++token;
        img.classList.add('loading');
        img.src = thumb.currentSrc || thumb.src; // the small copy appears at once, then the large one replaces it
        img.alt = thumb.alt;
        var big = new Image();
        big.onload = function () { if (t === token) { img.src = full; img.classList.remove('loading'); } };
        big.onerror = function () { if (t === token) img.classList.remove('loading'); };
        big.src = full;
        cap.textContent = a.getAttribute('data-cap') || '';
        count.textContent = (cur + 1) + ' / ' + links.length;
        preload(cur + 1);
        preload(cur - 1);
      }
      function open(i) {
        lastFocus = document.activeElement;
        isOpen = true;
        lb.hidden = false;
        root.classList.add('ab-lb-lock');
        show(i);
        requestAnimationFrame(function () { lb.classList.add('open'); });
        btnClose.focus();
      }
      function close() {
        if (!isOpen) return;
        isOpen = false;
        token++;
        lb.classList.remove('open');
        root.classList.remove('ab-lb-lock');
        setTimeout(function () { if (!isOpen) { lb.hidden = true; img.removeAttribute('src'); } }, 220);
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      links.forEach(function (a, i) {
        a.addEventListener('click', function (e) {
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return; // let "open in new tab" work
