// Cascade: photos step down and to the right inside a 12-column grid; a new row starts when the next one no longer fits.
type Placed = P & { c: number; k: number; g: number };
const cascade = (list: P[]): Placed[] => {
  let col = 1, k = 0, g = 1;
  return list.map((p) => {
    const s = p.s ?? 4;
    if (col + s > 13) { col = 1; k = 0; g += 1; }
    const placed = { ...p, c: col, k, g };
    col += s; k += 1;
    return placed;
  });
};
const placed: Record<string, Placed[]> = Object.fromEntries(Object.entries(photos).map(([id, list]) => [id, cascade(list)]));

// From 2025 the story continues in the journal written together
