    .ab-link:hover { color: var(--terracotta); border-color: var(--terracotta); }

    /* photos: a cascade that steps down and to the right */
    .ab-cas { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 1.1rem; row-gap: 2.2rem; margin-top: 3.5rem; padding-bottom: 0.5rem; }
    .ab-ph { grid-column: var(--c) / span var(--s); grid-row: var(--g); align-self: start; margin: calc(var(--k) * 3.2rem) 0 0 -2rem; z-index: var(--n); position: relative; overflow: hidden; box-sizing: content-box; border: 5px solid #fff; border-radius: 10px; background: var(--forest-deep); box-shadow: 0 22px 44px -22px rgba(34,24,16,0.6); }
    .ab-ph--first { margin-left: 0; }
    .ab-ph img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
    .ab-ph:hover img { transform: scale(1.035); }
