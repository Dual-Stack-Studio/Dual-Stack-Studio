---
import Layout from '../../layouts/Layout.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { l, formatDate } from '../../i18n';
import type { Lang } from '../../i18n';
import data from '../../data/journal-australia.json';
import tasData from '../../data/journal-tasmania.json';

const { lang = 'en' } = Astro.props as { lang?: Lang };
const de = lang === 'de';

const photos = data.photos;
const heroImg = '/images/journal/australia/au-28.jpg';
// Gallery excludes the hero shot so it isn't shown twice.
const gallery = photos.filter((p) => p.src !== heroImg);

// Videos are woven into the photo galleries (not a separate section).
const auVideos = [
  { type: 'video', orientation: 'landscape', src: '/videos/journal/australia-video-01.mp4', poster: '/images/journal/australia/au-video-01-poster.jpg', label: de ? 'Ein langer Blick über den Busch · August 2025' : 'A long look out over the bush · August 2025' },
  { type: 'video', orientation: 'portrait', src: '/videos/journal/australia-video-02.mp4', poster: '/images/journal/australia/au-video-02-poster.jpg', label: de ? 'Kakadu · Juni 2025' : 'Cockatoo · June 2025' },
  { type: 'video', orientation: 'portrait', src: '/videos/journal/australia-video-03.mp4', poster: '/images/journal/australia/au-video-03-poster.jpg', label: de ? 'Unterwegs · März 2025' : 'Out and about · March 2025' },
  { type: 'video', orientation: 'portrait', src: '/videos/journal/australia-video-04.mp4', poster: '/images/journal/australia/au-video-04-poster.jpg', label: de ? 'In der Stadt unterwegs · März 2025' : 'Around town · March 2025' },
];

const tasVideos = [
  { type: 'video', orientation: 'landscape', src: '/videos/journal/tasmania-video-01.mp4', poster: '/images/journal/australia/tasmania/tas-video-01-poster.jpg', label: de ? 'Unten an der Küste · Dezember 2024' : 'Down on the coast · December 2024' },
  { type: 'video', orientation: 'portrait', src: '/videos/journal/tasmania-video-02.mp4', poster: '/images/journal/australia/tasmania/tas-video-02-poster.jpg', label: de ? 'Ein Moment am Wasser · Februar 2025' : 'A moment by the water · February 2025' },
];

// Photo caption: a formatted date when the photo has one, otherwise a translated generic label.
function captionOf(p: any): string {
  if (p.date) return formatDate(p.date, lang);
  return de ? String(p.label).replace('Australia', 'Australien').replace('Tasmania', 'Tasmanien') : p.label;
}

// Spread the videos evenly through the photo stream so they sit among the photos.
function weave(photoList: any[], videoList: any[]): any[] {
  const items: any[] = photoList.map((p: any) => ({ type: 'photo', ...p, caption: captionOf(p) }));
  if (!videoList.length) return items;
  const step = Math.max(1, Math.round(photoList.length / (videoList.length + 1)));
  const out: any[] = [];
  let vi = 0;
  items.forEach((it: any, i: number) => {
    out.push(it);
    if ((i + 1) % step === 0 && vi < videoList.length) out.push(videoList[vi++]);
  });
  while (vi < videoList.length) out.push(videoList[vi++]);
  return out;
}

const items = weave(gallery, auVideos);
const tasItems = weave(tasData.photos, tasVideos);

const copy = {
  en: {
    title: 'Australia — Journal — Dual-Stack Studio',
    description: 'Part one of our journal: months in Australia — Brisbane, the bush, the wildlife and the work in between.',
    back: '← Back to journal',
    heroAlt: 'The Brisbane skyline seen across the bush from a lookout',
    eyebrow: 'Journal · Part 01', h1: 'Australia',
    meta: 'March – August 2025 · Brisbane & beyond',
    lead: 'Months on the other side of the world — a city on the river, rainforest at the edge of it, and the work that paid for the days off.',
    storyLead: "Australia wasn't a holiday. It was a stretch of real life in a place that happened to be beautiful.",
    p1: 'We landed in Brisbane and did the unglamorous part first — finding work, finding a rhythm, learning a new city one bus route at a time. But on the days off we went looking: up to the lookout where the whole skyline sits small against the bush, into the rainforest where the light comes down in pieces, out to wherever the weekend pointed us. Somewhere in there a cockatoo screamed at us from a gum tree, and that felt about right.',
    p2: "It's the kind of trip that teaches you to shoot what's actually in front of you — not the postcard, but the real texture of a place you're living in. That's the same thing we do for the businesses we work with. What follows is Australia, roughly in the order it happened.",
    note: 'Still editing this chapter — more to come.',
    monthsEyebrow: 'The months, front to back', monthsTitle: 'From autumn into spring',
    monthsLead: 'Shot from March to August 2025, roughly in order. Tap any photo to see it full size.',
    photoAlt: 'Australia', tasAlt: 'Tasmania',
    tasBadge: 'A side trip', tasTitle: 'Down to Tasmania',
    tasIntro: "Before the mainland, there was the island. We spent the turn of the year down in Tasmania — wild beaches with no one on them, cold clean water, and the kind of coastline that makes you stop the car every few minutes. It felt like the edge of everything, so we're keeping it in its own chapter.",
    ctaTitle: 'This is how we see every place.',
    ctaText: 'The same eye we bring to a stretch of life in Australia is the one we bring to farms, guesthouses and small local businesses.',
    ctaBtn: "Let's talk",
    footTagline: 'We tell the story of small places doing real work — content, storytelling, and the web presence behind it.',
    navTitle: 'Navigate', navWork: 'Work', navServices: 'Services', navTeam: 'Team', navJournal: 'Journal',
    legalTitle: 'Legal', privacy: 'Privacy Policy', terms: 'Terms of Service', contactTitle: 'Get in touch',
    rights: '© 2026 Dual-Stack Studio. Independently operated.', builtWith: 'Built with Astro, deployed on Vercel.',
    close: 'Close',
  },
  de: {
    title: 'Australien — Journal — Dual-Stack Studio',
    description: 'Teil eins unseres Journals: Monate in Australien — Brisbane, der Busch, die Tierwelt und die Arbeit dazwischen.',
    back: '← Zurück zum Journal',
    heroAlt: 'Die Skyline von Brisbane, von einem Aussichtspunkt über den Busch gesehen',
    eyebrow: 'Journal · Teil 01', h1: 'Australien',
    meta: 'März – August 2025 · Brisbane und Umgebung',
    lead: 'Monate am anderen Ende der Welt — eine Stadt am Fluss, Regenwald an ihrem Rand und die Arbeit, die die freien Tage finanziert hat.',
    storyLead: 'Australien war kein Urlaub. Es war ein Stück echtes Leben an einem Ort, der zufällig wunderschön war.',
    p1: 'Wir landeten in Brisbane und erledigten zuerst den unglamourösen Teil — Arbeit finden, einen Rhythmus finden, eine neue Stadt Buslinie für Buslinie kennenlernen. An den freien Tagen gingen wir aber auf Entdeckungstour: hinauf zum Aussichtspunkt, von dem aus die ganze Skyline klein vor dem Busch liegt, in den Regenwald, wo das Licht in Stücken herunterfällt, und dorthin, wohin uns das Wochenende gerade führte. Irgendwo dazwischen schrie uns ein Kakadu aus einem Eukalyptusbaum an, und das fühlte sich genau richtig an.',
    p2: 'Es ist die Art von Reise, die einen lehrt, das zu fotografieren, was tatsächlich vor einem liegt — nicht die Postkarte, sondern die echte Textur eines Ortes, an dem man lebt. Genau das tun wir auch für die Betriebe, mit denen wir arbeiten. Was folgt, ist Australien, ungefähr in der Reihenfolge, in der es geschah.',
    note: 'Dieses Kapitel wird noch bearbeitet — es kommt noch mehr.',
    monthsEyebrow: 'Die Monate, von vorne bis hinten', monthsTitle: 'Vom Herbst in den Frühling',
    monthsLead: 'Aufgenommen von März bis August 2025, ungefähr in der richtigen Reihenfolge. Tipp auf ein Foto, um es in voller Größe zu sehen.',
    photoAlt: 'Australien', tasAlt: 'Tasmanien',
    tasBadge: 'Ein Abstecher', tasTitle: 'Hinunter nach Tasmanien',
    tasIntro: 'Vor dem Festland gab es die Insel. Den Jahreswechsel verbrachten wir unten in Tasmanien — wilde Strände ohne eine Menschenseele, kaltes, klares Wasser und die Art von Küste, bei der man alle paar Minuten das Auto anhält. Es fühlte sich an wie der Rand von allem, deshalb bekommt es ein eigenes Kapitel.',
    ctaTitle: 'So sehen wir jeden Ort.',
    ctaText: 'Denselben Blick, den wir auf einen Lebensabschnitt in Australien richten, richten wir auf Bauernhöfe, Gästehäuser und kleine lokale Betriebe.',
    ctaBtn: 'Sprechen wir',
    footTagline: 'Wir erzählen die Geschichten kleiner Orte, die echte Arbeit leisten — Content, Storytelling und der Webauftritt dahinter.',
    navTitle: 'Navigation', navWork: 'Arbeiten', navServices: 'Leistungen', navTeam: 'Team', navJournal: 'Journal',
    legalTitle: 'Rechtliches', privacy: 'Datenschutzerklärung', terms: 'Nutzungsbedingungen', contactTitle: 'Kontakt',
    rights: '© 2026 Dual-Stack Studio. Unabhängig betrieben.', builtWith: 'Erstellt mit Astro, bereitgestellt auf Vercel.',
    close: 'Schließen',
  },
};
const c = copy[lang];
---

<Layout title={c.title} description={c.description} lang={lang}>

  <header class="au-header">
    <a href={l(lang, '/creative')} class="au-brand">
      <img src="/logo.svg" alt="Dual-Stack Studio" width="32" height="32" style="border-radius: 8px;" />
      <span>Dual-Stack Studio</span>
    </a>
    <span class="au-header-right">
      <LangSwitch lang={lang} />
      <a href={l(lang, '/journal')} class="au-back">{c.back}</a>
    </span>
  </header>

  <section class="au-hero">
    <img class="au-hero-img" src={heroImg} alt={c.heroAlt} />
    <div class="au-hero-scrim"></div>
    <div class="au-hero-content">
      <span class="au-eyebrow">{c.eyebrow}</span>
      <h1>{c.h1}</h1>
      <p class="au-hero-meta">{c.meta}</p>
      <p class="au-hero-lead">{c.lead}</p>
    </div>
  </section>

  <section class="au-story">
    <div class="au-inner au-inner--narrow">
      <p class="au-story-lead">{c.storyLead}</p>
      <p>{c.p1}</p>
      <p>{c.p2}</p>
      <p class="au-story-note"><em>{c.note}</em></p>
    </div>
  </section>

  <!-- ============ THE MONTHS (photos + video, woven together) ============ -->
  <section class="au-section">
    <div class="au-inner">
      <span class="au-eyebrow au-eyebrow--dark">{c.monthsEyebrow}</span>
      <h2 class="au-section-title">{c.monthsTitle}</h2>
      <p class="au-section-lead">{c.monthsLead}</p>
      <div class="au-masonry">
        {items.map((it) => (
          it.type === 'video' ? (
            <figure class={`au-masonry-video is-${it.orientation}`}>
              <video src={it.src} poster={it.poster} controls preload="none" playsinline muted></video>
              <figcaption>{it.label}</figcaption>
            </figure>
          ) : (
            <div class="au-item">
              <img src={it.src} alt={`${c.photoAlt} — ${it.caption}`} width={it.w} height={it.h} loading="lazy" decoding="async" class="au-lightbox-trigger" />
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       SPECIAL SUB-SECTION — TASMANIA
       A distinct chapter-within-a-chapter.
       ============================================================ -->
  <section class="au-tas">
    <div class="au-inner">
      <div class="au-tas-head">
        <span class="au-tas-badge">{c.tasBadge}</span>
        <h2 class="au-tas-title">{c.tasTitle}</h2>
        <p class="au-tas-intro">{c.tasIntro}</p>
      </div>

      <div class="au-tas-masonry">
        {tasItems.map((it) => (
          it.type === 'video' ? (
            <figure class={`au-masonry-video is-${it.orientation}`}>
              <video src={it.src} poster={it.poster} controls preload="none" playsinline muted></video>
              <figcaption>{it.label}</figcaption>
            </figure>
          ) : (
            <div class="au-item">
              <img src={it.src} alt={`${c.tasAlt} — ${it.caption}`} width={it.w} height={it.h} loading="lazy" decoding="async" class="au-lightbox-trigger" />
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="au-cta">
    <div class="au-inner au-cta-inner">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaText}</p>
      <a href={l(lang, '/creative#contact')} class="au-cta-btn">{c.ctaBtn}</a>
    </div>
  </section>

  <footer class="au-footer">
    <div class="au-inner">
      <div class="au-footer-grid">
        <div class="au-footer-brand">
          <div class="au-footer-logo">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="28" height="28" style="border-radius: 7px;" />
            Dual-Stack Studio
          </div>
          <p>{c.footTagline}</p>
        </div>
        <div class="au-footer-col">
          <h4>{c.navTitle}</h4>
          <a href={l(lang, '/creative#work')}>{c.navWork}</a>
          <a href={l(lang, '/creative#services')}>{c.navServices}</a>
          <a href={l(lang, '/creative#team')}>{c.navTeam}</a>
          <a href={l(lang, '/journal')}>{c.navJournal}</a>
        </div>
        <div class="au-footer-col">
          <h4>{c.legalTitle}</h4>
          <a href={l(lang, '/privacy-policy')}>{c.privacy}</a>
          <a href={l(lang, '/terms-of-service')}>{c.terms}</a>
          <a href={l(lang, '/impressum')}>Impressum</a>
        </div>
        <div class="au-footer-col">
          <h4>{c.contactTitle}</h4>
          <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
        </div>
      </div>
      <div class="au-footer-bottom">
        <p>{c.rights}</p>
        <p>{c.builtWith}</p>
      </div>
    </div>
  </footer>

  <div id="au-lightbox" class="au-lightbox" hidden>
    <button type="button" class="au-lightbox-close" id="au-lightbox-close" aria-label={c.close}>×</button>
    <img src="" alt="" class="au-lightbox-img" id="au-lightbox-img" />
  </div>

  <style>
    :root {
      --cream: #f7f2e7;
      --cream-deep: #efe6d4;
      --forest: #2f4436;
      --forest-deep: #223226;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --muted: #6b6156;
    }

    .au-inner { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
    .au-inner--narrow { max-width: 720px; }

    .au-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      margin-bottom: 0.75rem;
    }
    .au-eyebrow--dark { color: var(--terracotta-deep); }
    .au-eyebrow--light { color: var(--terracotta); }

    /* ---------- HEADER ---------- */
    .au-header {
      position: fixed;
      top: 0; left: 0;
      width: 100%;
      padding: 1.5rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      background: rgba(34, 50, 38, 0.55);
      backdrop-filter: blur(8px);
    }
    .au-brand { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; }
    .au-header-right { display: inline-flex; align-items: center; gap: 1.5rem; color: rgba(255,255,255,0.9); }
    .au-back { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.9); }
    .au-back:hover { color: var(--terracotta); }

    /* ---------- HERO ---------- */
    .au-hero {
      position: relative;
      min-height: 82vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: var(--forest-deep);
    }
    .au-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .au-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,24,16,0.15) 0%, rgba(20,24,16,0.25) 45%, rgba(20,24,16,0.9) 100%); }
    .au-hero-content { position: relative; z-index: 5; max-width: 760px; padding: 6rem 2.5rem 4.5rem; }
    .au-hero-content h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(48px, 9vw, 96px);
      font-weight: 600;
      letter-spacing: -2px;
      color: #fff;
      margin: 0 0 0.75rem;
      line-height: 1;
    }
    .au-hero-meta { font-size: 13px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; color: rgba(255,255,255,0.72); margin: 0 0 1rem; }
    .au-hero-lead { font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.9); margin: 0; max-width: 560px; }

    /* ---------- STORY ---------- */
    .au-story { background: var(--cream); padding: 5.5rem 0 4rem; }
    .au-story-lead {
      font-family: 'Fraunces', serif;
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 500;
      line-height: 1.4;
      color: var(--ink);
      margin: 0 0 1.75rem;
    }
    .au-story p { font-size: 17px; line-height: 1.8; color: var(--ink); margin: 0 0 1.4rem; }
    .au-story-note { color: var(--muted); font-size: 15px !important; }

    /* ---------- SECTIONS ---------- */
    .au-section { padding: 5.5rem 0; background: var(--cream); }
    .au-section--dark { background: var(--forest-deep); }

    .au-section-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(26px, 3.5vw, 38px);
      font-weight: 600;
      letter-spacing: -1px;
      color: var(--ink);
      margin: 0 0 0.75rem;
    }
    .au-section-title--light { color: #fff; }
    .au-section-lead { font-size: 16px; color: var(--muted); max-width: 560px; margin: 0 0 2.5rem; line-height: 1.65; }
    .au-section-lead--light { color: rgba(255,255,255,0.72); }

    /* ---------- VIDEO WOVEN INTO MASONRY ---------- */
    .au-masonry-video {
      break-inside: avoid;
      margin: 0 0 1.25rem;
    }
    .au-masonry-video video {
      width: 100%;
      object-fit: cover;
      border-radius: 6px;
      background: #000;
      display: block;
      box-shadow: 0 14px 34px -18px rgba(0,0,0,0.6);
    }
    .au-masonry-video.is-landscape video { aspect-ratio: 16 / 9; }
    .au-masonry-video.is-portrait video { aspect-ratio: 9 / 16; }
    .au-masonry-video figcaption {
      margin-top: 0.55rem;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.3px;
      color: var(--muted);
    }
    /* On the dark Tasmania band the caption needs to be light. */
    .au-tas .au-masonry-video figcaption { color: rgba(255,255,255,0.6); }

    /* ---------- MASONRY GALLERY ---------- */
    .au-masonry { column-count: 3; column-gap: 1.25rem; }
    .au-item {
      break-inside: avoid;
      margin-bottom: 1.25rem;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 12px 30px -18px rgba(43,36,32,0.35);
    }
    .au-item img { display: block; width: 100%; height: auto; cursor: zoom-in; transition: transform 0.5s ease; }
    .au-item:hover img { transform: scale(1.03); }
    /* Smooth loading: space is reserved via width/height, a soft placeholder shows
       while the photo loads, then it fades in (only when JS marks it pending). */
    .au-item { background: rgba(43,36,32,0.07); }
    .au-tas .au-item { background: rgba(255,255,255,0.07); }
    .au-item img { transition: opacity 0.8s ease, transform 0.5s ease; }
    .au-item img.is-pending { opacity: 0; }
    @media (prefers-reduced-motion: reduce) { .au-item img { transition: none; } }

    /* ---------- SPECIAL SUB-SECTION: TASMANIA ---------- */
    .au-tas {
      background: var(--forest-deep);
      padding: 5.5rem 0;
      border-top: 4px solid var(--terracotta);
    }
    .au-tas-head { max-width: 720px; margin: 0 0 3rem; }
    .au-tas-badge {
      display: inline-block;
      background: var(--terracotta);
      color: #fff;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 6px 14px;
      border-radius: 100px;
      margin-bottom: 1.25rem;
    }
    .au-tas-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(30px, 5vw, 48px);
      font-weight: 600;
      letter-spacing: -1.5px;
      color: #fff;
      margin: 0 0 1rem;
      line-height: 1.05;
    }
    .au-tas-intro { font-size: 17px; line-height: 1.75; color: rgba(255,255,255,0.75); margin: 0; }

    .au-tas-masonry { column-count: 3; column-gap: 1.25rem; }
    .au-tas-masonry .au-item,
    .au-tas-masonry .au-masonry-video {
      break-inside: avoid;
      margin-bottom: 1.25rem;
    }

    /* ---------- CTA ---------- */
    .au-cta { background: var(--forest); padding: 5.5rem 0; text-align: center; }
    .au-cta-inner { max-width: 560px; }
    .au-cta h2 { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 34px); font-weight: 600; color: #fff; margin: 0 0 0.9rem; }
    .au-cta p { font-size: 15px; color: rgba(255,255,255,0.75); margin: 0 0 2rem; line-height: 1.6; }
    .au-cta-btn {
      display: inline-block;
      background: var(--terracotta);
      color: #fff;
      padding: 14px 32px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .au-cta-btn:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    /* ---------- LIGHTBOX ---------- */
    .au-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(20, 16, 12, 0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
    }
    .au-lightbox[hidden] { display: none; }
    .au-lightbox-img { max-width: 100%; max-height: 100%; border-radius: 6px; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6); }
    .au-lightbox-close {
      position: absolute;
      top: 24px; right: 28px;
      width: 44px; height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.08);
      color: #fff;
      font-size: 24px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .au-lightbox-close:hover { background: rgba(193,102,62,0.4); border-color: var(--terracotta); }

    /* ---------- FOOTER ---------- */
    .au-footer { background: var(--forest-deep); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; }
    .au-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .au-footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .au-footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0; max-width: 300px; }
    .au-footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .au-footer-col a { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .au-footer-col a:hover { color: var(--terracotta); }
    .au-footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .au-header { padding: 1.25rem 1.5rem; }
      .au-masonry, .au-tas-masonry { column-count: 2; }
      .au-footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .au-hero-content { padding: 5rem 1.5rem 3rem; }
      .au-masonry, .au-tas-masonry { column-count: 1; }
      .au-footer-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    (function () {
      const lightbox = document.getElementById('au-lightbox');
      const lightboxImg = document.getElementById('au-lightbox-img') as HTMLImageElement | null;
      const closeBtn = document.getElementById('au-lightbox-close');
      if (!lightbox || !lightboxImg) return;

      function open(src: string, alt: string) {
        lightboxImg!.src = src;
        lightboxImg!.alt = alt;
        lightbox!.hidden = false;
      }
      function close() {
        lightbox!.hidden = true;
        lightboxImg!.src = '';
      }

      document.querySelectorAll('.au-lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => open((img as HTMLImageElement).currentSrc || (img as HTMLImageElement).src, (img as HTMLImageElement).alt));
      });

      closeBtn?.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lightbox!.hidden) close(); });
    })();

    // Hover-to-play for the video clips (muted preview on hover).
    (function () {
      const canHover = window.matchMedia('(hover: hover)').matches;
      if (!canHover) return; // touch devices keep tap-to-play via controls
      document.querySelectorAll<HTMLVideoElement>('.au-masonry-video video').forEach((v) => {
        v.muted = true;
        v.addEventListener('mouseenter', () => {
          const p = v.play();
          if (p) p.catch(() => {});
        });
        v.addEventListener('mouseleave', () => {
          v.pause();
          v.currentTime = 0;
        });
      });
    })();
  </script>

  <script>
    // Fade photos in as they load instead of popping in. Photos already loaded (or
    // cached) are left alone; without JS nothing is hidden.
    document.querySelectorAll<HTMLImageElement>('.au-item img').forEach((img) => {
      if (img.complete && img.naturalWidth > 0) return;
      img.classList.add('is-pending');
      const reveal = () => img.classList.remove('is-pending');
      img.addEventListener('load', reveal, { once: true });
      img.addEventListener('error', reveal, { once: true });
    });
  </script>
</Layout>
