---
import Layout from '../../layouts/Layout.astro';
import data from '../../data/journal-vietnam-thailand.json';

const photos = data.photos;
const heroImg = '/images/journal/vietnam-thailand/vt-24.jpg';
// Gallery excludes the hero shot so it isn't shown twice.
const gallery = photos.filter((p) => p.src !== heroImg);

// Video is woven into the photo gallery (not a separate section).
const videos = [
  { type: 'video', orientation: 'landscape', src: '/videos/journal/vietnam-thailand-video-01.mp4', poster: '/images/journal/vietnam-thailand/vt-video-01-poster.jpg', label: 'Rush hour · Ho Chi Minh City · October 2025' },
];

// Spread the videos evenly through the photo stream so they sit among the photos.
function weave(photoList: any[], videoList: any[]): any[] {
  const list: any[] = photoList.map((p: any) => ({ type: 'photo', ...p }));
  if (!videoList.length) return list;
  const step = Math.max(1, Math.round(photoList.length / (videoList.length + 1)));
  const out: any[] = [];
  let vi = 0;
  list.forEach((it: any, i: number) => {
    out.push(it);
    if ((i + 1) % step === 0 && vi < videoList.length) out.push(videoList[vi++]);
  });
  while (vi < videoList.length) out.push(videoList[vi++]);
  return out;
}

const items = weave(gallery, videos);
---

<Layout title="Vietnam & Thailand — Journal — Dual-Stack Studio" description="Part two of our journal: three weeks across Vietnam and Thailand — karst rivers, night markets and motorbike traffic.">

  <header class="vt-header">
    <a href="/" class="vt-brand">
      <img src="/logo.svg" alt="Dual-Stack Studio" width="32" height="32" style="border-radius: 8px;" />
      <span>Dual-Stack Studio</span>
    </a>
    <a href="/journal" class="vt-back">← Back to journal</a>
  </header>

  <section class="vt-hero">
    <img class="vt-hero-img" src={heroImg} alt="Karst mountains rising over a still river in northern Vietnam" />
    <div class="vt-hero-scrim"></div>
    <div class="vt-hero-content">
      <span class="vt-eyebrow">Journal · Part 02</span>
      <h1>Vietnam &amp; Thailand</h1>
      <p class="vt-hero-meta">October 2025 · From the rivers of Vietnam to the coasts of Thailand</p>
      <p class="vt-hero-lead">Three weeks across Southeast Asia — karst valleys and quiet water, then the noise and neon of the streets.</p>
    </div>
  </section>

  <!-- ============================================================
       STORY — placeholder text. Replace freely; the layout adapts
       to however many paragraphs you keep here.
       ============================================================ -->
  <section class="vt-story">
    <div class="vt-inner vt-inner--narrow">
      <p class="vt-story-lead">Some places you photograph. Others you just try to keep up with. This trip was both.</p>
      <p>We started in Vietnam, out among the limestone karsts and slow rivers where the only sound is the paddle. Then the pace flipped — a wall of motorbikes at every intersection, markets that don't stop, food cooked a metre from where you eat it. By the time we crossed into Thailand, we'd stopped trying to capture everything and started looking for the one frame that says the most.</p>
      <p>That's the whole job, really. Whether it's a night market in a foreign city or a small business back home, the work is the same: pay attention, wait for the moment, and tell it honestly. What follows is that trip, more or less in the order it happened.</p>
      <p class="vt-story-note"><em>More of this chapter is still being edited — check back.</em></p>
    </div>
  </section>

  <!-- ============ THE TRIP (photos + video, woven together) ============ -->
  <section class="vt-section">
    <div class="vt-inner">
      <span class="vt-eyebrow vt-eyebrow--dark">The trip, front to back</span>
      <h2 class="vt-section-title">Vietnam, then Thailand</h2>
      <p class="vt-section-lead">Shot across October 2025, roughly in order. Tap any photo to see it full size.</p>
      <div class="vt-masonry">
        {items.map((it) => (
          it.type === 'video' ? (
            <figure class={`vt-masonry-video is-${it.orientation}`}>
              <video src={it.src} poster={it.poster} controls preload="none" playsinline muted></video>
              <figcaption>{it.label}</figcaption>
            </figure>
          ) : (
            <div class="vt-item">
              <img src={it.src} alt={`Southeast Asia — ${it.label}`} loading="lazy" class="vt-lightbox-trigger" />
            </div>
          )
        ))}
      </div>
    </div>
  </section>

  <section class="vt-cta">
    <div class="vt-inner vt-cta-inner">
      <h2>This is how we see every place.</h2>
      <p>The same eye we bring to a trip across Asia is the one we bring to farms, guesthouses and small local businesses.</p>
      <a href="/#contact" class="vt-cta-btn">Let's talk</a>
    </div>
  </section>

  <footer class="vt-footer">
    <div class="vt-inner">
      <div class="vt-footer-grid">
        <div class="vt-footer-brand">
          <div class="vt-footer-logo">
            <img src="/logo.svg" alt="Dual-Stack Studio" width="28" height="28" style="border-radius: 7px;" />
            Dual-Stack Studio
          </div>
          <p>We tell the story of small places doing real work — content, storytelling, and the web presence behind it.</p>
        </div>
        <div class="vt-footer-col">
          <h4>Navigate</h4>
          <a href="/#work">Work</a>
          <a href="/#services">Services</a>
          <a href="/#team">Team</a>
          <a href="/journal">Journal</a>
        </div>
        <div class="vt-footer-col">
          <h4>Legal</h4>
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/terms-of-service">Terms of Service</a>
        </div>
        <div class="vt-footer-col">
          <h4>Get in touch</h4>
          <a href="mailto:hello@dualstackstudio.com">hello@dualstackstudio.com</a>
        </div>
      </div>
      <div class="vt-footer-bottom">
        <p>© 2026 Dual-Stack Studio. Independently operated.</p>
        <p>Built with Astro, deployed on Vercel.</p>
      </div>
    </div>
  </footer>

  <div id="vt-lightbox" class="vt-lightbox" hidden>
    <button type="button" class="vt-lightbox-close" id="vt-lightbox-close" aria-label="Close">×</button>
    <img src="" alt="" class="vt-lightbox-img" id="vt-lightbox-img" />
  </div>

  <style>
    :root {
      --cream: #f7f2e7;
      --cream-deep: #efe6d4;
      --forest: #2f4436;
      --forest-deep: #223226;
      --terracotta: #c1663e;
      --terracotta-deep: #a4522f;
      --ink: #2b2420;
      --muted: #6b6156;
    }

    .vt-inner { max-width: 1180px; margin: 0 auto; padding: 0 1.75rem; }
    .vt-inner--narrow { max-width: 720px; }

    .vt-eyebrow {
      display: block;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: rgba(255,255,255,0.85);
      margin-bottom: 0.75rem;
    }
    .vt-eyebrow--dark { color: var(--terracotta-deep); }
    .vt-eyebrow--light { color: var(--terracotta); }

    /* ---------- HEADER ---------- */
    .vt-header {
      position: fixed;
      top: 0; left: 0;
      width: 100%;
      padding: 1.5rem 2.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      background: rgba(34, 50, 38, 0.55);
      backdrop-filter: blur(8px);
    }
    .vt-brand { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; }
    .vt-back { font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.9); }
    .vt-back:hover { color: var(--terracotta); }

    /* ---------- HERO ---------- */
    .vt-hero {
      position: relative;
      min-height: 82vh;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      background: var(--forest-deep);
    }
    .vt-hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .vt-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,24,16,0.15) 0%, rgba(20,24,16,0.25) 45%, rgba(20,24,16,0.9) 100%); }
    .vt-hero-content { position: relative; z-index: 5; max-width: 760px; padding: 6rem 2.5rem 4.5rem; }
    .vt-hero-content h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(44px, 8vw, 88px);
      font-weight: 600;
      letter-spacing: -2px;
      color: #fff;
      margin: 0 0 0.75rem;
      line-height: 1;
    }
    .vt-hero-meta { font-size: 13px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; color: rgba(255,255,255,0.72); margin: 0 0 1rem; }
    .vt-hero-lead { font-size: 18px; line-height: 1.6; color: rgba(255,255,255,0.9); margin: 0; max-width: 560px; }

    /* ---------- STORY ---------- */
    .vt-story { background: var(--cream); padding: 5.5rem 0 4rem; }
    .vt-story-lead {
      font-family: 'Fraunces', serif;
      font-size: clamp(22px, 3vw, 30px);
      font-weight: 500;
      line-height: 1.4;
      color: var(--ink);
      margin: 0 0 1.75rem;
    }
    .vt-story p { font-size: 17px; line-height: 1.8; color: var(--ink); margin: 0 0 1.4rem; }
    .vt-story-note { color: var(--muted); font-size: 15px !important; }

    /* ---------- SECTIONS ---------- */
    .vt-section { padding: 5.5rem 0; background: var(--cream); }
    .vt-section--dark { background: var(--forest-deep); }

    .vt-section-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(26px, 3.5vw, 38px);
      font-weight: 600;
      letter-spacing: -1px;
      color: var(--ink);
      margin: 0 0 0.75rem;
    }
    .vt-section-title--light { color: #fff; }
    .vt-section-lead { font-size: 16px; color: var(--muted); max-width: 560px; margin: 0 0 2.5rem; line-height: 1.65; }
    .vt-section-lead--light { color: rgba(255,255,255,0.72); }

    /* ---------- MASONRY GALLERY ---------- */
    .vt-masonry { column-count: 3; column-gap: 1.25rem; }
    .vt-item {
      break-inside: avoid;
      margin-bottom: 1.25rem;
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 12px 30px -18px rgba(43,36,32,0.35);
    }
    .vt-item img { display: block; width: 100%; height: auto; cursor: zoom-in; transition: transform 0.5s ease; }
    .vt-item:hover img { transform: scale(1.03); }

    /* ---------- VIDEO WOVEN INTO MASONRY ---------- */
    .vt-masonry-video {
      break-inside: avoid;
      margin: 0 0 1.25rem;
    }
    .vt-masonry-video video {
      width: 100%;
      object-fit: cover;
      border-radius: 6px;
      background: #000;
      display: block;
      box-shadow: 0 14px 34px -18px rgba(0,0,0,0.6);
    }
    .vt-masonry-video.is-landscape video { aspect-ratio: 16 / 9; }
    .vt-masonry-video.is-portrait video { aspect-ratio: 9 / 16; }
    .vt-masonry-video figcaption {
      margin-top: 0.55rem;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.3px;
      color: var(--muted);
    }

    /* ---------- CTA ---------- */
    .vt-cta { background: var(--forest); padding: 5.5rem 0; text-align: center; }
    .vt-cta-inner { max-width: 560px; }
    .vt-cta h2 { font-family: 'Fraunces', serif; font-size: clamp(26px, 3.5vw, 34px); font-weight: 600; color: #fff; margin: 0 0 0.9rem; }
    .vt-cta p { font-size: 15px; color: rgba(255,255,255,0.75); margin: 0 0 2rem; line-height: 1.6; }
    .vt-cta-btn {
      display: inline-block;
      background: var(--terracotta);
      color: #fff;
      padding: 14px 32px;
      border-radius: 100px;
      font-size: 14px;
      font-weight: 600;
      transition: background 0.2s, transform 0.2s;
    }
    .vt-cta-btn:hover { background: var(--terracotta-deep); transform: translateY(-1px); }

    /* ---------- LIGHTBOX ---------- */
    .vt-lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      background: rgba(20, 16, 12, 0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4rem 2rem;
    }
    .vt-lightbox[hidden] { display: none; }
    .vt-lightbox-img { max-width: 100%; max-height: 100%; border-radius: 6px; box-shadow: 0 30px 80px -20px rgba(0,0,0,0.6); }
    .vt-lightbox-close {
      position: absolute;
      top: 24px; right: 28px;
      width: 44px; height: 44px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.2);
      background: rgba(255,255,255,0.08);
      color: #fff;
      font-size: 24px;
      line-height: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .vt-lightbox-close:hover { background: rgba(193,102,62,0.4); border-color: var(--terracotta); }

    /* ---------- FOOTER ---------- */
    .vt-footer { background: var(--forest-deep); color: rgba(255,255,255,0.7); padding: 5rem 0 2.5rem; }
    .vt-footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem; padding-bottom: 3rem; margin-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.1); }
    .vt-footer-logo { display: flex; align-items: center; gap: 10px; font-family: 'Fraunces', serif; font-size: 19px; font-weight: 600; color: #fff; margin-bottom: 1rem; }
    .vt-footer-brand p { font-size: 14px; color: rgba(255,255,255,0.65); line-height: 1.7; margin: 0; max-width: 300px; }
    .vt-footer-col h4 { font-size: 13px; font-weight: 700; color: #fff; margin-bottom: 1rem; }
    .vt-footer-col a { display: block; font-size: 14px; color: rgba(255,255,255,0.65); margin-bottom: 0.6rem; }
    .vt-footer-col a:hover { color: var(--terracotta); }
    .vt-footer-bottom { display: flex; justify-content: space-between; font-size: 12px; color: rgba(255,255,255,0.4); flex-wrap: wrap; gap: 0.5rem; }

    /* ---------- RESPONSIVE ---------- */
    @media (max-width: 860px) {
      .vt-header { padding: 1.25rem 1.5rem; }
      .vt-masonry { column-count: 2; }
      .vt-footer-grid { grid-template-columns: 1fr 1fr; }
    }
    @media (max-width: 560px) {
      .vt-hero-content { padding: 5rem 1.5rem 3rem; }
      .vt-masonry { column-count: 1; }
      .vt-footer-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    (function () {
      const lightbox = document.getElementById('vt-lightbox');
      const lightboxImg = document.getElementById('vt-lightbox-img') as HTMLImageElement | null;
      const closeBtn = document.getElementById('vt-lightbox-close');
      if (!lightbox || !lightboxImg) return;

      function open(src: string, alt: string) {
        lightboxImg!.src = src;
        lightboxImg!.alt = alt;
        lightbox!.hidden = false;
      }
      function close() {
        lightbox!.hidden = true;
        lightboxImg!.src = '';
      }

      document.querySelectorAll('.vt-lightbox-trigger').forEach((img) => {
        img.addEventListener('click', () => open((img as HTMLImageElement).currentSrc || (img as HTMLImageElement).src, (img as HTMLImageElement).alt));
      });

      closeBtn?.addEventListener('click', close);
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lightbox!.hidden) close(); });
    })();

    // Hover-to-play for the video clip (muted preview on hover).
    (function () {
      const canHover = window.matchMedia('(hover: hover)').matches;
      if (!canHover) return; // touch devices keep tap-to-play via controls
      document.querySelectorAll<HTMLVideoElement>('.vt-masonry-video video').forEach((v) => {
        v.muted = true;
        v.addEventListener('mouseenter', () => {
          const p = v.play();
          if (p) p.catch(() => {});
        });
        v.addEventListener('mouseleave', () => {
          v.pause();
          v.currentTime = 0;
        });
      });
    })();
  </script>

</Layout>
